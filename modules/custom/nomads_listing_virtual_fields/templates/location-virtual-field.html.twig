{#
/**
 * @file
 * Location virtual field output.
 */
#}
{% set classes = wrapper_classes|default([]) %}
<div{% if wrapper_id %} id="{{ wrapper_id }}"{% endif %} class="{{ classes|join(' ') }}">
  {% if label and label_display != 'hidden' %}
    <div class="field__label">{{ label }}</div>
  {% endif %}
  {{ content }}
</div>
