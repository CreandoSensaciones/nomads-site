/**
 * Implements hook_entity_view().
 */
function nomads_listing_virtual_fields_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($entity->getEntityTypeId() === 'paragraph' && $entity->bundle() === 'hosting') {
    nomads_listing_virtual_fields_build_hosting_period($build, $entity, $view_mode);
    nomads_listing_virtual_fields_build_price_range($build, $entity, $view_mode);
    return;
  }

  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'listing') {
    nomads_listing_virtual_fields_build_location($build, $entity, $view_mode);
    nomads_listing_virtual_fields_build_combined_map($build, $entity, $view_mode);
    nomads_listing_virtual_fields_build_date_location_block($build, $entity, $view_mode);
    nomads_listing_virtual_fields_build_listing_menu($build, $entity, $view_mode);
  }
}

/**
 * Renders the hosting period virtual field.
 */
function nomads_listing_virtual_fields_build_hosting_period(array &$build, EntityInterface $entity, string $view_mode): void {
  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('paragraph', 'hosting', $view_mode);
  $component = $view_display->getComponent('nomads_hosting_period_virtual_field');
  if (empty($component) || ($component['region'] ?? 'hidden') === 'hidden') {
    return;
  }

  /** @var \Drupal\nomads_listing_virtual_fields\HostingPeriodExtraFieldBuilder $builder */
  $builder = \Drupal::service('nomads_listing_virtual_fields.hosting_period_builder');
  $render_array = $builder->build($entity, $view_display, $entity->language()->getId());
  if (empty($render_array)) {
    return;
  }

  $render_array['#weight'] = $component['weight'] ?? 0;
  $render_array['#region'] = $component['region'] ?? 'content';
  $build['nomads_hosting_period_virtual_field'] = $render_array;
}

/**
 * Renders the price range virtual field.
 */
function nomads_listing_virtual_fields_build_price_range(array &$build, EntityInterface $entity, string $view_mode): void {
  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('paragraph', 'hosting', $view_mode);
  $component = $view_display->getComponent('nomads_prices_virtual_fields_price_range');
  if (empty($component) || ($component['region'] ?? 'hidden') === 'hidden') {
    return;
  }

  /** @var \Drupal\nomads_listing_virtual_fields\PriceVirtualFieldBuilder $builder */
  $builder = \Drupal::service('nomads_listing_virtual_fields.price_builder');
  $render_array = $builder->buildPriceRange($entity, $entity->language()->getId());
  if (empty($render_array)) {
    return;
  }

  $render_array['#weight'] = $component['weight'] ?? 0;
  $render_array['#region'] = $component['region'] ?? 'content';
  $build['nomads_prices_virtual_fields_price_range'] = $render_array;
}

