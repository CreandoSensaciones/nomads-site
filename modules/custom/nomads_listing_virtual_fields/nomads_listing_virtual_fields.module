/**
 * Implements hook_views_query_alter().
 */
function nomads_listing_virtual_fields_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  $supported_display = (
    ($view->id() === 'map_virtual_field' && $view->current_display === 'combined_map') ||
    ($view->id() === 'location_periods' && $view->current_display === 'date_location_table')
  );
  if (!$supported_display) {
    return;
  }

  $paragraph_ids = $view->element['#nomads_listing_virtual_fields_paragraph_ids'] ?? NULL;
  if (!is_array($paragraph_ids) || $paragraph_ids === [] || !method_exists($query, 'addWhere')) {
    return;
  }

  $query->addWhere(0, 'paragraphs_item_field_data.id', $paragraph_ids, 'IN');
}

/**
 * Implements hook_form_alter().
 */
function nomads_listing_virtual_fields_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!in_array($form_id, ['entity_view_display_edit_form', 'entity_view_display_form'], TRUE)) {
    return;
  }

  nomads_listing_virtual_fields_add_location_display_settings($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for entity_view_display_edit_form.
 */
function nomads_listing_virtual_fields_form_entity_view_display_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  nomads_listing_virtual_fields_add_location_display_settings($form, $form_state);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for entity_view_display_form.
 */
function nomads_listing_virtual_fields_form_entity_view_display_form_alter(array &$form, FormStateInterface $form_state): void {
  nomads_listing_virtual_fields_add_location_display_settings($form, $form_state);
}

/**
 * Adds location virtual field display settings to Manage Display form.
 */
function nomads_listing_virtual_fields_add_location_display_settings(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return;
  }

  $display = $form_object->getEntity();
  if (!$display instanceof EntityViewDisplayInterface) {
    return;
  }

  if ($display->getTargetEntityTypeId() !== 'node' || $display->getTargetBundle() !== 'listing') {
    return;
  }

  if (isset($form['location_virtual_field_settings'])) {
    return;
  }

  $default_link_terms = (bool) $display->getThirdPartySetting('nomads_listing_virtual_fields', 'link_terms', TRUE);
  $default_max_bundles = max(1, (int) $display->getThirdPartySetting('nomads_listing_virtual_fields', 'max_bundles', 6));
  $default_output_mode = (string) $display->getThirdPartySetting('nomads_listing_virtual_fields', 'output_mode', 'detailed');
  if (!in_array($default_output_mode, ['detailed', 'combined', 'switch'], TRUE)) {
    $default_output_mode = 'detailed';
  }

  $form['location_virtual_field_settings'] = [
    '#type' => 'details',
    '#title' => t('Location virtual field'),
    '#open' => FALSE,
    '#weight' => 100,
    '#tree' => TRUE,
  ];
  $form['location_virtual_field_settings']['link_terms'] = [
    '#type' => 'checkbox',
    '#title' => t('Link terms'),
    '#description' => t('Link region, country and place terms to their term pages.'),
    '#default_value' => $default_link_terms,
  ];
  $form['location_virtual_field_settings']['output_mode'] = [
    '#type' => 'radios',
    '#title' => t('Output mode'),
    '#options' => [
      'detailed' => t('Detailed'),
      'combined' => t('Combined'),
      'switch' => t('Switch'),
    ],
    '#description' => t('Detailed keeps the current location output. Combined renders country/date summaries and collapses multiple dated locations to their shared geo region and full month span. Switch uses Detailed up to the maximal number of bundles, then Combined above that threshold.'),
    '#default_value' => $default_output_mode,
    '#required' => TRUE,
  ];
  $form['location_virtual_field_settings']['max_bundles'] = [
    '#type' => 'number',
    '#title' => t('Maximal number of bundles'),
    '#description' => t('Maximum number of bundles rendered for the multi-bundles variant.'),
    '#default_value' => $default_max_bundles,
    '#min' => 1,
    '#step' => 1,
    '#required' => TRUE,
  ];

  if (!isset($form['#entity_builders']) || !is_array($form['#entity_builders'])) {
    $form['#entity_builders'] = [];
  }
  if (!in_array('nomads_listing_virtual_fields_entity_view_display_builder', $form['#entity_builders'], TRUE)) {
    $form['#entity_builders'][] = 'nomads_listing_virtual_fields_entity_view_display_builder';
  }
}

/**
 * Entity builder for location virtual field display settings.
 */
function nomads_listing_virtual_fields_entity_view_display_builder(string $entity_type_id, EntityInterface $entity, array &$form, FormStateInterface $form_state): void {
  if (!$entity instanceof EntityViewDisplayInterface) {
    return;
  }

  if ($entity->getTargetEntityTypeId() !== 'node' || $entity->getTargetBundle() !== 'listing') {
    return;
  }

  $settings = (array) $form_state->getValue('location_virtual_field_settings', []);
  $link_terms = !empty($settings['link_terms']);
  $max_bundles = max(1, (int) ($settings['max_bundles'] ?? 6));
  $output_mode = (string) ($settings['output_mode'] ?? 'detailed');
  if (!in_array($output_mode, ['detailed', 'combined', 'switch'], TRUE)) {
    $output_mode = 'detailed';
  }

  $entity->setThirdPartySetting('nomads_listing_virtual_fields', 'link_terms', $link_terms);
  $entity->setThirdPartySetting('nomads_listing_virtual_fields', 'output_mode', $output_mode);
  $entity->setThirdPartySetting('nomads_listing_virtual_fields', 'max_bundles', $max_bundles);
}
