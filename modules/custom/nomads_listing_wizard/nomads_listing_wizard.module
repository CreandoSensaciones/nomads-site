<?php

/**
 * @file
 * Nomads Listing Wizard module hooks.
 *
 * Example modal link:
 * <a class="use-ajax" data-dialog-type="modal" data-dialog-options='{"width": 1100}' href="/listing/wizard">Add listing</a>
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function nomads_listing_wizard_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.nomads_listing_wizard':
      $output = '';
      $output .= '<h2>' . t('Nomads Listing Wizard') . '</h2>';
      $output .= '<p>' . t('Nomads Listing Wizard provides the <code>/listing/wizard</code> onboarding entry point for creating listing nodes in a multi-step, modal-friendly form. It adapts the normal node form to an <code>onboarding</code> operation, keeps intermediate steps inside an AJAX wrapper, and redirects only after the final successful submit.') . '</p>';

      $output .= '<h3>' . t('Functionality') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Adds the <code>/listing/wizard</code> route for users with create access to <code>listing</code> nodes.') . '</li>';
      $output .= '<li>' . t('Registers a node form operation named <code>onboarding</code> that uses Drupal core’s node form class.') . '</li>';
      $output .= '<li>' . t('Creates a new unsaved listing node and renders it through the onboarding operation.') . '</li>';
      $output .= '<li>' . t('Returns either a normal page render or an AJAX modal response when requested with Drupal AJAX wrapper format.') . '</li>';
      $output .= '<li>' . t('Converts submit buttons to AJAX refreshes inside <code>#nomads-listing-wizard-wrapper</code> during wizard steps.') . '</li>';
      $output .= '<li>' . t('Disables redirects on intermediate steps and closes the modal with a redirect to the listing page after the final valid submit.') . '</li>';
      $output .= '<li>' . t('Tracks selected taxonomy terms in Drupal settings so client-side widgets can react to prior selections.') . '</li>';
      $output .= '<li>' . t('Provides JavaScript that hides or disables the Next button until visible required step inputs are complete.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Architecture') . '</h3>';
      $output .= '<p>' . t('The route is handled by <code>ListingWizardController</code>, which builds a new <code>listing</code> node form for the <code>onboarding</code> operation and optionally wraps it in an AJAX modal. The module file uses entity type, field-definition, form, and Entity Form Steps hooks to normalize entity reference handlers, attach AJAX callbacks, detect wizard step state, and render step titles inside the modal. A service override replaces <code>plugin.manager.entity_reference_selection</code> with <code>SafeSelectionPluginManager</code>, which falls back safely when entity reference selection handler groups are malformed or unavailable.') . '</p>';

      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('There is no settings form. Configure the wizard by maintaining Entity Form Steps and form display configuration for the <code>listing</code> node bundle and the <code>onboarding</code> operation. The front-end Next-button gate contains step-specific assumptions for groups such as <code>group-title</code>, <code>group-category</code>, <code>group-location-date</code>, and <code>group-official</code>, plus integration expectations for Nomads Easy Tagging widgets. Links that open the wizard as a modal should use Drupal AJAX modal attributes and point to <code>/listing/wizard</code>.') . '</p>';

      $output .= '<h3>' . t('Stability concerns') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Wizard step detection depends on Entity Form Steps form-state structures, hidden values, button names, and fallback heuristics; changes in that module can break navigation or final-step detection.') . '</li>';
      $output .= '<li>' . t('The <code>onboarding</code> form operation is registered globally on the node entity type, so another module using the same operation name could conflict.') . '</li>';
      $output .= '<li>' . t('The service override for <code>plugin.manager.entity_reference_selection</code> is global and can affect entity reference behavior outside the wizard.') . '</li>';
      $output .= '<li>' . t('The Next-button gate is tightly coupled to field names, group IDs, Easy Tagging markup, visible-field heuristics, and Drupal modal button markup.') . '</li>';
      $output .= '<li>' . t('Taxonomy reference handler normalization mutates field definitions defensively, which helps avoid fatal errors but can mask invalid field configuration that should be fixed at the source.') . '</li>';
      $output .= '<li>' . t('There is no automated test coverage for route access, modal rendering, step transitions, final redirects, entity reference fallback behavior, or client-side Next-button gating.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Security concerns') . '</h3>';
      $output .= '<p>' . t('The wizard route requires normal create access for <code>listing</code> nodes and the submitted form remains Drupal’s node form, so server-side entity validation, field validation, and node access still apply. The JavaScript Next-button gate is only a usability control and must not be treated as security or validation. Because the wizard creates content through a public route for authorized users, field access, moderation, spam protections, and file/media upload permissions should be configured with the same care as the standard listing node add form.') . '</p>';

      return $output;
  }

  return NULL;
}

/**
 * Implements hook_entity_type_alter().
 */
function nomads_listing_wizard_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['node'])) {
    // Reuse the default node form class for the onboarding operation.
    $entity_types['node']->setFormClass('onboarding', \Drupal\node\NodeForm::class);
  }
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
function nomads_listing_wizard_entity_bundle_field_info_alter(array &$fields, \Drupal\Core\Entity\EntityTypeInterface $entity_type, string $bundle): void {
  foreach ($fields as $field_definition) {
    nomads_listing_wizard_normalize_entity_reference_definition($field_definition);
  }
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function nomads_listing_wizard_entity_base_field_info_alter(array &$fields, \Drupal\Core\Entity\EntityTypeInterface $entity_type): void {
  foreach ($fields as $field_definition) {
    nomads_listing_wizard_normalize_entity_reference_definition($field_definition);
  }
}

/**
 * Implements hook_entity_field_storage_info_alter().
 */
function nomads_listing_wizard_entity_field_storage_info_alter(array &$fields, \Drupal\Core\Entity\EntityTypeInterface $entity_type): void {
  foreach ($fields as $field_storage_definition) {
    nomads_listing_wizard_normalize_entity_reference_definition($field_storage_definition);
  }
}

/**
 * Implements hook_form_alter().
 */
function nomads_listing_wizard_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\node\NodeForm) {
    return;
  }
  $entity = $form_object->getEntity();
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'listing') {
    return;
  }
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'nomads_listing_wizard.wizard') {
    return;
  }
  nomads_listing_wizard_normalize_taxonomy_reference_handlers($entity);

  $form['#prefix'] = '<div id="nomads-listing-wizard-wrapper">';
  $form['#suffix'] = '</div>';
  $is_last_step = nomads_listing_wizard_is_last_step($form_state, $form);
  $requires_input = nomads_listing_wizard_step_requires_input($form_state, $form);
  $form['#attributes']['data-nomads-wizard-final-step'] = $is_last_step ? '1' : '0';
  $form['#attributes']['data-nomads-wizard-requires-input'] = $requires_input ? '1' : '0';
  $form['#attached']['library'][] = 'core/drupal.ajax';
  $form['#attached']['library'][] = 'core/drupal.dialog.ajax';
  $form['#attached']['library'][] = 'nomads_listing_wizard/next_button_gate';
  $selected_terms = nomads_listing_wizard_collect_selected_taxonomy_terms($form_state);
  $form_state->set('nomads_selected_terms', $selected_terms);
  $form['#attached']['drupalSettings']['nomadsWizard']['selected'] = $selected_terms;

  if (!isset($form['actions']) || !is_array($form['actions'])) {
    return;
  }

  $primary_button_key = NULL;
  $submit_keys = [];
  foreach (\Drupal\Core\Render\Element::children($form['actions']) as $key) {
    if (($form['actions'][$key]['#type'] ?? '') !== 'submit') {
      continue;
    }
    $submit_keys[] = $key;
    $form['actions'][$key]['#ajax'] = [
      'callback' => 'nomads_listing_wizard_ajax_refresh',
      'wrapper' => 'nomads-listing-wizard-wrapper',
      'event' => 'click',
    ];
    $form['actions'][$key]['#submit'] = $form['actions'][$key]['#submit'] ?? [];
    array_unshift($form['actions'][$key]['#submit'], 'nomads_listing_wizard_intermediate_step_submit');
    if (($form['actions'][$key]['#button_type'] ?? '') === 'primary') {
      $primary_button_key = $key;
    }
  }

  if (!$is_last_step) {
    foreach ($submit_keys as $key) {
      $label = (string) ($form['actions'][$key]['#value'] ?? '');
      if ($label !== '' && strcasecmp($label, 'Save') === 0) {
        $form['actions'][$key]['#value'] = t('Next');
      }
    }
  }

  if (!$is_last_step) {
    $next_keys = $primary_button_key !== NULL ? [$primary_button_key] : $submit_keys;
    foreach ($next_keys as $key) {
      if (!isset($form['actions'][$key]) || !is_array($form['actions'][$key])) {
        continue;
      }
      $name = (string) ($form['actions'][$key]['#name'] ?? '');
      if ($name === 'entity_form_steps_previous' || str_contains($name, 'add_more')) {
        continue;
      }
      $form['actions'][$key]['#attributes']['data-nomads-next-button'] = '1';
    }
  }
}

/**
 * Implements hook_entity_form_steps_complete_form_alter().
 */
function nomads_listing_wizard_entity_form_steps_complete_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, \Drupal\Core\Entity\FieldableEntityInterface $entity, array $state): void {
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'listing') {
    return;
  }
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\node\NodeForm) {
    return;
  }
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'nomads_listing_wizard.wizard') {
    return;
  }

  $is_last_step = nomads_listing_wizard_is_last_step($form_state, $form);
  $requires_input = nomads_listing_wizard_step_requires_input($form_state, $form, $state);
  $form['#attributes']['data-nomads-wizard-final-step'] = $is_last_step ? '1' : '0';
  $form['#attributes']['data-nomads-wizard-requires-input'] = $requires_input ? '1' : '0';

  if (isset($form['actions']) && is_array($form['actions'])) {
    foreach (\Drupal\Core\Render\Element::children($form['actions']) as $key) {
      if (($form['actions'][$key]['#type'] ?? '') !== 'submit') {
        continue;
      }
      $form['actions'][$key]['#ajax'] = [
        'callback' => 'nomads_listing_wizard_ajax_refresh',
        'wrapper' => 'nomads-listing-wizard-wrapper',
        'event' => 'click',
      ];
    }
  }

  if (!$is_last_step && isset($state['complete']) && $state['complete'] === FALSE && isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Next');
    $form['actions']['submit']['#attributes']['data-nomads-next-button'] = '1';
  }

  // Entity Form Steps writes step-specific titles to $form['#title'], but this
  // wizard renders in a modal with a fixed dialog title. Render the step title
  // in-form so "Create title"/"Edit title" settings are visible per step.
  if (!empty($form['#title'])) {
    $title = (string) $form['#title'];
    if ($title !== '') {
      $title = str_replace('//', '<br>', $title);
      $form['nomads_step_title'] = [
        '#markup' => \Drupal\Core\Render\Markup::create('<h2 class="nomads-listing-step-title">' . $title . '</h2>'),
        '#weight' => -1000,
      ];
    }
  }
}

/**
 * Implements hook_entity_node_form_listing_steps_alter().
 */
function nomads_listing_wizard_entity_node_form_listing_steps_alter(array &$steps, \Drupal\Core\Form\FormStateInterface $form_state, \Drupal\Core\Entity\FieldableEntityInterface $entity): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\node\NodeForm) {
    return;
  }
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'nomads_listing_wizard.wizard') {
    return;
  }

  $defaults = [
    'add_label' => '',
    'edit_label' => '',
    'previous_button' => '',
    'next_button' => '',
    'submit_button' => '',
    'preview_button' => '',
    'cancel_button' => '',
    'delete_button' => '',
    'delete_path' => '',
  ];

  foreach ($steps as &$step) {
    $step['format_settings'] = $step['format_settings'] ?? [];
    foreach ($defaults as $key => $value) {
      if (!array_key_exists($key, $step['format_settings'])) {
        $step['format_settings'][$key] = $value;
      }
    }
  }
}

/**
 * Ajax callback to refresh the wizard wrapper.
 */
function nomads_listing_wizard_ajax_refresh(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): \Drupal\Core\Ajax\AjaxResponse|array {
  $trigger = $form_state->getTriggeringElement() ?? [];
  if (($trigger['#type'] ?? '') !== 'submit') {
    return $form;
  }
  $trigger_name = (string) ($trigger['#name'] ?? '');
  if ($trigger_name === 'entity_form_steps_previous' || str_contains($trigger_name, 'add_more')) {
    return $form;
  }
  if (!nomads_listing_wizard_is_last_step($form_state, $form)) {
    return $form;
  }
  if ($form_state->hasAnyErrors()) {
    return $form;
  }

  $url = NULL;
  $redirect = $form_state->getRedirect();
  if ($redirect) {
    $url = \Drupal\Core\Url::fromRoute(
      $redirect[0],
      $redirect[1] ?? [],
      $redirect[2] ?? []
    );
  }
  if (!$url) {
    $form_object = $form_state->getFormObject();
    if ($form_object instanceof \Drupal\node\NodeForm) {
      $entity = $form_object->getEntity();
      if ($entity->id()) {
        $url = $entity->toUrl('canonical');
      }
    }
  }
  if (!$url) {
    return $form;
  }

  $response = new \Drupal\Core\Ajax\AjaxResponse();
  $response->addCommand(new \Drupal\Core\Ajax\CloseModalDialogCommand());
  $response->addCommand(new \Drupal\Core\Ajax\RedirectCommand($url->toString()));
  return $response;
}

/**
 * Prevents redirects between steps in the wizard modal.
 */
function nomads_listing_wizard_intermediate_step_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (!nomads_listing_wizard_is_last_step($form_state, $form)) {
    $form_state->disableRedirect();
    $form_state->setRebuild(TRUE);
  }
}

/**
 * Determines whether the current wizard step is the last one.
 */
function nomads_listing_wizard_is_last_step(\Drupal\Core\Form\FormStateInterface $form_state, array $form): bool {
  $efs = $form_state->get('entity_form_steps')
    ?? $form_state->getStorage()['entity_form_steps'] ?? NULL;
  if (isset($form['#entity_form_steps']) && is_array($form['#entity_form_steps'])) {
    $efs = $form['#entity_form_steps'];
  }
  if (is_array($efs)) {
    if (isset($efs['complete']) && is_bool($efs['complete'])) {
      return $efs['complete'];
    }
    if (isset($efs['last']) && is_bool($efs['last'])) {
      return $efs['last'];
    }
    if (isset($efs['current'], $efs['steps']) && is_array($efs['steps'])) {
      $step_keys = array_keys($efs['steps']);
      $current = (string) $efs['current'];
      $last = (string) end($step_keys);
      return $current === $last;
    }
  }

  $current_step = $form_state->get('current_step') ?? $form_state->get('step');
  $last_step = $form_state->get('last_step');
  if ($current_step !== NULL && $last_step !== NULL) {
    return (string) $current_step === (string) $last_step;
  }

  $hidden_current = NULL;
  foreach ($form as $key => $element) {
    if (is_array($element) && str_contains((string) $key, 'current_step')) {
      if (isset($element['#value']) || isset($element['#default_value'])) {
        $hidden_current = (string) ($element['#value'] ?? $element['#default_value']);
        break;
      }
    }
  }
  if ($hidden_current !== NULL) {
    $last = (string) ($form_state->get('last_step') ?? '');
    if ($last !== '') {
      return $hidden_current === $last;
    }
  }

  // Last fallback: infer from triggering button label to avoid fail-open.
  $trigger = $form_state->getTriggeringElement() ?? [];
  $trigger_name = strtolower((string) ($trigger['#name'] ?? ''));
  $trigger_value = strtolower(trim((string) ($trigger['#value'] ?? '')));
  if ($trigger_name === 'entity_form_steps_previous' || str_contains($trigger_name, 'previous')) {
    return FALSE;
  }
  if ($trigger_value === 'next') {
    return FALSE;
  }

  // Conservative default for unknown state: not last.
  return FALSE;
}

/**
 * Determines whether the current wizard step should require user input.
 */
function nomads_listing_wizard_step_requires_input(\Drupal\Core\Form\FormStateInterface $form_state, array $form, ?array $state = NULL): bool {
  if (nomads_listing_wizard_is_last_step($form_state, $form)) {
    return FALSE;
  }

  $index = nomads_listing_wizard_get_current_step_index($form_state, $form, $state);
  if ($index === NULL) {
    return FALSE;
  }

  return $index >= 0 && $index < 3;
}

/**
 * Gets the zero-based wizard step index when Entity Form Steps exposes it.
 */
function nomads_listing_wizard_get_current_step_index(\Drupal\Core\Form\FormStateInterface $form_state, array $form, ?array $state = NULL): ?int {
  $efs = $form_state->get('entity_form_steps')
    ?? $form_state->getStorage()['entity_form_steps'] ?? NULL;
  if (is_array($state)) {
    $efs = $state + (is_array($efs) ? $efs : []);
  }
  if (isset($form['#entity_form_steps']) && is_array($form['#entity_form_steps'])) {
    $efs = $form['#entity_form_steps'];
  }

  if (is_array($efs) && isset($efs['current'], $efs['steps']) && is_array($efs['steps'])) {
    $current = (string) $efs['current'];
    $step_keys = array_values(array_map('strval', array_keys($efs['steps'])));
    $index = array_search($current, $step_keys, TRUE);
    return $index === FALSE ? NULL : (int) $index;
  }

  $current_step = $form_state->get('current_step') ?? $form_state->get('step');
  if ($current_step !== NULL && is_numeric($current_step)) {
    $index = (int) $current_step;
    return $index > 0 ? $index - 1 : $index;
  }

  $hidden_current = NULL;
  foreach ($form as $key => $element) {
    if (is_array($element) && str_contains((string) $key, 'current_step')) {
      if (isset($element['#value']) || isset($element['#default_value'])) {
        $hidden_current = (string) ($element['#value'] ?? $element['#default_value']);
        break;
      }
    }
  }

  if ($hidden_current === NULL || $hidden_current === '') {
    return NULL;
  }

  if (is_array($efs) && isset($efs['steps']) && is_array($efs['steps'])) {
    $step_keys = array_values(array_map('strval', array_keys($efs['steps'])));
    $index = array_search($hidden_current, $step_keys, TRUE);
    return $index === FALSE ? NULL : (int) $index;
  }

  if (is_numeric($hidden_current)) {
    $index = (int) $hidden_current;
    return $index > 0 ? $index - 1 : $index;
  }

  return NULL;
}

/**
 * Collect selected taxonomy term IDs from current and persisted form values.
 */
function nomads_listing_wizard_collect_selected_taxonomy_terms(\Drupal\Core\Form\FormStateInterface $form_state): array {
  $values = $form_state->getValues();
  if (!is_array($values)) {
    return (array) $form_state->get('nomads_selected_terms');
  }

  $taxonomy_fields = nomads_listing_wizard_get_taxonomy_reference_field_names($form_state);
  if (!$taxonomy_fields) {
    return (array) $form_state->get('nomads_selected_terms');
  }

  $tids = [];
  $saw_taxonomy_field = FALSE;
  nomads_listing_wizard_collect_term_ids_recursive($values, $taxonomy_fields, $tids, $saw_taxonomy_field, FALSE);

  if (!$saw_taxonomy_field) {
    return (array) $form_state->get('nomads_selected_terms');
  }

  sort($tids, SORT_NUMERIC);
  return array_values(array_unique($tids));
}

/**
 * Return taxonomy term reference field names from the listing entity.
 */
function nomads_listing_wizard_get_taxonomy_reference_field_names(\Drupal\Core\Form\FormStateInterface $form_state): array {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\node\NodeForm) {
    return [];
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof \Drupal\Core\Entity\FieldableEntityInterface) {
    return [];
  }

  $field_names = [];
  foreach ($entity->getFieldDefinitions() as $field_name => $definition) {
    if ($definition->getType() !== 'entity_reference') {
      continue;
    }
    if ($definition->getSetting('target_type') !== 'taxonomy_term') {
      continue;
    }
    $field_names[] = (string) $field_name;
  }

  return $field_names;
}

/**
 * Recursively collect selected term IDs inside taxonomy reference values.
 */
function nomads_listing_wizard_collect_term_ids_recursive(mixed $value, array $taxonomy_fields, array &$tids, bool &$saw_taxonomy_field, bool $inside_taxonomy_field): void {
  if (is_array($value)) {
    if ($inside_taxonomy_field && isset($value['target_id']) && is_numeric($value['target_id'])) {
      $tid = (int) $value['target_id'];
      if ($tid > 0) {
        $tids[] = $tid;
      }
    }
    if ($inside_taxonomy_field && isset($value['_net_values']) && is_string($value['_net_values'])) {
      foreach (explode("\n", $value['_net_values']) as $item) {
        $item = trim($item);
        if ($item !== '' && is_numeric($item) && (int) $item > 0) {
          $tids[] = (int) $item;
        }
      }
    }

    foreach ($value as $key => $child) {
      $key_is_taxonomy = is_string($key) && in_array($key, $taxonomy_fields, TRUE);
      if ($key_is_taxonomy) {
        $saw_taxonomy_field = TRUE;
      }
      nomads_listing_wizard_collect_term_ids_recursive($child, $taxonomy_fields, $tids, $saw_taxonomy_field, $inside_taxonomy_field || $key_is_taxonomy);
    }
    return;
  }

  if ($inside_taxonomy_field && is_numeric($value)) {
    $tid = (int) $value;
    if ($tid > 0) {
      $tids[] = $tid;
    }
  }
}

/**
 * Ensure taxonomy reference fields always have a valid selection handler.
 */
function nomads_listing_wizard_normalize_taxonomy_reference_handlers(\Drupal\Core\Entity\FieldableEntityInterface $entity): void {
  foreach ($entity->getFieldDefinitions() as $definition) {
    nomads_listing_wizard_normalize_entity_reference_definition($definition);
  }
}

/**
 * Ensure entity reference settings include a concrete selection handler.
 */
function nomads_listing_wizard_normalize_entity_reference_definition(mixed $definition): void {
  if (!is_object($definition) || !method_exists($definition, 'getType') || !method_exists($definition, 'getSetting')) {
    return;
  }
  if ($definition->getType() !== 'entity_reference') {
    return;
  }

  $target_type = (string) ($definition->getSetting('target_type') ?? '');
  if ($target_type === '' && method_exists($definition, 'getFieldStorageDefinition')) {
    $target_type = (string) ($definition->getFieldStorageDefinition()->getSetting('target_type') ?? '');
  }
  if ($target_type === '' || !method_exists($definition, 'setSetting')) {
    return;
  }

  if (($definition->getSetting('target_type') ?? '') === '') {
    $definition->setSetting('target_type', $target_type);
  }

  $handler = $definition->getSetting('handler');
  if (!is_string($handler) || $handler === '' || $handler === 'default') {
    $definition->setSetting('handler', 'default:' . $target_type);
  }
}
