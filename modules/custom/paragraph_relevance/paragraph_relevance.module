<?php

/**
 * @file
 * Paragraph Relevance module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Url;
use Drupal\Component\Utility\NestedArray;
use Drupal\Component\Serialization\Json;
use Drupal\field\FieldConfigInterface;
use Symfony\Component\Routing\Exception\RouteNotFoundException;

/**
 * Implements hook_form_alter().
 */
function paragraph_relevance_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  paragraph_relevance_inject_group_attrs($form);
  paragraph_relevance_attach_relevance_ui_wrappers($form);
  paragraph_relevance_attach_sync_library($form, $form_state);
  paragraph_relevance_apply_static_form_mode_visibility($form, $form_state, $form_id);

  if (paragraph_relevance_is_listing_form($form_state, $form_id)) {
    $form['#attached']['library'][] = 'paragraph_relevance/relevance';
    $form['#after_build'][] = 'paragraph_relevance_after_build';

    if (!isset($form['#attributes']) || !is_array($form['#attributes'])) {
      $form['#attributes'] = [];
    }
    $form['#attributes']['data-paragraph-relevance-form'] = '1';
    $form['#attributes']['novalidate'] = 'novalidate';

    // Keep form-level submit too.
    $form['#submit'][] = 'paragraph_relevance_listing_submit_prune_empty';
    $form['#submit'][] = 'paragraph_relevance_listing_submit';

    // IMPORTANT: also attach to the clicked action button(s).
    paragraph_relevance_attach_submit_to_action_buttons($form, 'paragraph_relevance_listing_submit_prune_empty');
    paragraph_relevance_attach_submit_to_action_buttons($form, 'paragraph_relevance_listing_submit');
  }

  paragraph_relevance_open_default_form_alter($form, $form_state, $form_id);
}


/**
 * Attach a submit callback to all submit buttons in the form actions.
 */
function paragraph_relevance_attach_submit_to_action_buttons(array &$form, string $callback): void {
  if (empty($form['actions']) || !is_array($form['actions'])) {
    return;
  }

  foreach ($form['actions'] as $key => &$action) {
    if (!is_array($action)) {
      continue;
    }
    if (($action['#type'] ?? '') !== 'submit') {
      continue;
    }
    if (!isset($action['#submit']) || !is_array($action['#submit'])) {
      $action['#submit'] = [];
    }
    if (!in_array($callback, $action['#submit'], TRUE)) {
      $action['#submit'][] = $callback;
    }
  }
}

/**
 * Validation handler for listing forms.
 *
 * Kept as a no-op to avoid save-time paragraph data loss.
 */
function paragraph_relevance_listing_validate(array &$form, FormStateInterface $form_state): void {
  return;
}

/**
 * Submit handler for listing forms: remove paragraph reference items that are
 * truly empty AND have relevance empty/zero, based on submitted form values.
 *
 * This avoids data loss that can happen when pruning on node presave, because
 * paragraph entities may still look empty at that stage (AJAX widgets / autosave).
 */
function paragraph_relevance_listing_submit_prune_empty(array &$form, FormStateInterface $form_state): void {
  // Disabled intentionally: submit-time pruning can remove valid paragraph
  // submissions for some bundles (for example hosting) when widget value
  // shapes vary across AJAX rebuilds. Preserve all submitted items.
  return;
}

/**
 * Conservative check for meaningful content inside a paragraph subform array.
 *
 * Returns TRUE if any non-relevance field contains a non-empty value.
 */
function paragraph_relevance_subform_has_meaningful_content(array $subform): bool {
  foreach ($subform as $field_name => $value) {
    if ($field_name === 'field_relevance' || $field_name === 'field_relevance2') {
      continue;
    }
    // Ignore Paragraphs housekeeping keys.
    if (in_array($field_name, ['status', 'created', 'changed', 'revision_log_message', 'revision_uid', 'revision_timestamp'], TRUE)) {
      continue;
    }

    if (paragraph_relevance_subform_value_is_nonempty($value)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Determine if a subform value contains any meaningful non-empty scalar.
 */
function paragraph_relevance_subform_value_is_nonempty($value): bool {
  if ($value === NULL) {
    return FALSE;
  }
  if (is_string($value)) {
    return trim($value) !== '';
  }
  if (is_int($value) || is_float($value)) {
    return TRUE;
  }
  if (is_bool($value)) {
    return $value;
  }
  if (!is_array($value)) {
    return FALSE;
  }

  // Handle typical field widget structures, e.g. [['value' => 'x']] or [['target_id' => 123]].
  foreach ($value as $k => $v) {
    if (is_array($v)) {
      // Common keys that represent user-entered data.
      foreach (['value', 'target_id', 'uri', 'title', 'format', 'amount', 'number', 'date', 'end_value'] as $key) {
        if (array_key_exists($key, $v) && paragraph_relevance_subform_value_is_nonempty($v[$key])) {
          return TRUE;
        }
      }
      // Recurse.
      if (paragraph_relevance_subform_value_is_nonempty($v)) {
        return TRUE;
      }
    }
    else {
      if (paragraph_relevance_subform_value_is_nonempty($v)) {
        return TRUE;
      }
    }
  }

  return FALSE;
}

/**
 * Attaches relevance engine behavior on forms (including AJAX rebuilds).
 */
function paragraph_relevance_attach_sync_library(array &$form, FormStateInterface $form_state): void {
  if (!isset($form['#attached']) || !is_array($form['#attached'])) {
    $form['#attached'] = [];
  }
  if (!isset($form['#attached']['library']) || !is_array($form['#attached']['library'])) {
    $form['#attached']['library'] = [];
  }
  if (!in_array('paragraph_relevance/relevance_engine', $form['#attached']['library'], TRUE)) {
    $form['#attached']['library'][] = 'paragraph_relevance/relevance_engine';
  }
}

/**
 * Injects relevance wrapper attrs on Field Group HTML elements by selector.
 */
function paragraph_relevance_inject_group_attrs(array &$element): void {
  if (
    isset($element['#attributes']) &&
    is_array($element['#attributes']) &&
    !empty($element['#attributes']['data-drupal-selector'])
  ) {
    $selector = (string) $element['#attributes']['data-drupal-selector'];
    if (preg_match('/^edit-field-([a-z0-9_]+)-widget-\d+-subform-group-relevance$/', $selector, $matches)) {
      $element['#attributes']['data-paragraph-relevance-group'] = $matches[1];

      if (!isset($element['#attributes']['class'])) {
        $element['#attributes']['class'] = [];
      }
      elseif (is_string($element['#attributes']['class'])) {
        $element['#attributes']['class'] = preg_split('/\s+/', trim($element['#attributes']['class'])) ?: [];
      }
      elseif (!is_array($element['#attributes']['class'])) {
        $element['#attributes']['class'] = [];
      }

      if (!in_array('relevance-ui', $element['#attributes']['class'], TRUE)) {
        $element['#attributes']['class'][] = 'relevance-ui';
      }
    }
  }

  foreach ($element as $key => &$child) {
    if (!is_string($key) || $key === '' || $key[0] === '#') {
      continue;
    }
    if (!is_array($child)) {
      continue;
    }
    paragraph_relevance_inject_group_attrs($child);
  }
}

/**
 * Adds a stable relevance UI wrapper to paragraph subforms.
 */
function paragraph_relevance_attach_relevance_ui_wrappers(array &$element): void {
  paragraph_relevance_apply_relevance_ui_wrapper($element);

  foreach ($element as $key => &$child) {
    if (!is_string($key) || $key === '' || $key[0] === '#') {
      continue;
    }
    if (!is_array($child)) {
      continue;
    }
    paragraph_relevance_attach_relevance_ui_wrappers($child);
  }
}

/**
 * Applies the relevance UI wrapper to one paragraph subform element.
 */
function paragraph_relevance_apply_relevance_ui_wrapper(array &$element): void {
  if (
    !isset($element['field_relevance'], $element['field_relevance2']) ||
    !is_array($element['field_relevance']) ||
    !is_array($element['field_relevance2'])
  ) {
    return;
  }

  $bundle = paragraph_relevance_detect_paragraph_bundle($element);
  if ($bundle === NULL || $bundle === '') {
    return;
  }

  paragraph_relevance_mark_relevance_ui_field($element['field_relevance'], 'desired');
  paragraph_relevance_mark_relevance_ui_field($element['field_relevance2'], 'effective');

  if (paragraph_relevance_apply_relevance_ui_to_existing_group($element, $bundle)) {
    return;
  }

  $wrapper_key = 'paragraph_relevance_ui_wrapper';
  if (!isset($element[$wrapper_key]) || !is_array($element[$wrapper_key])) {
    $weight = min(
      (float) ($element['field_relevance']['#weight'] ?? 0),
      (float) ($element['field_relevance2']['#weight'] ?? 0),
    );
    $element[$wrapper_key] = [
      '#type' => 'container',
      '#weight' => $weight - 0.001,
    ];
  }

  paragraph_relevance_set_relevance_ui_wrapper_attributes($element[$wrapper_key], $bundle);

  if (!isset($element[$wrapper_key]['field_relevance']) && isset($element['field_relevance'])) {
    $element[$wrapper_key]['field_relevance'] = $element['field_relevance'];
    unset($element['field_relevance']);
  }
  if (!isset($element[$wrapper_key]['field_relevance2']) && isset($element['field_relevance2'])) {
    $element[$wrapper_key]['field_relevance2'] = $element['field_relevance2'];
    unset($element['field_relevance2']);
  }
}

/**
 * Detects the paragraph bundle machine name from a paragraph subform element.
 */
function paragraph_relevance_detect_paragraph_bundle(array $element): ?string {
  foreach (['#paragraph', '#entity', '#object'] as $property) {
    if (!isset($element[$property]) || !is_object($element[$property])) {
      continue;
    }
    $entity = $element[$property];
    if ($entity instanceof EntityInterface && $entity->getEntityTypeId() === 'paragraph') {
      return $entity->bundle();
    }
    if (method_exists($entity, 'getEntityTypeId') && $entity->getEntityTypeId() === 'paragraph' && method_exists($entity, 'bundle')) {
      return (string) $entity->bundle();
    }
  }

  $entity_type = (string) ($element['#entity_type'] ?? $element['#entity_type_id'] ?? '');
  if ($entity_type === 'paragraph') {
    foreach (['#paragraph_type', '#bundle', '#bundle_name'] as $property) {
      if (!empty($element[$property]) && is_string($element[$property])) {
        return $element[$property];
      }
    }
  }

  if (!empty($element['#paragraph_type']) && is_string($element['#paragraph_type'])) {
    return $element['#paragraph_type'];
  }

  foreach (['#array_parents', '#parents'] as $property) {
    if (empty($element[$property]) || !is_array($element[$property])) {
      continue;
    }
    $bundle = paragraph_relevance_detect_paragraph_bundle_from_parents($element[$property]);
    if ($bundle !== NULL && $bundle !== '') {
      return $bundle;
    }
  }

  return NULL;
}

/**
 * Infers a paragraph bundle from nested form parent keys.
 */
function paragraph_relevance_detect_paragraph_bundle_from_parents(array $parents): ?string {
  $count = count($parents);
  for ($i = 0; $i < $count; $i++) {
    if (!is_string($parents[$i])) {
      continue;
    }
    if (!preg_match('/^field_([a-z0-9_]+)$/', $parents[$i], $matches)) {
      continue;
    }

    // Paragraph subforms are typically nested under field_x > delta > subform.
    for ($j = $i + 1; $j < min($i + 5, $count); $j++) {
      if ((string) $parents[$j] === 'subform') {
        return $matches[1];
      }
    }
  }

  return NULL;
}

/**
 * Applies wrapper attributes to an existing Field Group wrapper if present.
 */
function paragraph_relevance_apply_relevance_ui_to_existing_group(array &$element, string $bundle): bool {
  if (empty($element['#fieldgroups']) || !is_array($element['#fieldgroups'])) {
    return FALSE;
  }

  foreach ($element['#fieldgroups'] as $group_name => $group_definition) {
    $children = paragraph_relevance_get_field_group_children($group_definition);
    if (
      !in_array('field_relevance', $children, TRUE) ||
      !in_array('field_relevance2', $children, TRUE)
    ) {
      continue;
    }
    if (!isset($element[$group_name]) || !is_array($element[$group_name])) {
      continue;
    }

    paragraph_relevance_set_relevance_ui_wrapper_attributes($element[$group_name], $bundle);
    return TRUE;
  }

  return FALSE;
}

/**
 * Extracts child element names from a Field Group definition.
 */
function paragraph_relevance_get_field_group_children($group_definition): array {
  $children = [];

  if (is_object($group_definition) && isset($group_definition->children) && is_array($group_definition->children)) {
    $children = $group_definition->children;
  }
  elseif (is_array($group_definition) && isset($group_definition['children']) && is_array($group_definition['children'])) {
    $children = $group_definition['children'];
  }

  return array_values(array_filter($children, 'is_string'));
}

/**
 * Adds wrapper-level classes and data attributes used by CSS and JS.
 */
function paragraph_relevance_set_relevance_ui_wrapper_attributes(array &$wrapper, string $bundle): void {
  if (!isset($wrapper['#attributes']) || !is_array($wrapper['#attributes'])) {
    $wrapper['#attributes'] = [];
  }
  if (!isset($wrapper['#attributes']['class']) || !is_array($wrapper['#attributes']['class'])) {
    $wrapper['#attributes']['class'] = [];
  }

  if (!in_array('relevance-ui', $wrapper['#attributes']['class'], TRUE)) {
    $wrapper['#attributes']['class'][] = 'relevance-ui';
  }

  $wrapper['#attributes']['data-paragraph-relevance-group'] = $bundle;
}

/**
 * Adds stable child-level selectors for desired/effective relevance widgets.
 */
function paragraph_relevance_mark_relevance_ui_field(array &$field, string $role): void {
  if (!isset($field['#attributes']) || !is_array($field['#attributes'])) {
    $field['#attributes'] = [];
  }
  if (!isset($field['#attributes']['class']) || !is_array($field['#attributes']['class'])) {
    $field['#attributes']['class'] = [];
  }

  foreach (['relevance-ui__field', 'relevance-ui__field--' . $role] as $class) {
    if (!in_array($class, $field['#attributes']['class'], TRUE)) {
      $field['#attributes']['class'][] = $class;
    }
  }

  $field['#attributes']['data-paragraph-relevance-role'] = $role;
  if ($role === 'effective') {
    $field['#attributes']['data-paragraph-relevance-readonly-ui'] = '1';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for paragraph type add form.
 */
function paragraph_relevance_form_paragraphs_type_add_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  paragraph_relevance_add_paragraph_type_settings($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for paragraph type base form.
 */
function paragraph_relevance_form_paragraphs_type_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  paragraph_relevance_add_paragraph_type_settings($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for paragraph type edit form.
 */
function paragraph_relevance_form_paragraphs_type_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  paragraph_relevance_add_paragraph_type_settings($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for field config add form.
 */
function paragraph_relevance_form_field_config_add_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  paragraph_relevance_add_field_config_settings($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for field config edit form.
 */
function paragraph_relevance_form_field_config_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  paragraph_relevance_add_field_config_settings($form, $form_state);
}

/**
 * Adds paragraph type settings for CSS classes.
 */
function paragraph_relevance_add_paragraph_type_settings(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  $paragraph_type = $form_object && method_exists($form_object, 'getEntity')
    ? $form_object->getEntity()
    : NULL;
  if (!$paragraph_type) {
    return;
  }

  if (!isset($form['third_party_settings'])) {
    $form['third_party_settings'] = [
      '#type' => 'container',
      '#tree' => TRUE,
    ];
  }
  elseif (!isset($form['third_party_settings']['#tree'])) {
    $form['third_party_settings']['#tree'] = TRUE;
  }

  if (!isset($form['third_party_settings']['paragraph_relevance'])) {
    $form['third_party_settings']['paragraph_relevance'] = [
      '#type' => 'details',
      '#title' => t('Paragraph relevance'),
      '#open' => TRUE,
      '#tree' => TRUE,
    ];
  }

  $form['third_party_settings']['paragraph_relevance']['css_classes'] = [
    '#type' => 'textfield',
    '#title' => t('CSS Classes'),
    '#default_value' => (string) $paragraph_type->getThirdPartySetting('paragraph_relevance', 'css_classes', ''),
    '#description' => t('Space-separated classes added to all rendered paragraphs of this type.'),
    '#parents' => ['third_party_settings', 'paragraph_relevance', 'css_classes'],
  ];

  if (!isset($form['#entity_builders']) || !is_array($form['#entity_builders'])) {
    $form['#entity_builders'] = [];
  }
  if (!in_array('paragraph_relevance_paragraphs_type_entity_builder', $form['#entity_builders'], TRUE)) {
    $form['#entity_builders'][] = 'paragraph_relevance_paragraphs_type_entity_builder';
  }
}

/**
 * Entity builder callback for paragraph type settings.
 */
function paragraph_relevance_paragraphs_type_entity_builder(string $entity_type_id, EntityInterface $paragraph_type, array &$form, FormStateInterface $form_state): void {
  $exists = NULL;
  $input = (array) $form_state->getUserInput();
  $raw = NestedArray::getValue(
    $input,
    ['third_party_settings', 'paragraph_relevance', 'css_classes'],
    $exists,
  );
  if ($exists) {
    $paragraph_type->setThirdPartySetting('paragraph_relevance', 'css_classes', trim((string) $raw));
    return;
  }

  $values = $form_state->getValue(['third_party_settings', 'paragraph_relevance']);
  if (is_array($values) && array_key_exists('css_classes', $values)) {
    $paragraph_type->setThirdPartySetting('paragraph_relevance', 'css_classes', trim((string) $values['css_classes']));
  }
}

/**
 * Adds field config settings for open default paragraph widgets.
 */
function paragraph_relevance_add_field_config_settings(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  $field_config = $form_object && method_exists($form_object, 'getEntity')
    ? $form_object->getEntity()
    : NULL;
  if (!$field_config instanceof FieldConfigInterface) {
    return;
  }

  $storage = $field_config->getFieldStorageDefinition();
  if ($storage->getType() !== 'entity_reference_revisions') {
    return;
  }
  if ($storage->getSetting('target_type') !== 'paragraph') {
    return;
  }

  if (!isset($form['third_party_settings'])) {
    $form['third_party_settings'] = [
      '#type' => 'container',
      '#tree' => TRUE,
    ];
  }
  elseif (!isset($form['third_party_settings']['#tree'])) {
    $form['third_party_settings']['#tree'] = TRUE;
  }

  if (!isset($form['third_party_settings']['paragraph_relevance'])) {
    $form['third_party_settings']['paragraph_relevance'] = [
      '#type' => 'details',
      '#title' => t('Paragraph relevance'),
      '#open' => TRUE,
      '#tree' => TRUE,
    ];
  }

  $form['third_party_settings']['paragraph_relevance']['open_default'] = [
    '#type' => 'checkbox',
    '#title' => t('Open empty paragraph by default'),
    '#default_value' => (bool) $field_config->getThirdPartySetting('paragraph_relevance', 'open_default', FALSE),
    '#description' => t('Shows the paragraph subform open when the field is empty.'),
    '#parents' => ['third_party_settings', 'paragraph_relevance', 'open_default'],
  ];

  if (!isset($form['#entity_builders']) || !is_array($form['#entity_builders'])) {
    $form['#entity_builders'] = [];
  }
  if (!in_array('paragraph_relevance_field_config_entity_builder', $form['#entity_builders'], TRUE)) {
    $form['#entity_builders'][] = 'paragraph_relevance_field_config_entity_builder';
  }
}

/**
 * Entity builder callback for field config settings.
 */
function paragraph_relevance_field_config_entity_builder(string $entity_type_id, EntityInterface $field_config, array &$form, FormStateInterface $form_state): void {
  if (!$field_config instanceof FieldConfigInterface) {
    return;
  }

  $exists = NULL;
  $input = (array) $form_state->getUserInput();
  $raw = NestedArray::getValue(
    $input,
    ['third_party_settings', 'paragraph_relevance', 'open_default'],
    $exists,
  );
  if ($exists) {
    $field_config->setThirdPartySetting('paragraph_relevance', 'open_default', (bool) $raw);
    return;
  }

  $values = $form_state->getValue(['third_party_settings', 'paragraph_relevance']);
  if (is_array($values) && array_key_exists('open_default', $values)) {
    $field_config->setThirdPartySetting('paragraph_relevance', 'open_default', (bool) $values['open_default']);
  }
}

/**
 * Implements hook_entity_view().
 */
function paragraph_relevance_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if ($entity->getEntityTypeId() !== 'paragraph') {
    return;
  }

  $build['#attached']['library'][] = 'paragraph_relevance/relevance_paragraph_base_layout';
}

/**
 * Implements hook_preprocess_field_group_html_element().
 */
function paragraph_relevance_preprocess_field_group_html_element(array &$variables): void {
  if (
    empty($variables['element']) ||
    !is_array($variables['element']) ||
    empty($variables['element']['#attributes']) ||
    !is_array($variables['element']['#attributes'])
  ) {
    return;
  }

  $attributes = &$variables['element']['#attributes'];
  $selector = (string) ($attributes['data-drupal-selector'] ?? '');
  if ($selector === '') {
    return;
  }

  if (!preg_match('/^edit-field-([a-z0-9_]+)-widget-\d+-subform-group-relevance$/', $selector, $matches)) {
    return;
  }

  $bundle = $matches[1];
  $attributes['data-paragraph-relevance-group'] = $bundle;

  if (!isset($attributes['class'])) {
    $attributes['class'] = [];
  }
  elseif (is_string($attributes['class'])) {
    $attributes['class'] = preg_split('/\s+/', trim($attributes['class'])) ?: [];
  }
  elseif (!is_array($attributes['class'])) {
    $attributes['class'] = [];
  }

  if (!in_array('relevance-ui', $attributes['class'], TRUE)) {
    $attributes['class'][] = 'relevance-ui';
  }

  if (!isset($variables['attributes'])) {
    $variables['attributes'] = new Attribute();
  }
  elseif (is_array($variables['attributes'])) {
    $variables['attributes'] = new Attribute($variables['attributes']);
  }

  if ($variables['attributes'] instanceof Attribute) {
    $variables['attributes']->setAttribute('data-paragraph-relevance-group', $bundle);
    $variables['attributes']->addClass('relevance-ui');
  }
}

/**
 * Implements hook_preprocess_paragraph().
 */
function paragraph_relevance_preprocess_paragraph(array &$variables): void {
  if (empty($variables['paragraph'])) {
    return;
  }

  if (!isset($variables['attributes'])) {
    $variables['attributes'] = new Attribute();
  }
  elseif (is_array($variables['attributes'])) {
    $variables['attributes'] = new Attribute($variables['attributes']);
  }

  $sanitize = static function (string $value): string {
    $value = preg_replace('/[^a-zA-Z0-9_-]+/', '-', $value);
    $value = trim($value ?? '', '-');
    if ($value === '') {
      return '';
    }
    if (preg_match('/^\d/', $value)) {
      $value = 'vm-' . $value;
    }
    return strtolower($value);
  };

  $view_mode = (string) ($variables['elements']['#view_mode'] ?? '');
  $view_mode_token = $sanitize($view_mode);
  if ($view_mode_token !== '') {
    $variables['attributes']->addClass('paragraph--viewmode-' . $view_mode_token);
  }

  $bundle = (string) $variables['paragraph']->bundle();
  if ($bundle !== '' && !$variables['attributes']->hasAttribute('id')) {
    $variables['attributes']->setAttribute('id', $bundle);
  }
  $bundle_token = $sanitize($bundle);
  if ($bundle_token !== '') {
    $variables['attributes']->addClass('paragraph--bundle-' . $bundle_token);
  }

  static $type_cache = [];
  if (!array_key_exists($bundle, $type_cache)) {
    $type_cache[$bundle] = \Drupal::entityTypeManager()
      ->getStorage('paragraphs_type')
      ->load($bundle);
  }

  $paragraph_type = $type_cache[$bundle];
  if ($paragraph_type) {
    $classes = (string) $paragraph_type->getThirdPartySetting('paragraph_relevance', 'css_classes', '');
    $classes = array_values(array_filter(preg_split('/\s+/', trim($classes))));
    if ($classes) {
      $variables['attributes']->addClass($classes);
    }
  }

  if ($view_mode !== 'modal') {
    try {
      $modal_url = Url::fromRoute('paragraph_relevance.paragraph_modal', [
        'paragraph' => $variables['paragraph']->id(),
      ]);
    }
    catch (RouteNotFoundException $exception) {
      return;
    }
    $modal_link_attributes = [
      'class' => ['use-ajax', 'paragraph-relevance-modal-link'],
      'data-dialog-type' => 'modal',
      'data-dialog-options' => Json::encode(['width' => '80%']),
    ];

    $variables['paragraph_relevance_modal_url'] = $modal_url;
    $variables['paragraph_relevance_modal_link_attributes'] = $modal_link_attributes;

    if (!isset($variables['elements']['#attached']) || !is_array($variables['elements']['#attached'])) {
      $variables['elements']['#attached'] = [];
    }
    $variables['elements']['#attached']['library'][] = 'core/drupal.dialog.ajax';
  }
}

/**
 * After build callback to annotate relevance-driven field groups.
 */
function paragraph_relevance_after_build(array $form, FormStateInterface $form_state): array {
  \Drupal::logger('paragraph_relevance')->notice('paragraph_relevance_after_build ran');

  if (!paragraph_relevance_is_listing_form($form_state, $form['#form_id'] ?? '')) {
    return $form;
  }

  $form_object = $form_state->getFormObject();
  $entity = $form_object && method_exists($form_object, 'getEntity')
    ? $form_object->getEntity()
    : NULL;

  $source_field_names = paragraph_relevance_source_field_names($entity);
  $source_elements = [];
  foreach ($source_field_names as $source_field_name) {
    $source_paths = paragraph_relevance_collect_field_paths($form, $source_field_name);
    foreach ($source_paths as $path) {
      $source = &paragraph_relevance_form_get_ref($form, $path);
      if (!isset($source['#attributes']) || !is_array($source['#attributes'])) {
        $source['#attributes'] = [];
      }
      $source['#attributes']['data-paragraph-relevance-source'] = $source_field_name;
      $source_elements[$source_field_name] = $source;
    }
  }

  $term_bundle_map = paragraph_relevance_collect_term_bundle_map($entity, $source_elements, $source_field_names);
  if (!empty($term_bundle_map)) {
    $form['#attached']['drupalSettings']['paragraphRelevance']['termBundles'] = $term_bundle_map;
  }
  $form['#attached']['drupalSettings']['paragraphRelevance']['sourceFields'] = $source_field_names;

  $relevance_fields = paragraph_relevance_collect_relevance_fields($form);
  $target_bundles = [];
  foreach ($relevance_fields as $info) {
    $target_bundles[$info['term']] = TRUE;
  }

  $group_paths = paragraph_relevance_collect_group_paths($form);
  foreach ($group_paths as $group_key => $path) {
    if (!str_starts_with($group_key, 'group_')) {
      continue;
    }
    $bundle = substr($group_key, strlen('group_'));
    if ($bundle === '' || empty($target_bundles[$bundle])) {
      continue;
    }
    $group = &paragraph_relevance_form_get_ref($form, $path);
    if (!isset($group['#attributes']) || !is_array($group['#attributes'])) {
      $group['#attributes'] = [];
    }
    if (!isset($group['#attributes']['class']) || !is_array($group['#attributes']['class'])) {
      $group['#attributes']['class'] = [];
    }
    if (!in_array('paragraph-relevance-hidden', $group['#attributes']['class'], TRUE)) {
      $group['#attributes']['class'][] = 'paragraph-relevance-hidden';
    }
    $group['#attributes']['data-paragraph-relevance-group'] = $bundle;
  }

  foreach ($relevance_fields as $field_name => $info) {
    $field = &paragraph_relevance_form_get_ref($form, $info['path']);
    if (!isset($field['#attributes']) || !is_array($field['#attributes'])) {
      $field['#attributes'] = [];
    }
    if (!isset($field['#attributes']['class']) || !is_array($field['#attributes']['class'])) {
      $field['#attributes']['class'] = [];
    }
    $field['#attributes']['data-paragraph-relevance-term'] = $info['term'];
    if (!in_array('paragraph-relevance-field', $field['#attributes']['class'], TRUE)) {
      $field['#attributes']['class'][] = 'paragraph-relevance-field';
    }
    if (!in_array('paragraph-relevance-hidden', $field['#attributes']['class'], TRUE)) {
      $field['#attributes']['class'][] = 'paragraph-relevance-hidden';
    }
  }

  return $form;
}

/**
 * Submit handler placeholder.
 */
function paragraph_relevance_listing_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::logger('paragraph_relevance')->notice('SUBMIT handler ran: form_id=@id', [
    '@id' => $form['#form_id'] ?? 'unknown',
  ]);

  foreach (['field_retreats', 'field_hosting'] as $fname) {
    $v = $form_state->getValue($fname);

    \Drupal::logger('paragraph_relevance')->notice('SUBMIT @f items: @count', [
      '@f' => $fname,
      '@count' => is_array($v) ? count($v) : -1,
    ]);

    \Drupal::logger('paragraph_relevance')->notice('SUBMIT @f raw: @raw', [
      '@f' => $fname,
      '@raw' => substr(json_encode($v), 0, 4000),
    ]);
  }
}

/**
 * Implements hook_entity_presave().
 */
function paragraph_relevance_entity_presave(EntityInterface $entity): void {
  // Keep pruning disabled (handled on submit), but sync relevance to listing
  // bundle fields on every listing save.
  if (
    $entity->getEntityTypeId() === 'node' &&
    method_exists($entity, 'bundle') &&
    $entity->bundle() === 'listing'
  ) {
    paragraph_relevance_with_listing_save_guard($entity, function () use ($entity): void {
      paragraph_relevance_sync_listing_paragraph_relevance2($entity);
      paragraph_relevance_sync_listing_paragraph_effective_relevance($entity);
    });
  }
}

/**
 * Implements hook_entity_insert().
 */
function paragraph_relevance_entity_insert(EntityInterface $entity): void {
  return;
}

/**
 * Implements hook_entity_update().
 */
function paragraph_relevance_entity_update(EntityInterface $entity): void {
  return;
}

/**
 * Check if the form is the listing add/edit form.
 */
function paragraph_relevance_is_listing_form(FormStateInterface $form_state, string $form_id): bool {
  $allowed_forms = [
    'node_listing_form',
    'node_listing_edit_form',
  ];

  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return FALSE;
  }

  $entity = $form_object->getEntity();
  if (!$entity || !method_exists($entity, 'bundle')) {
    return FALSE;
  }

  if ($entity->getEntityTypeId() !== 'node') {
    return FALSE;
  }

  if ($entity->bundle() !== 'listing') {
    return FALSE;
  }

  return in_array($form_id, $allowed_forms, TRUE);
}

/**
 * Check if the form is a listing form-mode editor with static visibility.
 */
function paragraph_relevance_is_static_listing_form_mode(FormStateInterface $form_state, string $form_id): bool {
  $allowed_forms = [
    'node_listing_text_form',
    'node_listing_images_form',
  ];

  if (!in_array($form_id, $allowed_forms, TRUE)) {
    return FALSE;
  }

  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return FALSE;
  }

  $entity = $form_object->getEntity();
  if (!$entity || !method_exists($entity, 'bundle')) {
    return FALSE;
  }

  return $entity->getEntityTypeId() === 'node' && $entity->bundle() === 'listing';
}

/**
 * Hide paragraph fields in form-mode editors based on the stored node only.
 */
function paragraph_relevance_apply_static_form_mode_visibility(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!paragraph_relevance_is_static_listing_form_mode($form_state, $form_id)) {
    return;
  }

  $form_object = $form_state->getFormObject();
  $entity = $form_object && method_exists($form_object, 'getEntity')
    ? $form_object->getEntity()
    : NULL;
  if (!$entity instanceof EntityInterface) {
    return;
  }

  $source_field_names = paragraph_relevance_source_field_names($entity);
  if (!$source_field_names) {
    return;
  }

  $term_bundle_map = paragraph_relevance_collect_term_bundle_map($entity, [], $source_field_names);
  if (!$term_bundle_map) {
    return;
  }

  $selected_term_ids = paragraph_relevance_collect_selected_term_ids(NULL, $entity);
  if (!$selected_term_ids) {
    paragraph_relevance_hide_all_static_form_mode_paragraph_fields($form, $entity);
    return;
  }

  $visible_bundles = [];
  foreach ($selected_term_ids as $term_id) {
    foreach (($term_bundle_map[(string) $term_id] ?? $term_bundle_map[$term_id] ?? []) as $bundle) {
      $bundle = trim((string) $bundle);
      if ($bundle === '') {
        continue;
      }
      $visible_bundles[$bundle] = TRUE;
      $visible_bundles[strtr($bundle, ['-' => '_'])] = TRUE;
    }
  }

  paragraph_relevance_hide_static_form_mode_paragraph_fields($form, $entity, array_keys($visible_bundles));
}

/**
 * Hide all paragraph fields that belong to listing paragraph bundles.
 */
function paragraph_relevance_hide_all_static_form_mode_paragraph_fields(array &$form, EntityInterface $entity): void {
  $visible_bundles = [];
  paragraph_relevance_hide_static_form_mode_paragraph_fields($form, $entity, $visible_bundles);
}

/**
 * Hide paragraph fields whose bundle is not visible in static form modes.
 */
function paragraph_relevance_hide_static_form_mode_paragraph_fields(array &$form, EntityInterface $entity, array $visible_bundles): void {
  $visible_lookup = [];
  foreach ($visible_bundles as $bundle) {
    $bundle = trim((string) $bundle);
    if ($bundle === '') {
      continue;
    }
    $visible_lookup[$bundle] = TRUE;
    $visible_lookup[strtr($bundle, ['-' => '_'])] = TRUE;
  }

  foreach ($entity->getFieldDefinitions() as $field_name => $definition) {
    if (!$definition instanceof FieldConfigInterface) {
      continue;
    }
    if ($definition->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($definition->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    if (!isset($form[$field_name]) || !is_array($form[$field_name])) {
      continue;
    }

    $target_bundles = $definition->getSetting('handler_settings')['target_bundles'] ?? [];
    $target_bundles = array_values(array_filter(array_map('strval', $target_bundles)));
    if (count($target_bundles) !== 1) {
      continue;
    }

    $bundle = reset($target_bundles);
    $relevance_field_name = 'field_' . strtr((string) $bundle, ['-' => '_']) . '_relevance';
    if (!$entity->hasField($relevance_field_name)) {
      continue;
    }
    if ($bundle === FALSE || isset($visible_lookup[$bundle]) || isset($visible_lookup[strtr($bundle, ['-' => '_'])])) {
      continue;
    }

    $form[$field_name]['#access'] = FALSE;
  }
}

/**
 * Sync paragraph field_relevance2 values on listing save.
 *
 * Standard relevance-enabled paragraphs keep the higher value between stored
 * field_relevance2 and the paragraph's desired field_relevance. Location
 * paragraphs are treated as if their desired relevance were always 3.
 */
function paragraph_relevance_sync_listing_paragraph_relevance2(EntityInterface $listing): void {
  if ($listing->getEntityTypeId() !== 'node' || !method_exists($listing, 'bundle')) {
    return;
  }
  if ($listing->bundle() !== 'listing' || !method_exists($listing, 'getFieldDefinitions')) {
    return;
  }

  foreach ($listing->getFieldDefinitions() as $field_name => $definition) {
    if (!method_exists($definition, 'getType') || $definition->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if (!method_exists($definition, 'getSetting') || $definition->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    if (!$listing->hasField($field_name) || $listing->get($field_name)->isEmpty()) {
      continue;
    }

    $items = $listing->get($field_name);
    foreach ($items as $delta => $item) {
      $paragraph = $item->entity;
      if (!$paragraph instanceof EntityInterface) {
        continue;
      }
      if (!$paragraph->hasField('field_relevance2')) {
        continue;
      }

      $desired_relevance = paragraph_relevance_get_desired_relevance_for_sync($paragraph);
      if (paragraph_relevance_relevance_is_empty($desired_relevance)) {
        continue;
      }

      $existing_relevance = paragraph_relevance_extract_value($paragraph->get('field_relevance2')->getValue());
      $effective_relevance = paragraph_relevance_pick_higher_relevance($existing_relevance, $desired_relevance);
      if ((string) $existing_relevance === (string) $effective_relevance) {
        continue;
      }

      if (paragraph_relevance_relevance_is_empty($effective_relevance)) {
        $paragraph->set('field_relevance2', []);
      }
      else {
        $paragraph->set('field_relevance2', $effective_relevance);
      }

      if ($paragraph->id()) {
        paragraph_relevance_persist_synced_paragraph($paragraph, $items, (int) $delta, $item);
      }
    }
  }
}

/**
 * Save a synced paragraph and update the parent item revision reference.
 */
function paragraph_relevance_persist_synced_paragraph(EntityInterface $paragraph, FieldItemListInterface $items, int $delta, $item): void {
  if (!method_exists($paragraph, 'save') || !method_exists($paragraph, 'setNewRevision')) {
    return;
  }

  $paragraph->setNewRevision(TRUE);
  $paragraph->save();

  $new_value = [
    'target_id' => $paragraph->id(),
    'target_revision_id' => method_exists($paragraph, 'getRevisionId') ? $paragraph->getRevisionId() : NULL,
  ];

  $items->set($delta, $new_value);

  if (is_object($item) && property_exists($item, 'target_id')) {
    $item->target_id = $new_value['target_id'];
  }
  if (is_object($item) && property_exists($item, 'target_revision_id')) {
    $item->target_revision_id = $new_value['target_revision_id'];
  }
}

/**
 * Determine the desired paragraph relevance used for field_relevance2 sync.
 */
function paragraph_relevance_get_desired_relevance_for_sync(EntityInterface $paragraph): ?string {
  if ($paragraph->hasField('field_relevance')) {
    $desired = paragraph_relevance_extract_value($paragraph->get('field_relevance')->getValue());
    if (!paragraph_relevance_relevance_is_empty($desired)) {
      return $desired;
    }
  }

  if (method_exists($paragraph, 'bundle') && $paragraph->bundle() === 'location') {
    return '3';
  }

  return NULL;
}

/**
 * Copy paragraph field_relevance2 values into listing field_<bundle>_relevance fields.
 */
function paragraph_relevance_sync_listing_paragraph_effective_relevance(EntityInterface $listing): void {
  if ($listing->getEntityTypeId() !== 'node' || !method_exists($listing, 'bundle')) {
    return;
  }
  if ($listing->bundle() !== 'listing' || !method_exists($listing, 'getFieldDefinitions')) {
    return;
  }

  $bundle_relevance_values = [];

  foreach ($listing->getFieldDefinitions() as $field_name => $definition) {
    if (!method_exists($definition, 'getType') || $definition->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if (!method_exists($definition, 'getSetting') || $definition->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    if (!$listing->hasField($field_name) || $listing->get($field_name)->isEmpty()) {
      continue;
    }

    foreach ($listing->get($field_name)->referencedEntities() as $paragraph) {
      if (!$paragraph instanceof EntityInterface || !method_exists($paragraph, 'bundle')) {
        continue;
      }
      if (!$paragraph->hasField('field_relevance2')) {
        continue;
      }

      $parent_relevance_field = 'field_' . strtr((string) $paragraph->bundle(), ['-' => '_']) . '_relevance';
      if (!$listing->hasField($parent_relevance_field)) {
        continue;
      }

      $value = paragraph_relevance_extract_value($paragraph->get('field_relevance2')->getValue());
      $current_value = $bundle_relevance_values[$parent_relevance_field] ?? NULL;

      if ($current_value === NULL) {
        $bundle_relevance_values[$parent_relevance_field] = $value;
      }
      else {
        $bundle_relevance_values[$parent_relevance_field] = paragraph_relevance_pick_higher_relevance($current_value, $value);
      }
    }
  }

  $minimum_relevance_by_field = paragraph_relevance_collect_defaults_tags_min_relevance($listing);
  foreach ($minimum_relevance_by_field as $field_name => $minimum) {
    $current_value = $bundle_relevance_values[$field_name] ?? NULL;
    $bundle_relevance_values[$field_name] = paragraph_relevance_enforce_minimum_relevance($current_value, $minimum);
  }

  foreach ($bundle_relevance_values as $field_name => $value) {
    if (!$listing->hasField($field_name)) {
      continue;
    }

    if (paragraph_relevance_relevance_is_empty($value)) {
      $listing->set($field_name, []);
    }
    else {
      $listing->set($field_name, $value);
    }
  }
}

/**
 * Returns the higher of two relevance values.
 */
function paragraph_relevance_pick_higher_relevance($first, $second): ?string {
  if (paragraph_relevance_relevance_is_empty($first)) {
    return paragraph_relevance_relevance_is_empty($second) ? NULL : (string) $second;
  }
  if (paragraph_relevance_relevance_is_empty($second)) {
    return (string) $first;
  }

  $first_number = is_numeric((string) $first) ? (float) $first : NULL;
  $second_number = is_numeric((string) $second) ? (float) $second : NULL;
  if ($first_number !== NULL && $second_number !== NULL) {
    return (string) max($first_number, $second_number);
  }

  return (string) $second;
}

/**
 * Enforces a minimum relevance value when both values are numeric.
 */
function paragraph_relevance_enforce_minimum_relevance($value, $minimum): ?string {
  $minimum = paragraph_relevance_relevance_is_empty($minimum) ? NULL : (string) $minimum;
  if ($minimum === NULL) {
    return paragraph_relevance_relevance_is_empty($value) ? NULL : (string) $value;
  }

  if (paragraph_relevance_relevance_is_empty($value)) {
    return $minimum;
  }

  $value_number = is_numeric((string) $value) ? (float) $value : NULL;
  $minimum_number = is_numeric($minimum) ? (float) $minimum : NULL;
  if ($value_number !== NULL && $minimum_number !== NULL) {
    return (string) max($value_number, $minimum_number);
  }

  return (string) $value;
}

/**
 * Builds minimum relevance requirements from listing defaults-tags terms.
 *
 * If at least two selected terms reference a key aspect that maps to a
 * paragraph bundle, the corresponding listing field_<bundle>_relevance gets a
 * minimum relevance of 1.
 */
function paragraph_relevance_collect_defaults_tags_min_relevance(EntityInterface $listing): array {
  $defaults_tags_field = '';
  if ($listing->hasField('field_defaults_tags')) {
    $defaults_tags_field = 'field_defaults_tags';
  }
  elseif ($listing->hasField('field_defualts_tags')) {
    // Backward compatibility for misspelled field names.
    $defaults_tags_field = 'field_defualts_tags';
  }

  if ($defaults_tags_field === '' || $listing->get($defaults_tags_field)->isEmpty()) {
    return [];
  }

  $bundle_counts = [];
  foreach ($listing->get($defaults_tags_field)->referencedEntities() as $term) {
    if (!$term instanceof EntityInterface || !$term->hasField('field_key_aspects') || $term->get('field_key_aspects')->isEmpty()) {
      continue;
    }

    $term_bundles = [];
    foreach ($term->get('field_key_aspects')->referencedEntities() as $key_aspect) {
      if (!$key_aspect instanceof EntityInterface) {
        continue;
      }
      $term_bundles = array_merge($term_bundles, paragraph_relevance_collect_term_bundles($key_aspect));
    }

    $term_bundles = array_values(array_unique(array_filter($term_bundles)));
    foreach ($term_bundles as $bundle) {
      $normalized_bundle = strtr((string) $bundle, ['-' => '_']);
      if ($normalized_bundle === '') {
        continue;
      }
      if (!isset($bundle_counts[$normalized_bundle])) {
        $bundle_counts[$normalized_bundle] = 0;
      }
      $bundle_counts[$normalized_bundle]++;
    }
  }

  $minimums = [];
  foreach ($bundle_counts as $bundle => $count) {
    if ($count < 2) {
      continue;
    }

    $field_name = 'field_' . $bundle . '_relevance';
    if ($listing->hasField($field_name)) {
      $minimums[$field_name] = '1';
    }
  }

  return $minimums;
}

/**
 * Run a callback while tracking a listing entity save in progress.
 */
function paragraph_relevance_with_listing_save_guard(EntityInterface $listing, callable $callback): void {
  $key = paragraph_relevance_listing_save_guard_key($listing);
  if ($key === '') {
    $callback();
    return;
  }

  paragraph_relevance_listing_save_guard_depth($key, 1);
  try {
    $callback();
  }
  finally {
    paragraph_relevance_listing_save_guard_depth($key, -1);
  }
}

/**
 * Whether the listing is currently in a save cycle within this request.
 */
function paragraph_relevance_listing_save_in_progress(EntityInterface $listing): bool {
  $key = paragraph_relevance_listing_save_guard_key($listing);
  if ($key === '') {
    return FALSE;
  }

  return paragraph_relevance_listing_save_guard_depth($key) > 0;
}

/**
 * Build a stable in-request key for a listing entity.
 */
function paragraph_relevance_listing_save_guard_key(EntityInterface $listing): string {
  if ($listing->getEntityTypeId() !== 'node' || !method_exists($listing, 'bundle') || $listing->bundle() !== 'listing') {
    return '';
  }

  if ($listing->id()) {
    return 'node:' . $listing->id();
  }

  if (method_exists($listing, 'uuid') && $listing->uuid()) {
    return 'node-uuid:' . $listing->uuid();
  }

  return '';
}

/**
 * Shared recursion guard depth keyed by listing.
 */
function paragraph_relevance_listing_save_guard_depth(string $key, int $delta = 0): int {
  static $depth_map = [];

  if (!isset($depth_map[$key])) {
    $depth_map[$key] = 0;
  }

  $depth_map[$key] += $delta;
  if ($depth_map[$key] < 0) {
    $depth_map[$key] = 0;
  }

  return $depth_map[$key];
}

/**
 * Append empty paragraph items for open default fields and add validation.
 */
function paragraph_relevance_open_default_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();
  if (!$entity instanceof EntityInterface || $entity->getEntityTypeId() !== 'node') {
    return;
  }

  $open_fields = paragraph_relevance_collect_open_default_fields($entity);
  if (!$open_fields) {
    return;
  }

  $input = $form_state->getUserInput();
  foreach ($open_fields as $field_name) {
    if (!$entity->hasField($field_name)) {
      continue;
    }
    if (is_array($input) && array_key_exists($field_name, $input)) {
      continue;
    }
    $items = $entity->get($field_name);
    if ($items->isEmpty()) {
      $items->appendItem();
      if (paragraph_relevance_debug_enabled()) {
        \Drupal::logger('paragraph_relevance')->debug('Added empty item for field @field.', ['@field' => $field_name]);
      }
    }
  }

  // Do not attach save-time pruning handlers here.
}

/**
 * Validation handler to drop empty open default paragraphs.
 */
function paragraph_relevance_open_default_validate(array &$form, FormStateInterface $form_state): void {
  // Intentionally disabled to avoid any save-time data pruning.
}

/**
 * Collect open default paragraph fields from the entity.
 */
function paragraph_relevance_collect_open_default_fields(EntityInterface $entity): array {
  $fields = [];
  foreach ($entity->getFieldDefinitions() as $field_name => $definition) {
    if (!$definition instanceof FieldConfigInterface) {
      continue;
    }
    if ($definition->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($definition->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    if (!$definition->getThirdPartySetting('paragraph_relevance', 'open_default', FALSE)) {
      continue;
    }
    $fields[] = $field_name;
  }

  return $fields;
}

/**
 * Extract relevance from a paragraph entity or submitted values.
 */
function paragraph_relevance_get_paragraph_relevance_value(?EntityInterface $paragraph, FormStateInterface $form_state, string $field_name, int $delta): ?string {
  $subform = paragraph_relevance_get_submitted_paragraph_subform($form_state, $field_name, $delta);
  if (is_array($subform)) {
    if (array_key_exists('field_relevance', $subform)) {
      return paragraph_relevance_extract_value($subform['field_relevance']);
    }
    if (array_key_exists('field_relevance2', $subform)) {
      return paragraph_relevance_extract_value($subform['field_relevance2']);
    }
  }

  if ($paragraph) {
    foreach (['field_relevance', 'field_relevance2'] as $relevance_field) {
      if (!$paragraph->hasField($relevance_field)) {
        continue;
      }
      $value = $paragraph->get($relevance_field)->value;
      if ($value !== NULL && $value !== '') {
        return (string) $value;
      }
    }
  }
  return NULL;
}

/**
 * Determine whether a paragraph item has meaningful submitted or stored content.
 */
function paragraph_relevance_paragraph_item_has_content(?EntityInterface $paragraph, FormStateInterface $form_state, string $field_name, int $delta): bool {
  $subform = paragraph_relevance_get_submitted_paragraph_subform($form_state, $field_name, $delta);
  if (is_array($subform)) {
    return paragraph_relevance_array_has_meaningful_value($subform);
  }

  return $paragraph ? paragraph_relevance_paragraph_has_meaningful_entity_content($paragraph) : FALSE;
}

/**
 * Extract submitted paragraph items from direct or widget-nested values.
 *
 * @return array{0:?string,1:array}
 *   Tuple of container key ("widget" or NULL) and paragraph items array.
 */
function paragraph_relevance_extract_submitted_paragraph_items(array $values): array {
  if (isset($values['widget']) && is_array($values['widget'])) {
    return ['widget', $values['widget']];
  }

  return [NULL, $values];
}

/**
 * Get a submitted paragraph subform for one field item delta.
 */
function paragraph_relevance_get_submitted_paragraph_subform(FormStateInterface $form_state, string $field_name, int $delta): ?array {
  $values = $form_state->getValue($field_name);
  if (!is_array($values)) {
    return NULL;
  }

  [, $items] = paragraph_relevance_extract_submitted_paragraph_items($values);
  if (!array_key_exists($delta, $items) || !is_array($items[$delta])) {
    return NULL;
  }

  $item = $items[$delta];
  $subform = $item['subform'] ?? $item;
  return is_array($subform) ? $subform : NULL;
}

/**
 * Check recursively whether submitted values contain meaningful content.
 */
function paragraph_relevance_array_has_meaningful_value(array $values): bool {
  $ignored_keys = [
    '_weight',
    'remove_button',
    'add_more',
    'actions',
    'top',
    'bottom',
    'format',
    'field_relevance',
    'field_relevance2',
  ];

  foreach ($values as $key => $value) {
    if (is_string($key) && in_array($key, $ignored_keys, TRUE)) {
      continue;
    }

    if (is_array($value)) {
      if (paragraph_relevance_array_has_meaningful_value($value)) {
        return TRUE;
      }
      continue;
    }

    if (is_object($value)) {
      continue;
    }

    if ($value === NULL) {
      continue;
    }

    if (is_bool($value)) {
      if ($value) {
        return TRUE;
      }
      continue;
    }

    if (is_scalar($value)) {
      $normalized = trim((string) $value);
      if ($normalized === '' || $normalized === '0') {
        continue;
      }
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Returns all paragraph-reference field names on a listing entity.
 */
function paragraph_relevance_collect_paragraph_reference_fields(EntityInterface $entity): array {
  $fields = [];
  if (!method_exists($entity, 'getFieldDefinitions')) {
    return $fields;
  }

  foreach ($entity->getFieldDefinitions() as $field_name => $definition) {
    if (!$definition instanceof FieldConfigInterface) {
      continue;
    }
    if ($definition->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($definition->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    $fields[] = $field_name;
  }

  return $fields;
}

/**
 * Prune paragraph items that are both content-empty and relevance-empty/zero.
 */
function paragraph_relevance_prune_empty_zero_paragraph_items(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'node' || !method_exists($entity, 'bundle') || $entity->bundle() !== 'listing') {
    return;
  }

  foreach (paragraph_relevance_collect_paragraph_reference_fields($entity) as $field_name) {
    if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
      continue;
    }

    $items = $entity->get($field_name);
    $remove_deltas = [];
    foreach ($items as $delta => $item) {
      $paragraph = $item->entity;
      if (!$paragraph instanceof EntityInterface) {
        continue;
      }
      if (!paragraph_relevance_is_relevance_enabled_paragraph($paragraph)) {
        continue;
      }

      $has_content = paragraph_relevance_paragraph_has_meaningful_entity_content($paragraph);
      $relevance = paragraph_relevance_get_entity_relevance_value($paragraph);
      if (!$has_content && paragraph_relevance_relevance_is_empty($relevance)) {
        $pid = method_exists($paragraph, 'id') ? ($paragraph->id() ?? 'new') : 'n/a';
        $uuid = method_exists($paragraph, 'uuid') ? ($paragraph->uuid() ?? 'n/a') : 'n/a';
        $bundle = method_exists($paragraph, 'bundle') ? ($paragraph->bundle() ?? 'n/a') : 'n/a';
        \Drupal::logger('paragraph_relevance')->notice('Pruning paragraph reference: field=@field delta=@delta bundle=@bundle id=@id uuid=@uuid', [
          '@field' => $field_name,
          '@delta' => (string) $delta,
          '@bundle' => $bundle,
          '@id' => (string) $pid,
          '@uuid' => (string) $uuid,
        ]);
        $remove_deltas[] = (int) $delta;
      }
    }

    if ($remove_deltas) {
      rsort($remove_deltas);
      foreach ($remove_deltas as $delta) {
        unset($items[$delta]);
      }
    }
  }
}

/**
 * Checks whether the paragraph bundle has relevance fields enabled.
 */
function paragraph_relevance_is_relevance_enabled_paragraph(EntityInterface $paragraph): bool {
  return $paragraph->hasField('field_relevance') || $paragraph->hasField('field_relevance2');
}

/**
 * Determine whether a paragraph entity has meaningful content fields.
 */
function paragraph_relevance_paragraph_has_meaningful_entity_content(EntityInterface $paragraph): bool {
  if (!method_exists($paragraph, 'getFieldDefinitions')) {
    return FALSE;
  }

  foreach ($paragraph->getFieldDefinitions() as $name => $definition) {
    if (!$definition instanceof FieldConfigInterface) {
      continue;
    }
    if (!$paragraph->hasField($name)) {
      continue;
    }
    if (in_array($name, ['field_relevance', 'field_relevance2'], TRUE)) {
      continue;
    }
    if (str_starts_with($name, 'revision_') || str_starts_with($name, 'moderation_')) {
      continue;
    }
    if ($paragraph->get($name)->isEmpty()) {
      continue;
    }
    return TRUE;
  }

  return FALSE;
}

/**
 * Extract the first available relevance value from a paragraph entity.
 */
function paragraph_relevance_get_entity_relevance_value(EntityInterface $paragraph): ?string {
  foreach (['field_relevance', 'field_relevance2'] as $field_name) {
    if (!$paragraph->hasField($field_name)) {
      continue;
    }
    $value = paragraph_relevance_extract_value($paragraph->get($field_name)->getValue());
    if ($value !== NULL) {
      return $value;
    }
  }

  return NULL;
}

/**
 * Determine whether a relevance value should be treated as empty.
 */
function paragraph_relevance_relevance_is_empty($value): bool {
  if ($value === NULL) {
    return TRUE;
  }
  if (is_string($value) && trim($value) === '') {
    return TRUE;
  }
  if ((string) $value === '0') {
    return TRUE;
  }

  return FALSE;
}

/**
 * Clear form errors for a removed paragraph item.
 */
function paragraph_relevance_clear_errors_for_item(FormStateInterface $form_state, string $field_name, int $delta): void {
  $errors = $form_state->getErrors();
  if (!$errors) {
    return;
  }

  $prefix = $field_name . '[' . $delta . ']';
  foreach (array_keys($errors) as $name) {
    if (str_starts_with((string) $name, $prefix)) {
      $form_state->clearErrorByName($name);
    }
  }
}

/**
 * Check whether debug logging is enabled.
 */
function paragraph_relevance_debug_enabled(): bool {
  return (bool) \Drupal::config('paragraph_relevance.settings')->get('debug');
}

/**
 * Collect relevance field paths from the form.
 */
function paragraph_relevance_collect_relevance_fields(array $form, array $parents = []): array {
  $fields = [];
  foreach ($form as $key => $element) {
    if (!is_string($key) || $key === '' || $key[0] === '#') {
      continue;
    }
    if (!is_array($element)) {
      continue;
    }
    if (preg_match('/^field_(.+)_relevance$/', $key, $matches)) {
      $fields[$key] = [
        'term' => $matches[1],
        'path' => array_merge($parents, [$key]),
      ];
    }
    $fields += paragraph_relevance_collect_relevance_fields($element, array_merge($parents, [$key]));
  }

  return $fields;
}

/**
 * Collect field paths by machine name.
 */
function paragraph_relevance_collect_field_paths(array $form, string $field_name, array $parents = []): array {
  $paths = [];
  foreach ($form as $key => $element) {
    if (!is_string($key) || $key === '' || $key[0] === '#') {
      continue;
    }
    if (!is_array($element)) {
      continue;
    }
    if ($key === $field_name) {
      $paths[] = array_merge($parents, [$key]);
    }
    $paths = array_merge($paths, paragraph_relevance_collect_field_paths($element, $field_name, array_merge($parents, [$key])));
  }

  return $paths;
}

/**
 * Collect group element paths from the form.
 */
function paragraph_relevance_collect_group_paths(array $form, array $parents = []): array {
  $paths = [];
  foreach ($form as $key => $element) {
    if (!is_string($key) || $key === '' || $key[0] === '#') {
      continue;
    }
    if (!is_array($element)) {
      continue;
    }
    if (str_starts_with($key, 'group_')) {
      $paths[$key] = array_merge($parents, [$key]);
    }
    $paths += paragraph_relevance_collect_group_paths($element, array_merge($parents, [$key]));
  }

  return $paths;
}

/**
 * Collect selected term IDs from listing taxonomy source fields.
 */
function paragraph_relevance_collect_selected_term_ids(?FormStateInterface $form_state, ?EntityInterface $entity): array {
  $term_ids = [];
  $source_fields = paragraph_relevance_source_field_names($entity);

  foreach ($source_fields as $field_name) {
    if ($form_state) {
      $term_ids = array_merge($term_ids, paragraph_relevance_extract_term_ids($form_state->getValue($field_name)));
    }

    if ($entity && $entity->hasField($field_name)) {
      $term_ids = array_merge($term_ids, paragraph_relevance_extract_term_ids($entity->get($field_name)->getValue()));
    }
  }

  return array_values(array_unique(array_filter(array_map('intval', $term_ids))));
}

/**
 * Resolve existing taxonomy-term source fields used for paragraph visibility.
 */
function paragraph_relevance_source_field_names(?EntityInterface $entity): array {
  $candidates = ['field_type', 'field_tags', 'field_default_tags', 'field_defaults_tags'];

  if (!$entity) {
    return $candidates;
  }

  $fields = [];
  foreach ($candidates as $field_name) {
    if ($entity->hasField($field_name)) {
      $fields[] = $field_name;
    }
  }

  return $fields;
}

/**
 * Extract term IDs from a field value payload.
 */
function paragraph_relevance_extract_term_ids($value): array {
  $ids = [];

  if (is_array($value)) {
    foreach ($value as $item) {
      if (is_array($item) && isset($item['target_id'])) {
        $ids[] = (int) $item['target_id'];
        continue;
      }
      if (is_int($item) || (is_string($item) && ctype_digit($item))) {
        $ids[] = (int) $item;
      }
    }
  }
  elseif (is_int($value) || (is_string($value) && ctype_digit($value))) {
    $ids[] = (int) $value;
  }
  elseif (is_string($value)) {
    preg_match_all('/\d+/', $value, $matches);
    foreach ($matches[0] as $match) {
      $ids[] = (int) $match;
    }
  }

  $ids = array_values(array_unique(array_filter($ids)));

  return $ids;
}

/**
 * Collect allowed relevance values for selected terms.
 */
function paragraph_relevance_collect_allowed_relevance_values(array $term_ids): array {
  if (!$term_ids) {
    return [];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $query = $storage->getQuery();
  $query->accessCheck(FALSE);
  $query->condition('tid', $term_ids, 'IN');
  $ids = $query->execute();
  if (!$ids) {
    return [];
  }

  $terms = $storage->loadMultiple($ids);
  $allowed = [];
  foreach ($terms as $term) {
    if (!$term || !$term->hasField('field_relevance')) {
      continue;
    }
    foreach ($term->get('field_relevance')->getValue() as $item) {
      if (isset($item['value']) && $item['value'] !== '') {
        $allowed[] = (string) $item['value'];
      }
    }
  }

  return array_values(array_unique($allowed));
}

/**
 * Build a form error prefix for a form element.
 */
function paragraph_relevance_build_error_prefix(array $element, array $path): string {
  $parents = $element['#parents'] ?? $path;
  if (!$parents) {
    return '';
  }
  $parts = array_values($parents);
  $prefix = (string) array_shift($parts);
  foreach ($parts as $part) {
    $prefix .= '[' . $part . ']';
  }

  return $prefix;
}

/**
 * Build a map of taxonomy term relevance values for the source field.
 */
function paragraph_relevance_collect_term_relevance_map(?EntityInterface $entity, array $field_element, string $field_name): array {
  $term_ids = [];

  if ($entity && $entity->hasField($field_name)) {
    $definition = $entity->getFieldDefinition($field_name);
    if ($definition) {
      $handler_settings = $definition->getSetting('handler_settings') ?? [];
      $bundles = array_filter($handler_settings['target_bundles'] ?? []);
      if ($bundles) {
        $query = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->getQuery();
        $query->accessCheck(FALSE);
        $query->condition('vid', array_values($bundles), 'IN');
        $term_ids = $query->execute();
      }
    }
  }

  if (!$term_ids) {
    $term_ids = paragraph_relevance_collect_term_ids_from_element($field_element);
  }

  if (!$term_ids) {
    return [];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $storage->loadMultiple($term_ids);
  if (!$terms) {
    return [];
  }

  $map = [];
  foreach ($terms as $term) {
    if (!$term || !$term->hasField('field_relevance')) {
      continue;
    }
    $values = [];
    foreach ($term->get('field_relevance')->getValue() as $item) {
      if (isset($item['value']) && $item['value'] !== '') {
        $values[] = (string) $item['value'];
      }
    }
    if ($values) {
      $map[(string) $term->id()] = array_values(array_unique($values));
    }
  }

  return $map;
}

/**
 * Build a map of taxonomy term IDs to paragraph bundles via field_key_aspects.
 */
function paragraph_relevance_collect_term_bundle_map(?EntityInterface $entity, array $field_elements, array $field_names): array {
  $term_ids = [];

  foreach ($field_names as $field_name) {
    if ($entity && $entity->hasField($field_name)) {
      $definition = $entity->getFieldDefinition($field_name);
      if ($definition) {
        $handler_settings = $definition->getSetting('handler_settings') ?? [];
        $bundles = array_filter($handler_settings['target_bundles'] ?? []);
        if ($bundles) {
          $query = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->getQuery();
          $query->accessCheck(FALSE);
          $query->condition('vid', array_values($bundles), 'IN');
          $term_ids = array_merge($term_ids, $query->execute());
        }
      }
    }

    if (!empty($field_elements[$field_name]) && is_array($field_elements[$field_name])) {
      $term_ids = array_merge($term_ids, paragraph_relevance_collect_term_ids_from_element($field_elements[$field_name]));
    }
  }

  $term_ids = array_values(array_unique(array_filter(array_map('intval', $term_ids))));
  if (!$term_ids) {
    return [];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $storage->loadMultiple($term_ids);
  if (!$terms) {
    return [];
  }

  $map = [];
  foreach ($terms as $term) {
    if (!$term) {
      continue;
    }

    $bundles = [];
    if ($term->hasField('field_key_aspects') && !$term->get('field_key_aspects')->isEmpty()) {
      foreach ($term->get('field_key_aspects')->referencedEntities() as $key_aspect) {
        if (!$key_aspect) {
          continue;
        }
        $bundles = array_merge($bundles, paragraph_relevance_collect_term_bundles($key_aspect));
      }
    }

    $bundles = array_merge($bundles, paragraph_relevance_collect_term_bundles($term));

    // Optional dependee-based mapping for term sets that model visibility
    // through controller -> dependee relationships.
    if ($term->hasField('field_dependee') && !$term->get('field_dependee')->isEmpty()) {
      foreach ($term->get('field_dependee')->referencedEntities() as $dependee_term) {
        if (!$dependee_term) {
          continue;
        }
        $bundles = array_merge($bundles, paragraph_relevance_collect_term_bundles($dependee_term));
      }
    }

    $bundles = array_values(array_unique(array_filter($bundles)));
    if ($bundles) {
      $map[(string) $term->id()] = $bundles;
    }
  }

  return $map;
}

/**
 * Resolve paragraph bundle aliases from a taxonomy term.
 *
 * Prefers explicit field_paragraph_bundle, then falls back to a sanitized term
 * label only when it matches an existing paragraph bundle machine name.
 */
function paragraph_relevance_collect_term_bundles(EntityInterface $term): array {
  $bundles = [];

  if ($term->hasField('field_paragraph_bundle')) {
    $bundle = trim((string) ($term->get('field_paragraph_bundle')->value ?? ''));
    if ($bundle !== '') {
      $bundles[] = $bundle;
    }
  }

  if (!$bundles) {
    $fallback = paragraph_relevance_guess_existing_paragraph_bundle_from_label((string) $term->label());
    if ($fallback !== '') {
      $bundles[] = $fallback;
    }
  }

  $aliases = [];
  foreach ($bundles as $bundle) {
    $aliases[] = $bundle;
    $aliases[] = strtr($bundle, ['-' => '_']);
  }

  return array_values(array_unique(array_filter($aliases)));
}

/**
 * Guess a paragraph bundle machine name from a label, if it exists.
 */
function paragraph_relevance_guess_existing_paragraph_bundle_from_label(string $label): string {
  $normalized = strtolower(trim($label));
  if ($normalized === '') {
    return '';
  }

  $normalized = preg_replace('/[^a-z0-9]+/', '_', $normalized) ?? '';
  $normalized = trim($normalized, '_');
  if ($normalized === '') {
    return '';
  }

  static $paragraph_bundles = NULL;
  if ($paragraph_bundles === NULL) {
    $paragraph_bundles = [];
    $ids = \Drupal::entityTypeManager()->getStorage('paragraphs_type')->getQuery()->accessCheck(FALSE)->execute();
    foreach (array_values($ids) as $id) {
      $paragraph_bundles[(string) $id] = TRUE;
      $paragraph_bundles[strtr((string) $id, ['-' => '_'])] = TRUE;
    }
  }

  return !empty($paragraph_bundles[$normalized]) ? $normalized : '';
}

/**
 * Collect term IDs from a field element's options/defaults.
 */
function paragraph_relevance_collect_term_ids_from_element(array $element): array {
  $ids = [];

  if (isset($element['#options']) && is_array($element['#options'])) {
    foreach (array_keys($element['#options']) as $key) {
      if (is_int($key) || (is_string($key) && ctype_digit($key))) {
        $ids[] = (int) $key;
      }
    }
  }

  if (isset($element['#default_value'])) {
    $default = $element['#default_value'];
    if (is_array($default)) {
      foreach ($default as $item) {
        if (is_object($item) && method_exists($item, 'id')) {
          $ids[] = (int) $item->id();
        }
        elseif (is_int($item) || (is_string($item) && ctype_digit($item))) {
          $ids[] = (int) $item;
        }
      }
    }
    elseif (is_object($default) && method_exists($default, 'id')) {
      $ids[] = (int) $default->id();
    }
    elseif (is_int($default) || (is_string($default) && ctype_digit($default))) {
      $ids[] = (int) $default;
    }
  }

  foreach ($element as $key => $child) {
    if (!is_string($key) || $key === '' || $key[0] === '#' || !is_array($child)) {
      continue;
    }
    $ids = array_merge($ids, paragraph_relevance_collect_term_ids_from_element($child));
  }

  $ids = array_values(array_unique($ids));

  return $ids;
}

/**
 * Extract a scalar value from a field widget value array.
 */
function paragraph_relevance_extract_value($value): ?string {
  if ($value === NULL) {
    return NULL;
  }

  if (is_scalar($value)) {
    return (string) $value;
  }

  if (is_array($value)) {
    if (array_key_exists('value', $value)) {
      return paragraph_relevance_extract_value($value['value']);
    }

    foreach ($value as $item) {
      $extracted = paragraph_relevance_extract_value($item);
      if ($extracted !== NULL) {
        return $extracted;
      }
    }

    return NULL;
  }

  return method_exists($value, '__toString') ? (string) $value : NULL;
}

/**
 * Get a reference to a nested form element by path.
 */
function &paragraph_relevance_form_get_ref(array &$form, array $path): array {
  $current = &$form;
  foreach ($path as $key) {
    if (!isset($current[$key]) || !is_array($current[$key])) {
      $current[$key] = [];
    }
    $current = &$current[$key];
  }

  return $current;
}
