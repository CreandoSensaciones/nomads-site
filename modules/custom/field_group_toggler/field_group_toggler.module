<?php

/**
 * @file
 * Field Group Toggler module.
 */

/**
 * Implements hook_field_group_formatter_info_alter().
 */
function field_group_toggler_field_group_formatter_info_alter(array &$info): void {
  if (isset($info['toggle'])) {
    $info['toggle']['label'] = t('Field Group Toggler');
    $info['toggle']['category'] = t('Nomads Forms');
  }
}
