<?php

/**
 * @file
 * Listing Details Handling module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\Core\Cache\RefinableCacheableDependencyInterface;
use Drupal\node\Entity\Node;
use Drupal\node\NodeInterface;
use Drupal\node\NodeForm;
use Symfony\Component\HttpFoundation\RedirectResponse;

/**
 * Implements hook_form_FORM_ID_alter() for listing add/edit forms.
 */
function listing_details_handling_form_node_listing_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $entity = $form_state->getFormObject()->getEntity();
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'listing') {
    return;
  }

  $form_state->set('listing_details_is_new', $entity->isNew());
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Save raw listing');
    if (!isset($form['actions']['add_details'])) {
      $form['actions']['add_details'] = $form['actions']['submit'];
      $form['actions']['add_details']['#value'] = t('Add details');
      $form['actions']['add_details']['#name'] = 'add_details';
      $form['actions']['add_details']['#weight'] = ($form['actions']['submit']['#weight'] ?? 0) + 1;
      if (!isset($form['actions']['add_details']['#submit']) || !is_array($form['actions']['add_details']['#submit'])) {
        $form['actions']['add_details']['#submit'] = [];
      }
      listing_details_handling_insert_submit_handler($form['actions']['add_details']['#submit'], 'listing_details_handling_listing_submit');
    }
  }
  if (!isset($form['#after_build']) || !is_array($form['#after_build'])) {
    $form['#after_build'] = [];
  }
  $form['#after_build'][] = 'listing_details_handling_after_build_listing';
}

/**
 * Implements hook_form_FORM_ID_alter() for details add/edit forms.
 */
function listing_details_handling_form_node_details_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $entity = $form_state->getFormObject()->getEntity();
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'details') {
    return;
  }

  $listing_id = (int) \Drupal::request()->query->get('listing_ref');
  if ($listing_id && isset($form['field_listing_ref'][0]['target_id'])) {
    $field_element = &$form['field_listing_ref'][0]['target_id'];
    $current_default = $field_element['#default_value'] ?? NULL;
    if (!$current_default) {
      $listing = \Drupal\node\Entity\Node::load($listing_id);
      if ($listing) {
        $field_element['#default_value'] = $listing;
      }
    }
  }

  if (!isset($form['#after_build']) || !is_array($form['#after_build'])) {
    $form['#after_build'] = [];
  }
  $form['#after_build'][] = 'listing_details_handling_after_build_details';
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
function listing_details_handling_menu_local_tasks_alter(&$data, $route_name, RefinableCacheableDependencyInterface &$cacheability): void {
  if (!isset($data['tabs'][0]) || !is_array($data['tabs'][0])) {
    return;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if (is_numeric($node)) {
    $node = Node::load((int) $node);
  }
  if (!$node instanceof NodeInterface) {
    return;
  }

  $cacheability->addCacheableDependency($node);

  if ($node->bundle() === 'listing') {
    $edit_weight = 0;
    foreach ($data['tabs'][0] as $key => &$tab_data) {
      if (!isset($tab_data['#link']['url'])) {
        continue;
      }
      $url = $tab_data['#link']['url'];
      if ($url->getRouteName() === 'entity.node.edit_form') {
        $tab_data['#link']['title'] = t('Edit listing');
        $edit_weight = $tab_data['#weight'] ?? 0;
      }
    }
    unset($tab_data);

    if (!$node->hasField('field_listing_ref')) {
      return;
    }

    $details_id = NULL;
    if (!$node->get('field_listing_ref')->isEmpty()) {
      $details_id = (int) $node->get('field_listing_ref')->target_id;
    }

    $title = $details_id ? t('Edit details') : t('Add details');
    $url = $details_id
      ? Url::fromRoute('entity.node.edit_form', ['node' => $details_id])
      : Url::fromRoute('listing_details_handling.details_action', ['node' => $node->id()]);

    $data['tabs'][0]['listing_details_handling.details'] = [
      '#theme' => 'menu_local_task',
      '#link' => [
        'title' => $title,
        'url' => $url,
      ],
      '#weight' => $edit_weight + 1,
    ];
    return;
  }

  if ($node->bundle() !== 'details' || !$node->hasField('field_listing_ref') || $node->get('field_listing_ref')->isEmpty()) {
    return;
  }

  $listing_id = (int) $node->get('field_listing_ref')->target_id;
  if (!$listing_id) {
    return;
  }

  $listing = Node::load($listing_id);
  if (!$listing instanceof NodeInterface) {
    return;
  }

  $cacheability->addCacheableDependency($listing);

  $edit_weight = 0;
  $view_weight = 0;
  foreach ($data['tabs'][0] as $key => &$tab_data) {
    if (!isset($tab_data['#link']['url'])) {
      continue;
    }
    $url = $tab_data['#link']['url'];
    if ($url->getRouteName() === 'entity.node.edit_form') {
      $tab_data['#link']['title'] = t('Edit details');
      $edit_weight = $tab_data['#weight'] ?? 0;
    }
    if ($url->getRouteName() === 'entity.node.canonical') {
      $tab_data['#link']['title'] = t('View listing');
      $tab_data['#link']['url'] = Url::fromRoute('entity.node.canonical', ['node' => $listing_id]);
      $view_weight = $tab_data['#weight'] ?? 0;
    }
  }
  unset($tab_data);

  $data['tabs'][0]['listing_details_handling.edit_listing'] = [
    '#theme' => 'menu_local_task',
    '#link' => [
      'title' => t('Edit listing'),
      'url' => Url::fromRoute('entity.node.edit_form', ['node' => $listing_id]),
    ],
    '#weight' => $edit_weight - 1,
  ];
}

/**
 * Implements hook_entity_insert().
 */
function listing_details_handling_entity_insert(\Drupal\Core\Entity\EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  if ($entity->bundle() === 'details') {
    if (!$entity->hasField('field_listing_ref') || $entity->get('field_listing_ref')->isEmpty()) {
      return;
    }

    $listing_id = (int) $entity->get('field_listing_ref')->target_id;
    if (!$listing_id) {
      return;
    }

    $listing = \Drupal\node\Entity\Node::load($listing_id);
    if (!$listing || !$listing->hasField('field_listing_ref')) {
      return;
    }

    $listing->set('field_listing_ref', $entity->id());
    $listing->save();
    return;
  }

  if ($entity->bundle() !== 'listing') {
    return;
  }

  if (!listing_details_handling_request_wants_details()) {
    return;
  }

  if (!$entity->hasField('field_listing_ref') || !$entity->get('field_listing_ref')->isEmpty()) {
    return;
  }

  static $inserting = FALSE;
  if ($inserting) {
    return;
  }

  $details_id = listing_details_handling_create_details_for_listing($entity);
  if ($details_id) {
    $inserting = TRUE;
    $entity->set('field_listing_ref', $details_id);
    $entity->save();
    $inserting = FALSE;
  }
}

/**
 * Implements hook_entity_update().
 */
function listing_details_handling_entity_update(\Drupal\Core\Entity\EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'listing') {
    return;
  }

  static $updating = FALSE;
  if ($updating) {
    return;
  }

  if (listing_details_handling_request_wants_details() && $entity->hasField('field_listing_ref') && $entity->get('field_listing_ref')->isEmpty()) {
    $details_id = listing_details_handling_find_details_for_listing((int) $entity->id());
    if (!$details_id) {
      $details_id = listing_details_handling_create_details_for_listing($entity);
    }
    if ($details_id) {
      $updating = TRUE;
      $entity->set('field_listing_ref', $details_id);
      $entity->save();
      $updating = FALSE;
    }
  }

  if (!$entity->hasField('field_listing_ref') || $entity->get('field_listing_ref')->isEmpty()) {
    return;
  }

  $details_id = (int) $entity->get('field_listing_ref')->target_id;
  if (!$details_id) {
    return;
  }

  $details = \Drupal\node\Entity\Node::load($details_id);
  if (!$details || $details->bundle() !== 'details') {
    return;
  }

  $expected_title = $entity->label() . ' - details';
  if ($details->label() !== $expected_title) {
    $details->setTitle($expected_title);
  }

  if ($details->hasField('field_types') && $entity->hasField('field_types')) {
    $field_types = listing_details_handling_expand_field_types($entity);
    $details->set('field_types', $field_types);
  }

  $details->save();
}

/**
 * Check if the current request is attempting to add details.
 */
function listing_details_handling_request_wants_details(): bool {
  $request = \Drupal::request();
  if ($request->getMethod() !== 'POST') {
    return FALSE;
  }

  return $request->request->get('form_id') === 'node_listing_form'
    && $request->request->has('add_details');
}

/**
 * Submit handler for listing add/edit form.
 */
function listing_details_handling_listing_submit(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }

  if (!listing_details_handling_is_add_details_triggered($form_state)) {
    return;
  }

  $listing = $form_object->getEntity();
  if (!$listing instanceof NodeInterface || $listing->bundle() !== 'listing') {
    return;
  }

  $listing_id = (int) $listing->id();
  if (!$listing_id) {
    return;
  }

  $is_new = (bool) $form_state->get('listing_details_is_new');
  if ($is_new) {
    $url = Url::fromRoute('node.add', ['node_type' => 'details'], [
      'query' => [
        'listing_ref' => $listing_id,
      ],
    ]);
    listing_details_handling_force_redirect($form_state, $url);
    $form_state->set('nomads_listing_redirect_done', TRUE);
    return;
  }

  $details_id = listing_details_handling_get_details_id($listing_id, $listing);
  if ($details_id) {
    $url = Url::fromRoute('entity.node.edit_form', [
      'node' => $details_id,
    ]);
    listing_details_handling_force_redirect($form_state, $url);
    $form_state->set('nomads_listing_redirect_done', TRUE);
  }
}

/**
 * Submit handler for details add/edit form.
 */
function listing_details_handling_details_submit(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }

  $details = $form_object->getEntity();
  if (!$details instanceof NodeInterface || $details->bundle() !== 'details') {
    return;
  }

  $listing_id = (int) \Drupal::request()->query->get('listing_ref');
  if (!$listing_id && $details->hasField('field_listing_ref') && !$details->get('field_listing_ref')->isEmpty()) {
    $listing_id = (int) $details->get('field_listing_ref')->target_id;
  }

  if ($listing_id) {
    $url = Url::fromRoute('entity.node.canonical', [
      'node' => $listing_id,
    ]);
    listing_details_handling_force_redirect($form_state, $url);
    $form_state->set('nomads_listing_redirect_done', TRUE);
  }
}

/**
 * Implements hook_form_submit() for listing form.
 */
function listing_details_handling_form_node_listing_form_submit(array &$form, FormStateInterface $form_state): void {
  if ($form_state->get('nomads_listing_redirect_done')) {
    return;
  }
  listing_details_handling_listing_submit($form, $form_state);
}

/**
 * Determine if the add details button triggered submission.
 */
function listing_details_handling_is_add_details_triggered(FormStateInterface $form_state): bool {
  $trigger = $form_state->getTriggeringElement();
  $trigger_name = $trigger['#name'] ?? '';
  if ($trigger_name === 'add_details') {
    return TRUE;
  }

  $input = $form_state->getUserInput();
  return isset($input['add_details']);
}

/**
 * After-build callback for listing forms.
 */
function listing_details_handling_after_build_listing(array $form, FormStateInterface $form_state): array {
  if (!isset($form['#attributes']) || !is_array($form['#attributes'])) {
    $form['#attributes'] = [];
  }
  $form['#attributes']['data-nomads-listing-progress'] = '1';

  if (isset($form['actions']['add_details']) && is_array($form['actions']['add_details'])) {
    if (!isset($form['actions']['add_details']['#attributes']) || !is_array($form['actions']['add_details']['#attributes'])) {
      $form['actions']['add_details']['#attributes'] = [];
    }
    $form['actions']['add_details']['#attributes']['data-nomads-listing-progress-submit'] = '1';
    $form['actions']['add_details']['#executes_submit_callback'] = TRUE;
    $submit_handlers = [];
    if (isset($form['actions']['add_details']['#submit']) && is_array($form['actions']['add_details']['#submit'])) {
      $submit_handlers = $form['actions']['add_details']['#submit'];
    }
    elseif (isset($form['actions']['submit']['#submit']) && is_array($form['actions']['submit']['#submit'])) {
      $submit_handlers = $form['actions']['submit']['#submit'];
    }

    if (!in_array('::submitForm', $submit_handlers, TRUE)) {
      array_unshift($submit_handlers, '::submitForm');
    }
    $submit_handlers = array_values(array_filter($submit_handlers, static function ($handler) {
      return $handler !== 'listing_details_handling_listing_submit';
    }));
    $submit_handlers[] = 'listing_details_handling_listing_submit';
    $form['actions']['add_details']['#submit'] = $submit_handlers;
  }
  listing_details_handling_attach_submit_handler($form, $form_state, 'listing_details_handling_listing_submit');
  return $form;
}

/**
 * After-build callback for details forms.
 */
function listing_details_handling_after_build_details(array $form, FormStateInterface $form_state): array {
  listing_details_handling_attach_submit_handler($form, $form_state, 'listing_details_handling_details_submit');
  return $form;
}

/**
 * Attach a submit handler to the form and primary action buttons.
 */
function listing_details_handling_attach_submit_handler(array &$form, FormStateInterface $form_state, string $handler): void {
  if (!isset($form['actions']) || !is_array($form['actions'])) {
    return;
  }

  foreach ($form['actions'] as $key => &$action) {
    if (!is_array($action)) {
      continue;
    }
    $type = $action['#type'] ?? '';
    if ($type !== 'submit') {
      continue;
    }
    if (!isset($action['#submit']) || !is_array($action['#submit'])) {
      $action['#submit'] = [];
    }
    listing_details_handling_insert_submit_handler($action['#submit'], $handler);
  }

  if (!isset($form['#submit']) || !is_array($form['#submit'])) {
    $form['#submit'] = [];
  }
  if (!in_array($handler, $form['#submit'], TRUE)) {
    $form['#submit'][] = $handler;
  }
}

/**
 * Force a redirect response regardless of other handlers.
 */
function listing_details_handling_force_redirect(FormStateInterface $form_state, Url $url): void {
  \Drupal::request()->query->remove('destination');
  $form_state->setIgnoreDestination(TRUE);
  $form_state->setRedirectUrl($url);
  $form_state->setResponse(new RedirectResponse($url->setAbsolute()->toString()));
}

/**
 * Inserts a submit handler right after the core submit.
 */
function listing_details_handling_insert_submit_handler(array &$submit_handlers, string $handler): void {
  if (in_array($handler, $submit_handlers, TRUE)) {
    return;
  }

  foreach ($submit_handlers as $index => $callback) {
    if ($callback === '::submitForm') {
      array_splice($submit_handlers, $index + 1, 0, [$handler]);
      break;
    }
  }
  $submit_handlers[] = $handler;
}

/**
 * Resolve or create a details node for a listing.
 */
function listing_details_handling_get_details_id(int $listing_id, NodeInterface $listing): ?int {
  $details_id = NULL;

  if ($listing->hasField('field_listing_ref') && !$listing->get('field_listing_ref')->isEmpty()) {
    $details_id = (int) $listing->get('field_listing_ref')->target_id;
  }

  if (!$details_id) {
    $details_id = listing_details_handling_find_details_for_listing($listing_id);
    if ($details_id && $listing->hasField('field_listing_ref')) {
      $listing->set('field_listing_ref', $details_id);
      $listing->save();
    }
  }

  if (!$details_id) {
    $details_id = listing_details_handling_create_details_for_listing($listing);
    if ($details_id && $listing->hasField('field_listing_ref')) {
      $listing->set('field_listing_ref', $details_id);
      $listing->save();
    }
  }

  return $details_id;
}

/**
 * Find details node id that references the listing.
 */
function listing_details_handling_find_details_for_listing(int $listing_id): ?int {
  $query = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'details')
    ->condition('field_listing_ref', $listing_id)
    ->range(0, 1);

  $ids = $query->execute();
  if (!$ids) {
    return NULL;
  }

  return (int) reset($ids);
}

/**
 * Create a details node referencing the listing.
 */
function listing_details_handling_create_details_for_listing(NodeInterface $listing): ?int {
  $details = \Drupal\node\Entity\Node::create([
    'type' => 'details',
    'title' => $listing->label() . ' - details',
    'langcode' => $listing->language()->getId(),
    'field_listing_ref' => [
      ['target_id' => $listing->id()],
    ],
  ]);

  if ($details->hasField('field_types') && $listing->hasField('field_types')) {
    $field_types = listing_details_handling_expand_field_types($listing);
    if ($field_types) {
      $details->set('field_types', $field_types);
    }
  }

  try {
    $details->save();
  }
  catch (\Exception $e) {
    return NULL;
  }

  return $details->id() ? (int) $details->id() : NULL;
}

/**
 * Expand field_types with parent terms for details copy.
 */
function listing_details_handling_expand_field_types(NodeInterface $listing, int $max_depth = 2): array {
  if (!$listing->hasField('field_types') || $listing->get('field_types')->isEmpty()) {
    return [];
  }

  $term_ids = [];
  foreach ($listing->get('field_types') as $item) {
    if (!empty($item->target_id)) {
      $term_ids[] = (int) $item->target_id;
    }
  }
  if (!$term_ids) {
    return [];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $seen = [];
  $expanded = [];

  foreach ($term_ids as $term_id) {
    if (isset($seen[$term_id])) {
      continue;
    }
    $seen[$term_id] = TRUE;
    $expanded[] = ['target_id' => $term_id];

    $depth = 0;
    $current_id = $term_id;
    while ($depth < $max_depth) {
      $term = $storage->load($current_id);
      if (!$term || !$term->hasField('parent') || $term->get('parent')->isEmpty()) {
        break;
      }
      $parent_id = (int) $term->get('parent')->target_id;
      if (!$parent_id || isset($seen[$parent_id])) {
        break;
      }
      $seen[$parent_id] = TRUE;
      $expanded[] = ['target_id' => $parent_id];
      $current_id = $parent_id;
      $depth += 1;
    }
  }

  return $expanded;
}
