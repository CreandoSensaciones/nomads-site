<?php

/**
 * @file
 * Adds virtual fields for rendering Listing paragraphs filtered by relevance.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_entity_extra_field_info().
 */
function paragraph_relevance_vfields_entity_extra_field_info(): array {
  $t = \Drupal::translation();

  return [
    'node' => [
      'listing' => [
        'display' => [
          'key_aspects' => [
            'label' => $t->translate('Key aspects'),
            'description' => $t->translate('Lists Listing paragraphs grouped by relevance (3/2/1) using subsite key aspect ordering.'),
            'weight' => -1,
            'visible' => FALSE,
          ],
          'core_focus_paragraphs_3' => [
            'label' => $t->translate('Core Focus Paragraphs (3)'),
            'description' => $t->translate('Renders all Listing paragraphs whose field_relevance2 value is 3, using Paragraph view mode "3".'),
            'weight' => 0,
            'visible' => FALSE,
          ],
          'relevant_paragraphs_2' => [
            'label' => $t->translate('Relevant Paragraphs (2)'),
            'description' => $t->translate('Renders all Listing paragraphs whose field_relevance2 value is 2, using Paragraph view mode "2".'),
            'weight' => 1,
            'visible' => FALSE,
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_entity_view().
 */
function paragraph_relevance_vfields_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($entity->getEntityTypeId() !== 'node' || !method_exists($entity, 'bundle') || $entity->bundle() !== 'listing') {
    return;
  }

  if ($display->getComponent('key_aspects') !== NULL) {
    $build['key_aspects'] = paragraph_relevance_vfields_build_key_aspects($entity, $display);
  }

  if ($display->getComponent('core_focus_paragraphs_3') !== NULL) {
    $build['core_focus_paragraphs_3'] = paragraph_relevance_vfields_build($entity, 3);
  }

  if ($display->getComponent('relevant_paragraphs_2') !== NULL) {
    $build['relevant_paragraphs_2'] = paragraph_relevance_vfields_build($entity, 2);
  }
}

/**
 * Implements hook_entity_presave().
 */
function paragraph_relevance_vfields_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'node' || !method_exists($entity, 'bundle') || $entity->bundle() !== 'listing') {
    return;
  }

  \Drupal::logger('paragraph_relevance')->notice('PR DEBUG: presave listing nid=@nid', ['@nid' => $entity->id() ?? 'new']);

  $paragraphs = paragraph_relevance_vfields_collect_paragraphs($entity);
  \Drupal::logger('paragraph_relevance')->notice('PR DEBUG: found @n paragraphs', ['@n' => count($paragraphs)]);
  if (!$paragraphs) {
    return;
  }

  $max_by_bundle = [];
  foreach ($paragraphs as $paragraph) {
    $loaded = $paragraph->id()
      ? \Drupal::entityTypeManager()->getStorage('paragraph')->load($paragraph->id())
      : NULL;
    $src_entity = $loaded ?: $paragraph;
    $dst_entity = $paragraph;
    $src = $src_entity->hasField('field_relevance') ? $src_entity->get('field_relevance')->value : 'MISSING';
    $dst = $dst_entity->hasField('field_relevance2') ? $dst_entity->get('field_relevance2')->value : 'MISSING';
    \Drupal::logger('paragraph_relevance')->notice('PR DEBUG: p=@pid bundle=@b src=@src dst_before=@dst', [
      '@pid' => $src_entity->id() ?? 'new',
      '@b' => $src_entity->bundle(),
      '@src' => (string) $src,
      '@dst' => (string) $dst,
    ]);
    if (!$src_entity->hasField('field_relevance')) {
      continue;
    }
    $value = (int) ($src_entity->get('field_relevance')->value ?? 0);
    if ($dst_entity->hasField('field_relevance2')) {
      $dst_entity->set('field_relevance2', $value);
    }

    $bundle = (string) $dst_entity->bundle();
    if ($bundle === '') {
      continue;
    }
    $max_by_bundle[$bundle] = isset($max_by_bundle[$bundle])
      ? max($max_by_bundle[$bundle], $value)
      : $value;
  }

  foreach ($max_by_bundle as $bundle => $max_value) {
    $field_name = 'field_' . $bundle . '_relevance';
    if (!$entity->hasField($field_name)) {
      continue;
    }
    $entity->set($field_name, $max_value);
  }
}

/**
 * Build render array for relevance-filtered paragraphs.
 */
function paragraph_relevance_vfields_build(EntityInterface $listing, int $target_relevance): array {
  $cacheability = (new CacheableMetadata())
    ->addCacheableDependency($listing)
    ->addCacheContexts(['url.site']);

  $key_aspect_terms = paragraph_relevance_vfields_key_aspect_terms($cacheability);
  if (!$key_aspect_terms) {
    $build = ['#access' => FALSE];
    $cacheability->applyTo($build);
    return $build;
  }

  $sections = paragraph_relevance_vfields_collect_key_aspect_sections($listing, $key_aspect_terms, $target_relevance, $cacheability);
  if (!$sections) {
    $build = ['#access' => FALSE];
    $cacheability->applyTo($build);
    return $build;
  }

  /** @var \Drupal\Core\Entity\EntityTypeManagerInterface $etm */
  $etm = \Drupal::entityTypeManager();
  $paragraph_view_builder = $etm->getViewBuilder('paragraph');

  $wrapper_suffix = $target_relevance === 3 ? 'core' : 'relevant';
  $build = [
    '#type' => 'container',
    '#attributes' => [
      'class' => [
        'paragraph-relevance-vfield',
        'paragraph-relevance-vfield--' . $wrapper_suffix,
      ],
    ],
  ];

  foreach ($sections as $delta => $section) {
    $term = $section['term'];
    $bundle = $section['bundle'];
    $view_mode = paragraph_relevance_vfields_paragraph_view_mode($bundle, (string) $target_relevance);

    $section_build = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'paragraph-relevance-vfield__section',
          'paragraph-relevance-vfield__section--term-' . $term->id(),
          'paragraph-relevance-vfield__section--bundle-' . Html::getClass($bundle),
        ],
        'data-key-aspect' => $term->label(),
      ],
      'items' => [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['paragraph-relevance-vfield__items'],
        ],
      ],
    ];

    foreach ($section['paragraphs'] as $paragraph_delta => $paragraph) {
      $section_build['items'][$paragraph_delta] = $paragraph_view_builder->view($paragraph, $view_mode);
    }

    $build[$delta] = $section_build;
  }

  $cacheability->applyTo($build);
  return $build;
}

/**
 * Load ordered key aspect terms for the current hostname.
 */
function paragraph_relevance_vfields_key_aspect_terms(CacheableMetadata $cacheability): array {
  // Replaces the old form-display ordering with subsites -> key aspects ordering.
  $subsite = paragraph_relevance_vfields_load_subsite_term($cacheability);
  if (!$subsite || !$subsite->hasField('field_key_aspects') || $subsite->get('field_key_aspects')->isEmpty()) {
    return [];
  }

  $terms = $subsite->get('field_key_aspects')->referencedEntities();
  foreach ($terms as $term) {
    if ($term instanceof TermInterface) {
      $cacheability->addCacheableDependency($term);
    }
  }

  return $terms;
}

/**
 * Load the subsite term for the current hostname (or default).
 */
function paragraph_relevance_vfields_load_subsite_term(CacheableMetadata $cacheability): ?TermInterface {
  $hostname = paragraph_relevance_vfields_get_hostname();
  if ($hostname === '') {
    $hostname = 'default';
  }

  /** @var \Drupal\taxonomy\TermStorageInterface $storage */
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $query = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'subsites')
    ->condition('field_hostname', $hostname)
    ->range(0, 1);
  $ids = $query->execute();
  $term = $ids ? $storage->load(reset($ids)) : NULL;

  if (!$term && $hostname !== 'default') {
    $query = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', 'subsites')
      ->condition('field_hostname', 'default')
      ->range(0, 1);
    $ids = $query->execute();
    $term = $ids ? $storage->load(reset($ids)) : NULL;
  }

  if ($term instanceof TermInterface) {
    $cacheability->addCacheableDependency($term);
    return $term;
  }

  return NULL;
}

/**
 * Get the current request hostname normalized for lookup.
 */
function paragraph_relevance_vfields_get_hostname(): string {
  $request = \Drupal::requestStack()->getCurrentRequest();
  $hostname = $request ? (string) $request->getHost() : '';
  $hostname = strtolower($hostname);
  if ($hostname === '') {
    return '';
  }
  $parts = explode(':', $hostname);
  return $parts[0];
}

/**
 * Collect paragraphs from all paragraph reference fields on the listing.
 *
 * @return \Drupal\paragraphs\ParagraphInterface[]
 *   Paragraph entities in stable field order.
 */
function paragraph_relevance_vfields_collect_paragraphs(EntityInterface $listing, ?CacheableMetadata $cacheability = NULL): array {
  $paragraphs = [];
  if (!method_exists($listing, 'getFieldDefinitions')) {
    return $paragraphs;
  }

  foreach ($listing->getFieldDefinitions() as $field_name => $definition) {
    if ($definition->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($definition->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    if (!$listing->hasField($field_name)) {
      continue;
    }

    $field = $listing->get($field_name);
    if ($field->isEmpty()) {
      continue;
    }

    foreach ($field->referencedEntities() as $paragraph) {
      if (!$paragraph instanceof ParagraphInterface) {
        continue;
      }
      $paragraphs[] = $paragraph;
      if ($cacheability) {
        $cacheability->addCacheableDependency($paragraph);
      }
    }
  }

  return $paragraphs;
}

/**
 * Group paragraphs by bundle.
 *
 * @param \Drupal\paragraphs\ParagraphInterface[] $paragraphs
 *   Paragraph entities to group.
 *
 * @return array
 *   Paragraphs keyed by bundle.
 */
function paragraph_relevance_vfields_group_paragraphs_by_bundle(array $paragraphs): array {
  $grouped = [];
  foreach ($paragraphs as $paragraph) {
    $bundle = (string) $paragraph->bundle();
    if ($bundle === '') {
      continue;
    }
    $grouped[$bundle][] = $paragraph;
  }
  return $grouped;
}

/**
 * Collect ordered sections of paragraphs for the given key aspect terms.
 */
function paragraph_relevance_vfields_collect_key_aspect_sections(EntityInterface $listing, array $key_aspect_terms, int $target_relevance, CacheableMetadata $cacheability): array {
  $paragraphs = paragraph_relevance_vfields_collect_paragraphs($listing, $cacheability);
  $all_paragraphs_by_bundle = paragraph_relevance_vfields_group_paragraphs_by_bundle($paragraphs);
  $paragraphs_by_bundle = [];
  $seen = [];

  foreach ($paragraphs as $paragraph) {
    $bundle = (string) $paragraph->bundle();
    if ($bundle === '') {
      continue;
    }
    if (!$paragraph->hasField('field_relevance2')) {
      continue;
    }
    $relevance_value = (int) ($paragraph->get('field_relevance2')->value ?? 0);
    if ($relevance_value !== $target_relevance) {
      continue;
    }
    $id = $paragraph->id();
    if ($id !== NULL && isset($seen[$bundle][$id])) {
      continue;
    }
    if ($id !== NULL) {
      $seen[$bundle][$id] = TRUE;
    }
    $paragraphs_by_bundle[$bundle][] = $paragraph;
  }

  $sections = [];
  foreach ($key_aspect_terms as $term) {
    if (!$term instanceof TermInterface) {
      continue;
    }
    $bundle = trim((string) ($term->get('field_paragraph_bundle')->value ?? ''));
    if ($bundle === '' || empty($paragraphs_by_bundle[$bundle])) {
      continue;
    }
    $sections[] = [
      'term' => $term,
      'bundle' => $bundle,
      'paragraphs' => $paragraphs_by_bundle[$bundle],
    ];
  }

  return $sections;
}

/**
 * Determine the paragraph view mode with a safe fallback.
 */
function paragraph_relevance_vfields_paragraph_view_mode(string $bundle, string $view_mode): string {
  static $resolved = [];
  $cache_key = $bundle . ':' . $view_mode;
  if (isset($resolved[$cache_key])) {
    return $resolved[$cache_key];
  }

  /** @var \Drupal\Core\Entity\EntityStorageInterface $storage */
  $storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');
  $display = $storage->load('paragraph.' . $bundle . '.' . $view_mode);
  $resolved[$cache_key] = $display ? $view_mode : 'default';

  return $resolved[$cache_key];
}

/**
 * Alter the node listing display form to store key aspect settings.
 */
function paragraph_relevance_vfields_form_entity_view_display_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  $display = $form_object && method_exists($form_object, 'getEntity')
    ? $form_object->getEntity()
    : NULL;
  if (!$display instanceof EntityViewDisplayInterface) {
    return;
  }
  if ($display->getTargetEntityTypeId() !== 'node' || $display->getTargetBundle() !== 'listing') {
    return;
  }

  if (!isset($form['fields']['key_aspects']) || !is_array($form['fields']['key_aspects'])) {
    return;
  }

  $defaults = paragraph_relevance_vfields_key_aspects_default_settings();
  $settings = paragraph_relevance_vfields_key_aspects_settings($display);
  $options = paragraph_relevance_vfields_key_aspects_output_options();

  $base_button = [
    '#submit' => ['paragraph_relevance_vfields_key_aspects_settings_update_submit', '::multistepSubmit'],
    '#ajax' => [
      'callback' => '::multistepAjax',
      'wrapper' => 'field-display-overview-wrapper',
      'effect' => 'fade',
    ],
    '#field_name' => 'key_aspects',
  ];

  if ($form_state->get('plugin_settings_edit') === 'key_aspects') {
    $form['fields']['key_aspects']['plugin']['#cell_attributes'] = ['colspan' => 3];
    $form['fields']['key_aspects']['plugin']['settings_edit_form'] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['field-plugin-settings-edit-form']],
      '#parents' => ['fields', 'key_aspects', 'settings_edit_form'],
      'label' => [
        '#markup' => t('Plugin settings'),
      ],
      'settings' => [
        '#type' => 'details',
        '#title' => t('Default formatter settings'),
        '#open' => TRUE,
      ],
    ];

    foreach (paragraph_relevance_vfields_key_aspects_groups() as $group) {
      $key = $group['key'];
      $form['fields']['key_aspects']['plugin']['settings_edit_form']['settings']['key_aspects'][$key] = [
        '#type' => 'details',
        '#title' => $group['label'],
        '#open' => TRUE,
        '#tree' => TRUE,
        '#parents' => ['fields', 'key_aspects', 'settings_edit_form', 'settings', 'key_aspects', $key],
      ];
      $form['fields']['key_aspects']['plugin']['settings_edit_form']['settings']['key_aspects'][$key]['label'] = [
        '#type' => 'textfield',
        '#title' => t('Label'),
        '#default_value' => (string) ($settings[$key]['label'] ?? $defaults[$key]['label']),
      ];
      $form['fields']['key_aspects']['plugin']['settings_edit_form']['settings']['key_aspects'][$key]['output'] = [
        '#type' => 'select',
        '#title' => t('Output'),
        '#options' => $options,
        '#default_value' => (string) ($settings[$key]['output'] ?? $defaults[$key]['output']),
      ];
      $form['fields']['key_aspects']['plugin']['settings_edit_form']['settings']['key_aspects'][$key]['anchor'] = [
        '#type' => 'checkbox',
        '#title' => t('Anchor Link'),
        '#default_value' => (bool) ($settings[$key]['anchor'] ?? $defaults[$key]['anchor']),
      ];
    }

    $form['fields']['key_aspects']['plugin']['settings_edit_form']['actions'] = [
      '#type' => 'actions',
      'save_settings' => $base_button + [
        '#type' => 'submit',
        '#button_type' => 'primary',
        '#name' => 'key_aspects_plugin_settings_update',
        '#value' => t('Update'),
        '#op' => 'update',
      ],
      'cancel_settings' => $base_button + [
        '#type' => 'submit',
        '#name' => 'key_aspects_plugin_settings_cancel',
        '#value' => t('Cancel'),
        '#op' => 'cancel',
        '#submit' => ['::multistepSubmit'],
        '#limit_validation_errors' => [['fields', 'key_aspects', 'type']],
      ],
    ];

    $form['fields']['key_aspects']['#attributes']['class'][] = 'field-plugin-settings-editing';
  }
  else {
    $summary = paragraph_relevance_vfields_key_aspects_settings_summary($settings, $options);
    if (!empty($summary)) {
      $form['fields']['key_aspects']['settings_summary'] = [
        '#type' => 'inline_template',
        '#template' => '<div class="field-plugin-summary">{{ summary|safe_join("<br />") }}</div>',
        '#context' => ['summary' => $summary],
        '#cell_attributes' => ['class' => ['field-plugin-summary-cell']],
      ];
    }
    $form['fields']['key_aspects']['settings_edit'] = $base_button + [
      '#type' => 'image_button',
      '#name' => 'key_aspects_settings_edit',
      '#src' => 'core/misc/icons/787878/cog.svg',
      '#attributes' => ['class' => ['field-plugin-settings-edit'], 'alt' => t('Edit')],
      '#op' => 'edit',
      '#limit_validation_errors' => [['fields', 'key_aspects', 'type']],
      '#prefix' => '<div class="field-plugin-settings-edit-wrapper">',
      '#suffix' => '</div>',
    ];
  }

  if (!isset($form['#submit']) || !is_array($form['#submit'])) {
    $form['#submit'] = [];
  }
  if (!in_array('paragraph_relevance_vfields_key_aspects_settings_update_submit', $form['#submit'], TRUE)) {
    array_unshift($form['#submit'], 'paragraph_relevance_vfields_key_aspects_settings_update_submit');
  }
}

/**
 * Submit handler to store key aspects settings.
 */
function paragraph_relevance_vfields_key_aspects_settings_update_submit(array &$form, FormStateInterface $form_state): void {
  $trigger = $form_state->getTriggeringElement();
  if (is_array($trigger) && ($trigger['#op'] ?? '') === 'cancel') {
    return;
  }

  $form_object = $form_state->getFormObject();
  $display = $form_object && method_exists($form_object, 'getEntity')
    ? $form_object->getEntity()
    : NULL;
  if (!$display instanceof EntityViewDisplayInterface) {
    return;
  }
  if ($display->getTargetEntityTypeId() !== 'node' || $display->getTargetBundle() !== 'listing') {
    return;
  }

  paragraph_relevance_vfields_apply_key_aspects_settings($display, $form_state);
}

/**
 * Build render array for key aspects grouped by relevance.
 */
function paragraph_relevance_vfields_build_key_aspects(EntityInterface $listing, EntityViewDisplayInterface $display): array {
  $cacheability = (new CacheableMetadata())
    ->addCacheableDependency($listing)
    ->addCacheContexts(['url.site']);

  $key_aspect_terms = paragraph_relevance_vfields_key_aspect_terms($cacheability);
  if (!$key_aspect_terms) {
    $build = ['#access' => FALSE];
    $cacheability->applyTo($build);
    return $build;
  }

  $settings = paragraph_relevance_vfields_key_aspects_settings($display);
  $groups = paragraph_relevance_vfields_key_aspects_groups();

  $group_items = [];
  foreach ($groups as $group) {
    $group_items[$group['key']] = [];
  }

  $paragraphs = paragraph_relevance_vfields_collect_paragraphs($listing, $cacheability);
  $paragraphs_by_bundle = paragraph_relevance_vfields_group_paragraphs_by_bundle($paragraphs);

  foreach ($key_aspect_terms as $term) {
    $bundle = trim((string) ($term->get('field_paragraph_bundle')->value ?? ''));
    if ($bundle === '' || empty($paragraphs_by_bundle[$bundle])) {
      continue;
    }

    foreach ($paragraphs_by_bundle[$bundle] as $paragraph) {
      if (paragraph_relevance_vfields_is_ignored_paragraph($paragraph)) {
        continue;
      }
      if (!$paragraph->hasField('field_relevance2')) {
        continue;
      }
      $relevance_value = (int) ($paragraph->get('field_relevance2')->value ?? 0);
      if (!isset($groups[$relevance_value])) {
        continue;
      }

      $group_key = $groups[$relevance_value]['key'];
      $output = (string) ($settings[$group_key]['output'] ?? 'icon');
      $anchor = (bool) ($settings[$group_key]['anchor'] ?? FALSE);
      if ($output === 'none') {
        continue;
      }

      $item = paragraph_relevance_vfields_build_key_aspect_item($paragraph, $output, $anchor, $cacheability);
      if ($item) {
        $group_items[$group_key][] = $item;
      }
    }
  }

  $build = [
    '#type' => 'container',
    '#attributes' => [
      'class' => [
        'nomads-icon-formatter',
        'nomads-icon-formatter--paragraph-relevance',
        'paragraph-relevance-key-aspects',
      ],
    ],
    '#attached' => [
      'library' => [
        'paragraph_relevance_vfields/key_aspects',
      ],
    ],
  ];

  $has_output = FALSE;
  foreach ($groups as $group) {
    $key = $group['key'];
    $output = (string) ($settings[$key]['output'] ?? 'icon');
    $anchor = (bool) ($settings[$key]['anchor'] ?? FALSE);
    if ($output === 'none') {
      continue;
    }
    if (empty($group_items[$key])) {
      continue;
    }

    $label = (string) ($settings[$key]['label'] ?? $group['label']);
    $group_build = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'paragraph-relevance-key-aspects__group',
          'paragraph-relevance-key-aspects__group--' . $key,
        ],
      ],
    ];

    if ($label !== '') {
      $group_build['label'] = [
        '#type' => 'html_tag',
        '#tag' => 'h3',
        '#value' => $label,
        '#attributes' => [
          'class' => [
            'nomads-icon-formatter__title',
            'paragraph-relevance-key-aspects__label',
          ],
        ],
      ];
    }

    $items_classes = [
      'paragraph-relevance-key-aspects__items',
    ];
    if ($output === 'pill') {
      $items_classes[] = 'nomads-pills';
      $items_classes[] = 'nomads-pills--paragraph-relevance';
    }
    $group_build['items'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => $items_classes,
      ],
    ];
    foreach ($group_items[$key] as $delta => $item) {
      $group_build['items'][$delta] = [
        '#type' => 'container',
        '#attributes' => [
          'class' => [
            'paragraph-relevance-key-aspects__item',
            'nomads-icon-formatter__item',
          ],
        ],
        'content' => $item,
      ];
    }

    $build[$key] = $group_build;
    $has_output = TRUE;
  }

  if (!$has_output) {
    $build = ['#access' => FALSE];
    $cacheability->applyTo($build);
    return $build;
  }

  $cacheability->applyTo($build);
  return $build;
}

/**
 * Build a render array for a single key aspect item.
 */
function paragraph_relevance_vfields_build_key_aspect_item(ParagraphInterface $paragraph, string $output, bool $anchor, CacheableMetadata $cacheability): array {
  $cacheability->addCacheableDependency($paragraph);
  $paragraph_type = $paragraph->getParagraphType();
  if ($paragraph_type) {
    $cacheability->addCacheableDependency($paragraph_type);
  }

  $label = $paragraph_type ? (string) $paragraph_type->label() : (string) $paragraph->bundle();
  $icon_url = '';
  if ($paragraph_type && method_exists($paragraph_type, 'getIconFile')) {
    $icon = $paragraph_type->getIconFile();
    if ($icon) {
      $cacheability->addCacheableDependency($icon);
      $icon_url = \Drupal::service('file_url_generator')->generateString($icon->getFileUri());
    }
  }

  if ($output === 'icon' && $icon_url !== '') {
    $item = [
      '#type' => 'inline_template',
      '#template' => '<span class="paragraph-relevance-key-aspect paragraph-relevance-key-aspect--icon"><span class="paragraph-relevance-key-aspect__icon nomads-icon-formatter__icon"><img src="{{ url }}" alt="" aria-hidden="true" /></span><span class="paragraph-relevance-key-aspect__label nomads-icon-formatter__label">{{ label }}</span></span>',
      '#context' => [
        'url' => $icon_url,
        'label' => $label,
      ],
    ];
    return paragraph_relevance_vfields_wrap_anchor($item, $paragraph, $anchor);
  }

  if ($output === 'pill') {
    $item = [
      '#type' => 'inline_template',
      '#template' => '<span class="paragraph-relevance-key-aspect paragraph-relevance-key-aspect--pill nomads-pill nomads-pill__label">{{ label }}</span>',
      '#context' => [
        'label' => $label,
      ],
    ];
    return paragraph_relevance_vfields_wrap_anchor($item, $paragraph, $anchor);
  }

  $item = [
    '#type' => 'inline_template',
    '#template' => '<span class="paragraph-relevance-key-aspect paragraph-relevance-key-aspect--label nomads-icon-formatter__label">{{ label }}</span>',
    '#context' => [
      'label' => $label,
    ],
  ];
  return paragraph_relevance_vfields_wrap_anchor($item, $paragraph, $anchor);
}

/**
 * Get key aspect group configuration definitions.
 */
function paragraph_relevance_vfields_key_aspects_groups(): array {
  return [
    3 => [
      'key' => 'core_focus',
      'label' => t('Core focus'),
    ],
    2 => [
      'key' => 'important_aspect',
      'label' => t('Important Aspect'),
    ],
    1 => [
      'key' => 'minor_relevance',
      'label' => t('Minor relevance'),
    ],
  ];
}

/**
 * Default key aspects settings.
 */
function paragraph_relevance_vfields_key_aspects_default_settings(): array {
  return [
    'core_focus' => [
      'output' => 'icon',
      'label' => 'Core focus',
      'anchor' => FALSE,
    ],
    'important_aspect' => [
      'output' => 'icon',
      'label' => 'Important Aspect',
      'anchor' => FALSE,
    ],
    'minor_relevance' => [
      'output' => 'icon',
      'label' => 'Minor relevance',
      'anchor' => FALSE,
    ],
  ];
}

/**
 * Load key aspects settings from the display.
 */
function paragraph_relevance_vfields_key_aspects_settings(EntityViewDisplayInterface $display): array {
  $defaults = paragraph_relevance_vfields_key_aspects_default_settings();
  $settings = $display->getThirdPartySetting('paragraph_relevance_vfields', 'key_aspects', []);
  if (!is_array($settings)) {
    $settings = [];
  }
  return array_replace_recursive($defaults, $settings);
}

/**
 * Output option labels for the key aspects formatter.
 */
function paragraph_relevance_vfields_key_aspects_output_options(): array {
  return [
    'icon' => t('Icon'),
    'pill' => t('Pill'),
    'label' => t('Label'),
    'none' => t('None'),
  ];
}

/**
 * Build a settings summary for the key aspects formatter.
 */
function paragraph_relevance_vfields_key_aspects_settings_summary(array $settings, array $options): array {
  $summary = [];
  $defaults = paragraph_relevance_vfields_key_aspects_default_settings();
  foreach (paragraph_relevance_vfields_key_aspects_groups() as $group) {
    $key = $group['key'];
    $label = (string) ($settings[$key]['label'] ?? $defaults[$key]['label']);
    $output_key = (string) ($settings[$key]['output'] ?? $defaults[$key]['output']);
    $output_label = (string) ($options[$output_key] ?? $output_key);
    $anchor = !empty($settings[$key]['anchor']) ? t('with anchor') : t('no anchor');
    $summary[] = t('@group: @output (@label)', [
      '@group' => $group['label'],
      '@output' => $output_label . ' / ' . $anchor,
      '@label' => $label,
    ]);
  }
  return $summary;
}

/**
 * Apply key aspects settings to the display from form state.
 */
function paragraph_relevance_vfields_apply_key_aspects_settings(EntityViewDisplayInterface $display, FormStateInterface $form_state): void {
  $values = $form_state->getValue(['fields', 'key_aspects', 'settings_edit_form', 'settings', 'key_aspects']);
  if (!is_array($values)) {
    return;
  }

  $defaults = paragraph_relevance_vfields_key_aspects_default_settings();
  $options = paragraph_relevance_vfields_key_aspects_output_options();
  $normalized = [];

  foreach ($defaults as $key => $default) {
    $group_values = $values[$key] ?? [];
    $label = isset($group_values['label']) ? trim((string) $group_values['label']) : $default['label'];
    $output = isset($group_values['output']) ? (string) $group_values['output'] : $default['output'];
    $anchor = isset($group_values['anchor']) ? (bool) $group_values['anchor'] : (bool) $default['anchor'];
    if (!isset($options[$output])) {
      $output = $default['output'];
    }
    $normalized[$key] = [
      'label' => $label,
      'output' => $output,
      'anchor' => $anchor,
    ];
  }

  $display->setThirdPartySetting('paragraph_relevance_vfields', 'key_aspects', $normalized);
}

/**
 * Wrap a key aspect item in an anchor link when enabled.
 */
function paragraph_relevance_vfields_wrap_anchor(array $item, ParagraphInterface $paragraph, bool $anchor): array {
  if (!$anchor) {
    return $item;
  }

  $bundle = (string) $paragraph->bundle();
  if ($bundle === '') {
    return $item;
  }

  return [
    '#type' => 'link',
    '#title' => $item,
    '#url' => Url::fromUri('internal:#' . $bundle),
    '#attributes' => [
      'class' => ['paragraph-relevance-key-aspect__link', 'nomads-pill__link'],
    ],
  ];
}

/**
 * Determine whether a paragraph should be ignored for key aspects output.
 */
function paragraph_relevance_vfields_is_ignored_paragraph(ParagraphInterface $paragraph): bool {
  $bundle = (string) $paragraph->bundle();
  if ($bundle === '') {
    return FALSE;
  }
  return in_array($bundle, paragraph_relevance_vfields_ignored_paragraph_bundles(), TRUE);
}

/**
 * Paragraph bundles to ignore in key aspects output.
 */
function paragraph_relevance_vfields_ignored_paragraph_bundles(): array {
  return [
    'reference',
    'paragraph_type_reference',
  ];
}
