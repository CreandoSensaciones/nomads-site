<?php

/**
 * @file
 * Compatibility wrapper for the consolidated listing virtual fields module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_entity_extra_field_info().
 */
function location_virtual_field_entity_extra_field_info(): array {
  if (\Drupal::moduleHandler()->moduleExists('nomads_listing_virtual_fields')) {
    return [];
  }

  return [
    'node' => [
      'listing' => [
        'display' => [
          'location_vfield' => [
            'label' => t('Location vfield'),
            'description' => t('Renders countries from location paragraphs with special handling for mixed countries.'),
            'weight' => 0,
            'visible' => FALSE,
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_entity_view().
 */
function location_virtual_field_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if (\Drupal::moduleHandler()->moduleExists('nomads_listing_virtual_fields')) {
    return;
  }

  if ($entity->getEntityTypeId() !== 'node' || !method_exists($entity, 'bundle') || $entity->bundle() !== 'listing') {
    return;
  }

  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('node', 'listing', $view_mode);
  $component = $view_display->getComponent('location_vfield');
  if (empty($component) || ($component['region'] ?? 'hidden') === 'hidden') {
    return;
  }

  /** @var \Drupal\location_virtual_field\LocationExtraFieldBuilder $builder */
  $builder = \Drupal::service('location_virtual_field.builder');
  $render_array = $builder->build($entity, $view_display, $entity->language()->getId());
  if (empty($render_array)) {
    return;
  }

  $render_array['#weight'] = $component['weight'] ?? 0;
  $render_array['#region'] = $component['region'] ?? 'content';
  $build['location_vfield'] = $render_array;
}

/**
 * Implements hook_theme().
 */
function location_virtual_field_theme(): array {
  if (\Drupal::moduleHandler()->moduleExists('nomads_listing_virtual_fields')) {
    return [];
  }

  return [
    'location_virtual_field' => [
      'template' => 'location-virtual-field',
      'variables' => [
        'label' => NULL,
        'label_display' => 'hidden',
        'wrapper_classes' => [],
        'content' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function location_virtual_field_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (\Drupal::moduleHandler()->moduleExists('nomads_listing_virtual_fields')) {
    return;
  }

  if (!in_array($form_id, ['entity_view_display_edit_form', 'entity_view_display_form'], TRUE)) {
    return;
  }

  location_virtual_field_add_display_settings($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for entity_view_display_edit_form.
 */
function location_virtual_field_form_entity_view_display_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  if (\Drupal::moduleHandler()->moduleExists('nomads_listing_virtual_fields')) {
    return;
  }

  location_virtual_field_add_display_settings($form, $form_state);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for entity_view_display_form.
 */
function location_virtual_field_form_entity_view_display_form_alter(array &$form, FormStateInterface $form_state): void {
  if (\Drupal::moduleHandler()->moduleExists('nomads_listing_virtual_fields')) {
    return;
  }

  location_virtual_field_add_display_settings($form, $form_state);
}

/**
 * Adds location virtual field display settings to Manage Display form.
 */
function location_virtual_field_add_display_settings(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return;
  }

  $display = $form_object->getEntity();
  if (!$display instanceof EntityViewDisplayInterface) {
    return;
  }

  if ($display->getTargetEntityTypeId() !== 'node' || $display->getTargetBundle() !== 'listing') {
    return;
  }

  if (isset($form['location_virtual_field_settings'])) {
    return;
  }

  $default_link_terms = (bool) $display->getThirdPartySetting('location_virtual_field', 'link_terms', TRUE);
  $default_max_bundles = max(1, (int) $display->getThirdPartySetting('location_virtual_field', 'max_bundles', 6));

  $form['location_virtual_field_settings'] = [
    '#type' => 'details',
    '#title' => t('Location virtual field'),
    '#open' => FALSE,
    '#weight' => 100,
    '#tree' => TRUE,
  ];
  $form['location_virtual_field_settings']['link_terms'] = [
    '#type' => 'checkbox',
    '#title' => t('Link terms'),
    '#description' => t('Link region, country and place terms to their term pages.'),
    '#default_value' => $default_link_terms,
  ];
  $form['location_virtual_field_settings']['max_bundles'] = [
    '#type' => 'number',
    '#title' => t('Maximal number of bundles'),
    '#description' => t('Maximum number of bundles rendered for the multi-bundles variant.'),
    '#default_value' => $default_max_bundles,
    '#min' => 1,
    '#step' => 1,
    '#required' => TRUE,
  ];

  if (!isset($form['#submit']) || !is_array($form['#submit'])) {
    $form['#submit'] = [];
  }
  if (!in_array('location_virtual_field_entity_view_display_edit_form_submit', $form['#submit'], TRUE)) {
    $form['#submit'][] = 'location_virtual_field_entity_view_display_edit_form_submit';
  }
}

/**
 * Submit callback for entity_view_display_edit_form.
 */
function location_virtual_field_entity_view_display_edit_form_submit(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return;
  }

  $display = $form_object->getEntity();
  if (!$display instanceof EntityViewDisplayInterface) {
    return;
  }

  if ($display->getTargetEntityTypeId() !== 'node' || $display->getTargetBundle() !== 'listing') {
    return;
  }

  $settings = (array) $form_state->getValue('location_virtual_field_settings', []);
  $link_terms = !empty($settings['link_terms']);
  $max_bundles = max(1, (int) ($settings['max_bundles'] ?? 6));

  $display->setThirdPartySetting('location_virtual_field', 'link_terms', $link_terms);
  $display->setThirdPartySetting('location_virtual_field', 'max_bundles', $max_bundles);
}
