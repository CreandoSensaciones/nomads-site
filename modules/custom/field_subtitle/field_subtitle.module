<?php

/**
 * @file
 * Adds configurable subtitles to field widgets.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\FieldConfigInterface;

/**
 * Implements hook_form_FORM_ID_alter().
 */
function field_subtitle_form_field_config_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return;
  }

  $field_config = $form_object->getEntity();
  if (!$field_config instanceof FieldConfigInterface) {
    return;
  }

  if (!isset($form['third_party_settings']) || !is_array($form['third_party_settings'])) {
    return;
  }

  $form['third_party_settings']['field_subtitle'] = [
    '#type' => 'details',
    '#title' => t('Field subtitle'),
    '#tree' => TRUE,
    '#open' => TRUE,
  ];

  $form['third_party_settings']['field_subtitle']['subtitle'] = [
    '#type' => 'textfield',
    '#title' => t('Subtitle'),
    '#default_value' => $field_config->getThirdPartySetting('field_subtitle', 'subtitle', ''),
    '#maxlength' => 255,
    '#description' => t('Shown below the label and above the widget on forms.'),
    '#element_validate' => ['field_subtitle_normalize_subtitle'],
  ];
}

/**
 * Implements hook_form_alter().
 */
function field_subtitle_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $form['#after_build'] = $form['#after_build'] ?? [];
  $form['#after_build'][] = 'field_subtitle_after_build';
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
function field_subtitle_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $subtitle = field_subtitle_get_field_subtitle($context);
  if ($subtitle === NULL) {
    return;
  }

  // Single-element alters run once per delta. For multi-value fields, attach
  // subtitles at the complete widget wrapper level so they render only once.
  if (field_subtitle_is_multiple_field($context)) {
    return;
  }

  $widget = $context['widget'] ?? NULL;
  if ($widget && method_exists($widget, 'getPluginId')) {
    $plugin_id = $widget->getPluginId();
    if (in_array($plugin_id, ['special_category_select', 'nomads_easy_tagging_master'], TRUE)) {
      field_subtitle_apply_to_special_category_select($element, $subtitle);
      return;
    }
  }

  field_subtitle_apply_to_element($element, $subtitle);
}

/**
 * Implements hook_field_widget_complete_form_alter().
 */
function field_subtitle_field_widget_complete_form_alter(array &$field_widget_complete_form, FormStateInterface $form_state, $context): void {
  $subtitle = field_subtitle_get_field_subtitle($context);
  if ($subtitle === NULL) {
    return;
  }

  if (field_subtitle_is_multiple_field($context)) {
    field_subtitle_apply_to_element($field_widget_complete_form, $subtitle);
    if (
      !field_subtitle_element_has_subtitle($field_widget_complete_form)
      && isset($field_widget_complete_form['widget'])
      && is_array($field_widget_complete_form['widget'])
    ) {
      field_subtitle_apply_to_element($field_widget_complete_form['widget'], $subtitle);
    }
    return;
  }

  if (isset($field_widget_complete_form['widget']) && is_array($field_widget_complete_form['widget'])) {
    field_subtitle_apply_to_element($field_widget_complete_form['widget'], $subtitle);
  }

  if (!field_subtitle_element_has_subtitle($field_widget_complete_form)) {
    field_subtitle_apply_to_element($field_widget_complete_form, $subtitle);
  }
}

/**
 * Normalizes empty subtitles so the setting is removed.
 */
function field_subtitle_normalize_subtitle(array &$element, FormStateInterface $form_state, array &$complete_form): void {
  $value = is_string($element['#value']) ? trim($element['#value']) : $element['#value'];
  if ($value === '' || $value === NULL) {
    $form_state->setValueForElement($element, NULL);
  }
}

/**
 * Gets the configured subtitle for a field widget.
 */
function field_subtitle_get_field_subtitle(array $context): ?string {
  $items = $context['items'] ?? NULL;
  $field_definition = $context['field_definition'] ?? NULL;

  if ($items && method_exists($items, 'getFieldDefinition')) {
    $field_definition = $items->getFieldDefinition();
  }

  if (!$field_definition instanceof FieldDefinitionInterface) {
    return NULL;
  }

  if (method_exists($field_definition, 'getThirdPartySetting')) {
    $subtitle = $field_definition->getThirdPartySetting('field_subtitle', 'subtitle', '');
    if (is_string($subtitle) && trim($subtitle) !== '') {
      return trim($subtitle);
    }
  }

  $field_name = $field_definition->getName();
  $entity = $items && method_exists($items, 'getEntity') ? $items->getEntity() : NULL;
  $entity_type_id = $entity ? $entity->getEntityTypeId() : $field_definition->getTargetEntityTypeId();
  $bundle = $entity ? $entity->bundle() : ($field_definition->getTargetBundle() ?? NULL);
  if (!$entity_type_id || !$bundle) {
    // Some nested widget contexts (for example paragraph subforms) may not
    // expose a reliable bundle here. Fall back to field_config lookup by
    // entity type + field name and use the configured subtitle if unique.
    if (!$entity_type_id || $field_name === '') {
      return NULL;
    }

    $field_configs = \Drupal::entityTypeManager()
      ->getStorage('field_config')
      ->loadByProperties([
        'entity_type' => $entity_type_id,
        'field_name' => $field_name,
      ]);

    $candidates = [];
    foreach ($field_configs as $candidate) {
      if (!$candidate instanceof FieldConfigInterface) {
        continue;
      }
      $candidate_subtitle = $candidate->getThirdPartySetting('field_subtitle', 'subtitle', '');
      if (!is_string($candidate_subtitle)) {
        continue;
      }
      $candidate_subtitle = trim($candidate_subtitle);
      if ($candidate_subtitle === '') {
        continue;
      }
      $candidates[$candidate->getTargetBundle()] = $candidate_subtitle;
    }

    if (!$candidates) {
      return NULL;
    }
    if (count($candidates) === 1) {
      return reset($candidates) ?: NULL;
    }

    ksort($candidates);
    return reset($candidates) ?: NULL;
  }

  $field_config = FieldConfig::loadByName($entity_type_id, $bundle, $field_name);
  if (!$field_config) {
    return NULL;
  }

  $subtitle = $field_config->getThirdPartySetting('field_subtitle', 'subtitle', '');
  if (!is_string($subtitle)) {
    return NULL;
  }

  $subtitle = trim($subtitle);
  return $subtitle !== '' ? $subtitle : NULL;
}

/**
 * Determines whether the current widget context belongs to a multi-value field.
 */
function field_subtitle_is_multiple_field(array $context): bool {
  $items = $context['items'] ?? NULL;
  if ($items && method_exists($items, 'getFieldDefinition')) {
    $field_definition = $items->getFieldDefinition();
    if ($field_definition instanceof FieldDefinitionInterface) {
      return $field_definition->getFieldStorageDefinition()->isMultiple();
    }
  }

  $field_definition = $context['field_definition'] ?? NULL;
  if ($field_definition instanceof FieldDefinitionInterface) {
    return $field_definition->getFieldStorageDefinition()->isMultiple();
  }

  return FALSE;
}

/**
 * Applies subtitle markup and classes to a field element.
 */
function field_subtitle_apply_to_element(array &$element, string $subtitle): void {
  $target = &$element;
  $is_smartdate_widget = isset($element['time_wrapper'])
    || (
      isset($element['#attributes']['class'])
      && is_array($element['#attributes']['class'])
      && in_array('smartdate--widget', $element['#attributes']['class'], TRUE)
    );

  if (!$is_smartdate_widget && isset($element['value']) && is_array($element['value'])) {
    $target = &$element['value'];
  }
  elseif (!$is_smartdate_widget && !isset($target['#title'])) {
    foreach (Element::children($element) as $child_key) {
      if (isset($element[$child_key]['#type'], $element[$child_key]['#title'])) {
        $target = &$element[$child_key];
        break;
      }
    }
  }

  if (!isset($target['#title'])) {
    return;
  }

  if (!isset($target['#wrapper_attributes']['class']) || !is_array($target['#wrapper_attributes']['class'])) {
    $target['#wrapper_attributes']['class'] = [];
  }
  $target['#wrapper_attributes']['class'][] = 'field-subtitle-enabled';

  if (!isset($target['#attributes']['class']) || !is_array($target['#attributes']['class'])) {
    $target['#attributes']['class'] = [];
  }
  $target['#attributes']['class'][] = 'field-subtitle-enabled';

  $target['#attached']['library'][] = 'field_subtitle/field_subtitle';

  $existing_prefix = $target['#field_prefix'] ?? '';
  if (is_array($existing_prefix) && isset($existing_prefix['field_subtitle'])) {
    return;
  }
  if (is_string($existing_prefix) && str_contains($existing_prefix, 'field-subtitle-text')) {
    return;
  }
  if ($existing_prefix instanceof Markup && str_contains($existing_prefix->__toString(), 'field-subtitle-text')) {
    return;
  }
  $subtitle_markup = '<span class="form-item__prefix"><span class="field-subtitle-text">'
    . Html::escape($subtitle) . '</span></span>';

  // Keep array-based field prefixes intact (e.g. media_library_widget
  // fieldset prefixes like empty_selection and weight_toggle).
  if (is_array($existing_prefix)) {
    $target['#field_prefix'] = [
      'field_subtitle' => [
        '#markup' => $subtitle_markup,
      ],
    ] + $existing_prefix;
  }
  elseif (is_string($existing_prefix) && $existing_prefix !== '') {
    $subtitle_markup = $existing_prefix . $subtitle_markup;
    $target['#field_prefix'] = Markup::create($subtitle_markup);
  }
  elseif ($existing_prefix instanceof Markup) {
    $subtitle_markup = $existing_prefix->__toString() . $subtitle_markup;
    $target['#field_prefix'] = Markup::create($subtitle_markup);
  }
  else {
    $target['#field_prefix'] = Markup::create($subtitle_markup);
  }

  if ($target !== $element) {
    if (!isset($element['#attached']['library']) || !in_array('field_subtitle/field_subtitle', $element['#attached']['library'], TRUE)) {
      $element['#attached']['library'][] = 'field_subtitle/field_subtitle';
    }
  }
}

/**
 * Applies subtitle markup to the Special Category Select widget.
 */
function field_subtitle_apply_to_special_category_select(array &$element, string $subtitle): void {
  if (isset($element['ui_label']) && is_array($element['ui_label']) && isset($element['ui_label']['label']['#value'])) {
    if (!isset($element['ui_label']['#attributes']['class']) || !is_array($element['ui_label']['#attributes']['class'])) {
      $element['ui_label']['#attributes']['class'] = [];
    }
    $element['ui_label']['#attributes']['class'][] = 'field-subtitle-enabled';

    if (!isset($element['#attached']['library']) || !in_array('field_subtitle/field_subtitle', $element['#attached']['library'], TRUE)) {
      $element['#attached']['library'][] = 'field_subtitle/field_subtitle';
    }

    if (!isset($element['ui_label']['prefix'])) {
      $element['ui_label']['prefix'] = [
        '#type' => 'html_tag',
        '#tag' => 'span',
        '#attributes' => [
          'class' => ['field-prefix'],
        ],
        'content' => [
          '#markup' => '<span class="form-item__prefix"><span class="field-subtitle-text">'
            . Html::escape($subtitle) . '</span></span>',
        ],
      ];
    }

    return;
  }

  if (!isset($element['ui_title']['#value'])) {
    field_subtitle_apply_to_element($element, $subtitle);
    return;
  }

  $title_text = (string) $element['ui_title']['#value'];
  if (str_contains($title_text, 'field-subtitle-text')) {
    return;
  }

  $element['ui_title']['#value'] = Markup::create(
    Html::escape($title_text)
    . '<span class="form-item__prefix"><span class="field-subtitle-text">'
    . Html::escape($subtitle) . '</span></span>'
  );

  if (!isset($element['#attributes']['class']) || !is_array($element['#attributes']['class'])) {
    $element['#attributes']['class'] = [];
  }
  $element['#attributes']['class'][] = 'field-subtitle-enabled';
  $element['#attached']['library'][] = 'field_subtitle/field_subtitle';

  if (!isset($element['ui_title']['#attributes']['class']) || !is_array($element['ui_title']['#attributes']['class'])) {
    $element['ui_title']['#attributes']['class'] = [];
  }
  $element['ui_title']['#attributes']['class'][] = 'field-subtitle-enabled';
}

/**
 * Recursively applies subtitles when widget hooks miss nested structures.
 */
function field_subtitle_apply_fallback_subtitles(array &$element, ?string $entity_type = NULL, ?string $bundle = NULL): void {
  if (isset($element['#entity_type']) && is_string($element['#entity_type']) && $element['#entity_type'] !== '') {
    $entity_type = $element['#entity_type'];
  }
  if (isset($element['#bundle']) && is_string($element['#bundle']) && $element['#bundle'] !== '') {
    $bundle = $element['#bundle'];
  }
  if (isset($element['#paragraph_type']) && is_string($element['#paragraph_type']) && $element['#paragraph_type'] !== '') {
    $bundle = $element['#paragraph_type'];
  }

  if (
    $entity_type
    && $bundle
    && isset($element['#title'])
    && isset($element['#parents'])
    && is_array($element['#parents'])
    && count($element['#parents']) >= 2
    && !field_subtitle_element_has_subtitle($element)
  ) {
    $parents = $element['#parents'];
    $last = end($parents);
    $field_name = prev($parents);
    reset($parents);

    if (is_numeric($last) && is_string($field_name) && str_starts_with($field_name, 'field_')) {
      $subtitle = field_subtitle_get_config_subtitle($entity_type, $bundle, $field_name);
      if ($subtitle !== NULL) {
        field_subtitle_apply_to_element($element, $subtitle);
      }
    }
  }

  foreach (Element::children($element) as $child_key) {
    if (!isset($element[$child_key]) || !is_array($element[$child_key])) {
      continue;
    }
    field_subtitle_apply_fallback_subtitles($element[$child_key], $entity_type, $bundle);
  }
}

/**
 * Checks whether subtitle markup is already present on an element.
 */
function field_subtitle_element_has_subtitle(array $element): bool {
  foreach ([$element['#field_prefix'] ?? NULL, $element['value']['#field_prefix'] ?? NULL] as $prefix) {
    if (is_string($prefix) && str_contains($prefix, 'field-subtitle-text')) {
      return TRUE;
    }
    if ($prefix instanceof Markup && str_contains($prefix->__toString(), 'field-subtitle-text')) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Resolves subtitle from field config by entity type, bundle, and field name.
 */
function field_subtitle_get_config_subtitle(string $entity_type_id, string $bundle, string $field_name): ?string {
  $field_config = FieldConfig::loadByName($entity_type_id, $bundle, $field_name);
  if (!$field_config) {
    return NULL;
  }
  $subtitle = $field_config->getThirdPartySetting('field_subtitle', 'subtitle', '');
  if (!is_string($subtitle)) {
    return NULL;
  }
  $subtitle = trim($subtitle);
  return $subtitle !== '' ? $subtitle : NULL;
}

/**
 * Applies subtitle fallback logic after full form build.
 */
function field_subtitle_after_build(array $form, FormStateInterface $form_state): array {
  field_subtitle_apply_fallback_subtitles($form);
  return $form;
}
