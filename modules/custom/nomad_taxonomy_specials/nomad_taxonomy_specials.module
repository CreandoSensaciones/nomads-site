<?php

/**
 * @file
 * Nomad Taxonomy Specials module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function nomad_taxonomy_specials_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.nomad_taxonomy_specials':
      $output = '';
      $output .= '<h2>' . t('Nomad Taxonomy Specials') . '</h2>';
      $output .= '<p>' . t('Nomad Taxonomy Specials applies client-side incompatibility rules to taxonomy term reference widgets that target the <code>type</code> vocabulary. It is used to prevent editors from combining special top-level type branches with incompatible normal type branches while editing content.') . '</p>';

      $output .= '<h3>' . t('Functionality') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Detects entity reference fields whose target type is <code>taxonomy_term</code> and whose target bundles include the <code>type</code> vocabulary.') . '</li>';
      $output .= '<li>' . t('Attaches the <code>nomad_taxonomy_specials/widget</code> library and passes taxonomy tree settings through <code>drupalSettings.nomadTaxonomySpecials</code>.') . '</li>';
      $output .= '<li>' . t('Builds a map from every term ID to its top-level branch and a list of term IDs in each top-level branch.') . '</li>';
      $output .= '<li>' . t('Disables incompatible checkboxes, radios, select options, and Special Category Select tree links in the browser.') . '</li>';
      $output .= '<li>' . t('Shows a temporary <em>Incompatible choice</em> status message when an editor clicks a disabled Special Category Select item.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Rules') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('If top-level branch <code>14</code>, or any child of that branch, is selected, all other branches are disabled.') . '</li>';
      $output .= '<li>' . t('If top-level branch <code>25</code>, or any child of that branch, is selected, all other branches are disabled.') . '</li>';
      $output .= '<li>' . t('If any other branch is selected, branches <code>14</code> and <code>25</code>, including their children, are disabled.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Architecture') . '</h3>';
      $output .= '<p>' . t('The PHP hooks only decide when to attach the JavaScript and build settings from the current <code>type</code> taxonomy tree. <code>hook_field_widget_form_alter()</code> handles normal field widget contexts, while <code>hook_form_alter()</code> covers forms with a <code>field_types</code> element. The JavaScript reads selected term IDs from hidden Special Category Select inputs, normal taxonomy inputs, select options, and selected-list markup, computes disabled IDs from the top-level branch map, and applies disabled states to matching controls.') . '</p>';

      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('There is no admin configuration form. The module is configured in code by the <code>type</code> vocabulary and the hardcoded exclusive top-level term IDs <code>14</code> and <code>25</code>. If those terms are recreated, migrated, or renumbered, the code must be updated. The behavior applies automatically to matching taxonomy reference widgets when the module is enabled.') . '</p>';

      $output .= '<h3>' . t('Stability concerns') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('The exclusive branch IDs are hardcoded numeric term IDs. Taxonomy migrations or content rebuilds can change IDs and silently invalidate the rules.') . '</li>';
      $output .= '<li>' . t('The JavaScript depends on Special Category Select CSS classes and data attributes, including selected-list and tree-link markup.') . '</li>';
      $output .= '<li>' . t('The selector also scans broad <code>.special-category-select</code> containers and then filters by field naming conventions, so similarly shaped widgets should be checked for unintended behavior.') . '</li>';
      $output .= '<li>' . t('The branch lookup walks parent references with a guard limit. Very unusual taxonomy structures, multiple parents, or deep hierarchies may not behave as expected.') . '</li>';
      $output .= '<li>' . t('There is no automated test coverage for rule computation, widget selector coverage, Ajax rebuilds, or stale selections.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Security concerns') . '</h3>';
      $output .= '<p>' . t('The restrictions are enforced in the browser only. A user, migration, API client, or disabled JavaScript environment can still submit incompatible term combinations unless server-side validation exists elsewhere. Treat this module as an editor guidance and usability layer, not as an integrity or access-control boundary. It does not add permissions, change taxonomy access, or validate saved entity values on the server.') . '</p>';

      return $output;
  }

  return NULL;
}

/**
 * Implements hook_field_widget_form_alter().
 */
function nomad_taxonomy_specials_field_widget_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $items = $context['items'] ?? NULL;
  if (!$items) {
    return;
  }

  $definition = $items->getFieldDefinition();
  if ($definition->getType() !== 'entity_reference') {
    return;
  }

  $target_type = $definition->getSetting('target_type');
  if ($target_type !== 'taxonomy_term') {
    return;
  }

  $handler_settings = $definition->getSetting('handler_settings') ?? [];
  $target_bundles = $handler_settings['target_bundles'] ?? [];
  if (!in_array('type', $target_bundles, TRUE)) {
    return;
  }

  $settings = nomad_taxonomy_specials_build_settings();
  if (empty($settings['groups'])) {
    return;
  }

  $element['#attributes']['data-nomad-taxonomy-specials'] = '1';
  if (isset($element['ui']['#attributes']) && is_array($element['ui']['#attributes'])) {
    $element['ui']['#attributes']['data-nomad-taxonomy-specials'] = '1';
  }
  $element['#attached']['library'][] = 'nomad_taxonomy_specials/widget';
  if (isset($element['ui']['#attached']) && is_array($element['ui']['#attached'])) {
    $element['ui']['#attached']['library'][] = 'nomad_taxonomy_specials/widget';
  }

  if (!isset($element['#attached']['drupalSettings']['nomadTaxonomySpecials'])) {
    $element['#attached']['drupalSettings']['nomadTaxonomySpecials'] = $settings;
  }
  if (isset($element['ui']['#attached']) && is_array($element['ui']['#attached'])) {
    if (!isset($element['ui']['#attached']['drupalSettings']['nomadTaxonomySpecials'])) {
      $element['ui']['#attached']['drupalSettings']['nomadTaxonomySpecials'] = $settings;
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function nomad_taxonomy_specials_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (!isset($form['field_types']) || !is_array($form['field_types'])) {
    return;
  }

  $settings = nomad_taxonomy_specials_build_settings();
  if (empty($settings['groups'])) {
    return;
  }

  if (!isset($form['#attached'])) {
    $form['#attached'] = [];
  }
  $form['#attached']['library'][] = 'nomad_taxonomy_specials/widget';
  if (!isset($form['#attached']['drupalSettings']['nomadTaxonomySpecials'])) {
    $form['#attached']['drupalSettings']['nomadTaxonomySpecials'] = $settings;
  }

  if (!isset($form['field_types']['#attributes']) || !is_array($form['field_types']['#attributes'])) {
    $form['field_types']['#attributes'] = [];
  }
  $form['field_types']['#attributes']['data-nomad-taxonomy-specials'] = '1';
}

/**
 * Build the incompatibility settings for the type vocabulary.
 */
function nomad_taxonomy_specials_build_settings(): array {
  static $settings = NULL;
  if ($settings !== NULL) {
    return $settings;
  }

  $vid = 'type';
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $term_storage->loadTree($vid, 0, NULL, TRUE);
  if (!$terms) {
    $settings = [];
    return $settings;
  }

  $parent_map = [];
  $term_ids = [];
  foreach ($terms as $term) {
    $term_id = (int) $term->id();
    $term_ids[$term_id] = TRUE;
    $parent_map[$term_id] = 0;
    foreach ($term->get('parent')->getValue() as $parent) {
      $parent_id = (int) ($parent['target_id'] ?? 0);
      if ($parent_id) {
        $parent_map[$term_id] = $parent_id;
        break;
      }
    }
  }

  $term_to_top = [];
  $groups = [];
  foreach (array_keys($term_ids) as $term_id) {
    $current = $term_id;
    $guard = 0;
    while (!empty($parent_map[$current]) && $guard < 50) {
      $current = $parent_map[$current];
      $guard++;
    }
    $top_id = $current;
    $term_to_top[$term_id] = $top_id;
    if (!isset($groups[$top_id])) {
      $groups[$top_id] = [];
    }
    $groups[$top_id][] = $term_id;
  }

  foreach ($groups as $top_id => $group_terms) {
    $groups[$top_id] = array_values(array_unique($group_terms));
  }

  $settings = [
    'vocabulary' => $vid,
    'exclusiveTopLevelIds' => [25, 14],
    'termToTopLevel' => $term_to_top,
    'groups' => $groups,
  ];

  return $settings;
}
