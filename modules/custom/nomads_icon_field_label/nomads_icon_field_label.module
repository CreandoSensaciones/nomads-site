<?php

/**
 * @file
 * Nomads Icon Field Label module.
 */

use Drupal\Component\Render\MarkupInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Component\Utility\Html;

/**
 * Implements hook_help().
 */
function nomads_icon_field_label_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.nomads_icon_field_label':
      $output = '';
      $output .= '<h2>' . t('Nomads Icon Field Label') . '</h2>';
      $output .= '<p>' . t('Nomads Icon Field Label adds an <em>Icon</em> field label display mode. Fields using this label mode hide the normal text label and prepend a per-field SVG icon to the rendered field output.') . '</p>';

      $output .= '<h3>' . t('Functionality') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Adds <em>Icon</em> as a label-display option on entity Manage display forms.') . '</li>';
      $output .= '<li>' . t('Detects rendered fields with <code>label_display</code> set to <code>icon</code>.') . '</li>';
      $output .= '<li>' . t('Loads SVG icons from <code>public://data-icons/{entity_type}-{bundle}-{field_name}.svg</code>, with underscores converted to hyphens.') . '</li>';
      $output .= '<li>' . t('Falls back to a built-in grey circle placeholder when no matching SVG file exists or the file cannot be read.') . '</li>';
      $output .= '<li>' . t('Wraps the first rendered field item with an icon-and-content container and attaches the <code>nomads_icon_field_label/icon-label</code> CSS library.') . '</li>';
      $output .= '<li>' . t('Preserves the original field label as an icon <code>title</code> attribute when a label is available.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Architecture') . '</h3>';
      $output .= '<p>' . t('The module alters the entity view display edit form to add the label option, adds its field preprocess function to the theme registry, and recursively scans entity render arrays during <code>hook_entity_view()</code>. Matching field elements receive a trusted pre-render callback from <code>TrustedCallbacks</code>. Both the preprocess and pre-render paths use the same icon lookup helper, which reads SVG files from public files and returns render-safe markup objects.') . '</p>';

      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('Configure a field from an entity Manage display page by setting its label display to <em>Icon</em>. Add SVG files under <code>public://data-icons</code> using the naming convention <code>{entity-type}-{bundle}-{field-name}.svg</code>; for example, underscores in machine names are converted to hyphens before lookup. There is no separate settings form, cache management screen, or icon upload UI in this module.') . '</p>';

      $output .= '<h3>' . t('Stability concerns') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Icon lookup depends on an exact filesystem naming convention; missing or renamed files silently render the placeholder icon.') . '</li>';
      $output .= '<li>' . t('Only the first field item is wrapped with the icon, so multi-value fields can have uneven markup compared with single-value fields.') . '</li>';
      $output .= '<li>' . t('The module has both preprocess and pre-render pathways, which can make render behavior harder to reason about across themes and view modes.') . '</li>';
      $output .= '<li>' . t('SVG file contents are cached only in a static per-request cache; there is no persistent cache metadata tied to icon file changes.') . '</li>';
      $output .= '<li>' . t('Recursive render-array scanning during entity view can add overhead on large or deeply nested renders.') . '</li>';
      $output .= '<li>' . t('There is no automated test coverage for the Manage display integration, icon lookup, placeholder fallback, multi-value fields, or cache behavior.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Security concerns') . '</h3>';
      $output .= '<p>' . t('SVG file contents from <code>public://data-icons</code> are injected into markup without sanitizing the SVG body. Treat that directory as trusted code-like input: only trusted users or deployment processes should be able to create or change those SVG files. Untrusted SVG can contain scriptable or unsafe markup and may create XSS risk. Field labels used in title attributes are escaped, and the placeholder SVG is hardcoded, but custom icon files themselves must be curated and kept safe.') . '</p>';

      return $output;
  }

  return NULL;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function nomads_icon_field_label_form_entity_view_display_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  if (empty($form['fields']) || !is_array($form['fields'])) {
    return;
  }

  foreach ($form['fields'] as $field_name => &$field_row) {
    if (!is_array($field_row) || empty($field_row['label']['#options'])) {
      continue;
    }

    $field_row['label']['#options']['icon'] = t('Icon');
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function nomads_icon_field_label_theme_registry_alter(array &$registry): void {
  if (!isset($registry['field']['preprocess functions']) || !is_array($registry['field']['preprocess functions'])) {
    $registry['field']['preprocess functions'] = [];
  }

  if (!in_array('nomads_icon_field_label_preprocess_field', $registry['field']['preprocess functions'], TRUE)) {
    $registry['field']['preprocess functions'][] = 'nomads_icon_field_label_preprocess_field';
  }
}

/**
 * Implements hook_entity_view().
 */
function nomads_icon_field_label_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  if (!nomads_icon_field_label_display_has_icon_labels($display)) {
    return;
  }

  nomads_icon_field_label_apply_icon_label($build);
}

/**
 * Determines whether an entity view display contains icon-label components.
 */
function nomads_icon_field_label_display_has_icon_labels(EntityViewDisplayInterface $display): bool {
  foreach ($display->getComponents() as $component) {
    if (($component['label'] ?? NULL) === 'icon') {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_preprocess_field().
 */
function nomads_icon_field_label_preprocess_field(array &$variables, $hook = NULL, array $info = NULL): void {
  if (($variables['label_display'] ?? NULL) !== 'icon') {
    return;
  }

  $element = $variables['element'] ?? [];
  $entity_type = $element['#entity_type'] ?? '';
  $bundle = $element['#bundle'] ?? '';
  $field_name = $element['#field_name'] ?? '';

  $icon_markup = nomads_icon_field_label_get_icon_markup($entity_type, $bundle, $field_name, (string) ($variables['label'] ?? ''));
  $variables['label_hidden'] = TRUE;
  $variables['label'] = '';
  $variables['#attached']['library'][] = 'nomads_icon_field_label/icon-label';

  if (empty($variables['items'][0]['content'])) {
    return;
  }

  $item_content = $variables['items'][0]['content'];
  $variables['items'][0]['content'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['nomads-icon-field-label__wrapper']],
    'icon' => ['#markup' => $icon_markup],
    'content' => is_array($item_content) ? $item_content : ['#markup' => $item_content],
  ];
}

/**
 * Recursively applies the icon label behavior to field render arrays.
 */
function nomads_icon_field_label_apply_icon_label(array &$element): void {
  foreach ($element as &$child) {
    if (!is_array($child)) {
      continue;
    }

    if (($child['#theme'] ?? NULL) === 'field' && ($child['#label_display'] ?? NULL) === 'icon') {
      $child['#pre_render'][] = [\Drupal\nomads_icon_field_label\TrustedCallbacks::class, 'preRenderField'];
    }

    nomads_icon_field_label_apply_icon_label($child);
  }
}

/**
 * Builds icon markup for a field label.
 */
function nomads_icon_field_label_get_icon_markup(string $entity_type, string $bundle, string $field_name, string $label = ''): MarkupInterface {
  if ($entity_type === '' || $bundle === '' || $field_name === '') {
    return nomads_icon_field_label_placeholder_markup($label);
  }

  static $cache = [];
  $cache_key = $entity_type . ':' . $bundle . ':' . $field_name;
  if (array_key_exists($cache_key, $cache)) {
    return $cache[$cache_key];
  }

  $entity_type_slug = str_replace('_', '-', $entity_type);
  $bundle_slug = str_replace('_', '-', $bundle);
  $field_slug = str_replace('_', '-', $field_name);
  $icon_uri = 'public://data-icons/' . $entity_type_slug . '-' . $bundle_slug . '-' . $field_slug . '.svg';
  $icon_path = \Drupal::service('file_system')->realpath($icon_uri);
  if ($icon_path === FALSE || !is_file($icon_path)) {
    $cache[$cache_key] = nomads_icon_field_label_placeholder_markup($label);
    return $cache[$cache_key];
  }

  $svg = file_get_contents($icon_path);
  if ($svg === FALSE || $svg === '') {
    $cache[$cache_key] = nomads_icon_field_label_placeholder_markup($label);
    return $cache[$cache_key];
  }

  $title_attribute = $label !== '' ? ' title="' . Html::escape($label) . '"' : '';
  $cache[$cache_key] = Markup::create('<span class="nomads-icon-field-label__icon"' . $title_attribute . '>' . $svg . '</span>');
  return $cache[$cache_key];
}

/**
 * Returns a grey circle placeholder icon.
 */
function nomads_icon_field_label_placeholder_markup(string $label = ''): MarkupInterface {
  $title_attribute = $label !== '' ? ' title="' . Html::escape($label) . '"' : '';
  return Markup::create('<span class="nomads-icon-field-label__icon nomads-icon-field-label__icon--placeholder"' . $title_attribute . '><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="6" fill="#c4c4c4"/></svg></span>');
}
