<?php

/**
 * @file
 * Nomads Perks module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function nomads_perks_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.nomads_perks':
      $output = '';
      $output .= '<h2>' . t('Nomads Perks') . '</h2>';
      $output .= '<p>' . t('Nomads Perks adds a display-only extra field for listing nodes that renders a small perks teaser pill.') . '</p>';

      $output .= '<h3>' . t('Functionality') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Registers the <code>perk_teaser</code> extra display field on the <code>listing</code> node bundle.') . '</li>';
      $output .= '<li>' . t('Lets site builders place the extra field from the listing Manage display screen.') . '</li>';
      $output .= '<li>' . t('Renders a <code>nomads-pill perk-teaser</code> span with text in the form <em>Up to N% perks</em>.') . '</li>';
      $output .= '<li>' . t('Provides a <em>Listing perk edit form</em> block that renders the current listing edit form with the <code>perk</code> form mode.') . '</li>';
      $output .= '<li>' . t('Generates the percentage randomly between 10 and 50 each time the field is built.') . '</li>';
      $output .= '<li>' . t('Disables render caching for the field output so the random percentage is not cached.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Architecture') . '</h3>';
      $output .= '<p>' . t('The module uses <code>hook_entity_extra_field_info()</code> to declare the virtual display field and <code>hook_entity_view()</code> to inject the render array when the listing view display component is enabled. It reads the active node view display, respects the component region and weight, and adds a simple <code>html_tag</code> render element directly to the entity build. The listing perk edit block uses the standard node <code>edit</code> form operation and temporarily switches the form display mode to <code>perk</code>.') . '</p>';

      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('Enable and position <em>Perk teaser</em> from the Manage display page for the <code>listing</code> node bundle. Configure fields for the block from the Listing <em>Manage form display</em> page for the <code>perk</code> form mode. Place the <em>Listing perk edit form</em> block where it should appear on listing routes. The percentage range, text, classes, and cache behavior for the teaser are hardcoded in the module.') . '</p>';

      $output .= '<h3>' . t('Stability concerns') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('The output is random and not tied to real listing data, so it can change between page loads and may not be suitable for factual claims.') . '</li>';
      $output .= '<li>' . t('The field disables render caching with <code>max-age: 0</code>, which can reduce cache effectiveness on displays where it is enabled.') . '</li>';
      $output .= '<li>' . t('The implementation is hardcoded to the <code>listing</code> node bundle and the <code>perk_teaser</code> component name.') . '</li>';
      $output .= '<li>' . t('The listing perk edit block renders only when the current route has a listing node and the current user can update that node.') . '</li>';
      $output .= '<li>' . t('There is no automated test coverage for extra-field registration, display placement, random output, cache metadata, or markup.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Security concerns') . '</h3>';
      $output .= '<p>' . t('This module only adds display markup to listing node renders and does not alter access control, permissions, or stored data. The output text is generated by the module rather than from user input. If perks values become real business data later, they should be stored, validated, and rendered from trusted fields instead of generated randomly.') . '</p>';

      return $output;
  }

  return NULL;
}

/**
 * Implements hook_entity_form_mode_alter().
 */
function nomads_perks_entity_form_mode_alter(&$form_mode, EntityInterface $entity): void {
  if (
    !\Drupal::request()->attributes->get('_nomads_perks_force_perk_form_mode')
    || !$entity instanceof NodeInterface
    || $entity->bundle() !== 'listing'
  ) {
    return;
  }

  $form_mode = 'perk';
}

/**
 * Implements hook_entity_extra_field_info().
 */
function nomads_perks_entity_extra_field_info(): array {
  return [
    'node' => [
      'listing' => [
        'display' => [
          'perk_teaser' => [
            'label' => t('Perk teaser'),
            'description' => t('Renders the listing perks teaser text.'),
            'weight' => 0,
            'visible' => FALSE,
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_entity_view().
 */
function nomads_perks_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($entity->getEntityTypeId() !== 'node' || !method_exists($entity, 'bundle') || $entity->bundle() !== 'listing') {
    return;
  }

  $view_display = \Drupal::service('entity_display.repository')->getViewDisplay('node', 'listing', $view_mode);
  $component = $view_display->getComponent('perk_teaser');
  if (empty($component) || ($component['region'] ?? 'hidden') === 'hidden') {
    return;
  }

  $perk_percentage = mt_rand(10, 50);

  $build['perk_teaser'] = [
    '#type' => 'html_tag',
    '#tag' => 'span',
    '#value' => t('Up to <span class="perk-teaser__percentage">@percentage%</span> perks', ['@percentage' => $perk_percentage]),
    '#attributes' => [
      'class' => ['nomads-pill', 'perk-teaser'],
    ],
    '#cache' => [
      'max-age' => 0,
    ],
    '#weight' => $component['weight'] ?? 0,
    '#region' => $component['region'] ?? 'content',
  ];
}
