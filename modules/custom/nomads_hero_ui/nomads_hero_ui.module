<?php

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\Core\Form\FormBuilderInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Render\Markup;
use Drupal\image\Entity\ImageStyle;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;
use Drupal\user\Entity\User;
use Drupal\user\Form\UserLoginForm;
use Drupal\user\Form\UserPasswordForm;

/**
 * Implements hook_help().
 */
function nomads_hero_ui_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.nomads_hero_ui':
      $output = '';
      $output .= '<h2>' . t('Nomads Hero UI') . '</h2>';
      $output .= '<p>' . t('Nomads Hero UI provides the full-page presentation layer for hero nodes. It supplies custom hero templates, prepares hero-specific template variables, renders optimized background images, and can replace gated hero body content with inline login, registration, and password recovery forms for anonymous visitors.') . '</p>';

      $output .= '<h3>' . t('Functionality') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Registers custom full-view templates for <code>hero</code> nodes, including a special template suggestion for node ID <code>99</code>.') . '</li>';
      $output .= '<li>' . t('Builds hero template variables for title, background media, subtitle, teaser line, body, CTA field, authentication state, and content wrapper IDs.') . '</li>';
      $output .= '<li>' . t('Renders the first usable media image from <code>field_hero</code> as a direct <code>&lt;picture&gt;</code> background using the <code>hero_xl</code>, <code>hero_lg</code>, <code>hero_md</code>, and <code>hero_sm</code> image styles when available.') . '</li>';
      $output .= '<li>' . t('Supports media images stored in either <code>field_stock_image</code> or <code>field_media_image</code>.') . '</li>';
      $output .= '<li>' . t('Treats hero nodes with <code>field_hero_settings</code> values of <code>login</code> or <code>login_portal</code> as login-gated heroes.') . '</li>';
      $output .= '<li>' . t('For anonymous visitors on gated heroes, replaces the body slot with AJAX login, registration, and password recovery forms.') . '</li>';
      $output .= '<li>' . t('Redirects successful gated authentication submissions back to the hero node.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Architecture') . '</h3>';
      $output .= '<p>' . t('The module uses procedural Drupal hooks for theme registration, theme suggestion alteration, theme registry alteration, node preprocessing, and auth form alteration. The preprocess layer prepares variables consumed by <code>node--hero--full.html.twig</code> and <code>node--hero--full--99.html.twig</code>. Gated auth content is built as a replaceable render-array slot with a stable DOM ID, while <code>NomadsHeroUiAuthController</code> returns AJAX replace commands for switching between login, register, and recover forms.') . '</p>';

      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('There is no administration form for this module. Configuration is implicit in site structure: a <code>hero</code> content type, <code>field_hero</code> media reference, optional <code>field_subtitle</code>, <code>field_teaser_line</code>, <code>body</code>, <code>field_cta</code>, and <code>field_hero_settings</code> fields, compatible media image fields, and the expected hero image styles. Auth gating is controlled by storing <code>login</code> or <code>login_portal</code> in <code>field_hero_settings</code>.') . '</p>';

      $output .= '<h3>' . t('Stability concerns') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('The module is tightly coupled to the <code>hero</code> node bundle and specific field machine names.') . '</li>';
      $output .= '<li>' . t('The special template for node ID <code>99</code> is content-ID dependent and may break if content is recreated across environments with different IDs.') . '</li>';
      $output .= '<li>' . t('Background image rendering depends on image styles named <code>hero_xl</code>, <code>hero_lg</code>, <code>hero_md</code>, and <code>hero_sm</code>; missing styles reduce responsive output or fall back to original file URLs.') . '</li>';
      $output .= '<li>' . t('The direct <code>&lt;picture&gt;</code> markup bypasses normal formatter configuration, so changes to media display settings do not affect hero backgrounds.') . '</li>';
      $output .= '<li>' . t('AJAX authentication behavior depends on Drupal core auth form structure, submit button placement, and the replaceable wrapper ID remaining present in the hero template.') . '</li>';
      $output .= '<li>' . t('There is no automated test coverage for template suggestions, background image rendering, gated auth form switching, redirect behavior, or cache contexts.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Security concerns') . '</h3>';
      $output .= '<p>' . t('The auth-switch route is publicly accessible so anonymous users can request login, register, or recover forms, but the controller only responds for anonymous visitors on login-gated hero nodes. The module changes presentation and form placement; it does not protect node access by itself. If hero body content must be truly private, enforce that with node, field, or route access controls instead of relying only on this UI gate. Background image URLs are generated from referenced media files, so media and file access policies must match the privacy requirements of the hero content.') . '</p>';

      return $output;
  }

  return NULL;
}

/**
 * Implements hook_theme().
 */
function nomads_hero_ui_theme(): array {
  return [
    'node__hero__full' => [
      'base hook' => 'node',
      'template' => 'node--hero--full',
      'path' => \Drupal::service('extension.list.module')->getPath('nomads_hero_ui') . '/templates',
    ],
    'node__hero__full__99' => [
      'base hook' => 'node',
      'template' => 'node--hero--full--99',
      'path' => \Drupal::service('extension.list.module')->getPath('nomads_hero_ui') . '/templates',
    ],
    'nomads_hero_ui_magic_link_widget' => [
      'variables' => [
        'csrf_token' => NULL,
        'request_url' => NULL,
      ],
      'template' => 'nomads-hero-ui-magic-link-widget',
      'path' => \Drupal::service('extension.list.module')->getPath('nomads_hero_ui') . '/templates',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_node_alter().
 */
function nomads_hero_ui_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  $elements = $variables['elements'] ?? [];
  $node = $elements['#node'] ?? NULL;
  $view_mode = $elements['#view_mode'] ?? NULL;

  if (!$node instanceof NodeInterface || $node->bundle() !== 'hero' || $view_mode !== 'full') {
    return;
  }

  $suggestions[] = 'node__hero__full';

  if ((int) $node->id() === 99) {
    $suggestions[] = 'node__hero__full__99';
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function nomads_hero_ui_theme_registry_alter(array &$theme_registry): void {
  if (!isset($theme_registry['node'])) {
    return;
  }

  $theme_registry['node__hero__full'] = $theme_registry['node'];
  $theme_registry['node__hero__full']['template'] = 'node--hero--full';
  $theme_registry['node__hero__full']['path'] = \Drupal::service('extension.list.module')->getPath('nomads_hero_ui') . '/templates';

  $theme_registry['node__hero__full__99'] = $theme_registry['node'];
  $theme_registry['node__hero__full__99']['template'] = 'node--hero--full--99';
  $theme_registry['node__hero__full__99']['path'] = \Drupal::service('extension.list.module')->getPath('nomads_hero_ui') . '/templates';
}

/**
 * Implements hook_preprocess_node().
 */
function nomads_hero_ui_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  $view_mode = $variables['view_mode'] ?? NULL;

  if (!$node instanceof NodeInterface || $node->bundle() !== 'hero' || $view_mode !== 'full') {
    return;
  }

  if (empty($variables['attributes']) || is_array($variables['attributes'])) {
    $variables['attributes'] = new Attribute($variables['attributes'] ?? []);
  }

  if (empty($variables['content_attributes']) || is_array($variables['content_attributes'])) {
    $variables['content_attributes'] = new Attribute($variables['content_attributes'] ?? []);
  }

  $variables['hero_ui_title'] = trim((string) $node->label());
  $variables['hero_ui_background_render'] = nomads_hero_ui_build_background_media($node, 'field_hero');
  $variables['hero_ui_subtitle'] = nomads_hero_ui_get_field_render($variables, 'field_subtitle');
  $variables['hero_ui_teaser'] = nomads_hero_ui_get_field_render($variables, 'field_teaser_line');
  $variables['hero_ui_body'] = nomads_hero_ui_get_field_render($variables, 'body');
  $variables['hero_ui_actions'] = nomads_hero_ui_get_field_render($variables, 'field_cta');

  $variables['hero_ui_has_title'] = $variables['hero_ui_title'] !== '';
  $variables['hero_ui_has_background'] = $variables['hero_ui_background_render'] !== [];
  $variables['hero_ui_has_subtitle'] = $variables['hero_ui_subtitle'] !== [];
  $variables['hero_ui_has_teaser'] = $variables['hero_ui_teaser'] !== [];
  $variables['hero_ui_has_body'] = $variables['hero_ui_body'] !== [];
  $variables['hero_ui_has_actions'] = $variables['hero_ui_actions'] !== [];
  $variables['hero_ui_is_authenticated'] = \Drupal::currentUser()->isAuthenticated();
  $variables['hero_ui_requires_login'] = nomads_hero_ui_node_requires_login($node);
  $variables['hero_ui_show_auth_gate'] = $variables['hero_ui_requires_login'] && !$variables['hero_ui_is_authenticated'];
  $variables['hero_ui_content_wrapper_id'] = nomads_hero_ui_get_content_wrapper_id($node);
  $variables['hero_ui_auth_panel'] = [];

  $variables['elements']['#cache']['contexts'][] = 'user.roles:authenticated';

  if ($variables['hero_ui_show_auth_gate']) {
    $variables['hero_ui_auth_panel'] = nomads_hero_ui_build_content_slot($node);
  }
}

/**
 * Implements hook_form_alter().
 */
function nomads_hero_ui_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!in_array($form_id, ['user_login_form', 'user_register_form', 'user_pass'], TRUE)) {
    return;
  }

  $node = nomads_hero_ui_resolve_form_gate_node($form_state);
  if (!$node instanceof NodeInterface || !nomads_hero_ui_node_requires_login($node)) {
    return;
  }

  if (empty($form['actions']['submit']) || !is_array($form['actions']['submit'])) {
    return;
  }

  unset($form['magic_link_widget']);

  $form['nomads_hero_ui_node_id'] = [
    '#type' => 'hidden',
    '#name' => 'nomads_hero_ui_node_id',
    '#value' => (int) $node->id(),
  ];
  $form['nomads_hero_ui_form_type'] = [
    '#type' => 'hidden',
    '#name' => 'nomads_hero_ui_form_type',
    '#value' => nomads_hero_ui_get_form_type_from_form_id($form_id),
  ];

  $form['actions']['submit']['#ajax'] = [
    'callback' => 'nomads_hero_ui_auth_form_ajax_submit',
    'wrapper' => nomads_hero_ui_get_content_wrapper_id($node),
    'progress' => [
      'type' => 'throbber',
    ],
  ];
  $form['#validate'][] = 'nomads_hero_ui_auth_form_disable_redirect';
  $form['#submit'][] = 'nomads_hero_ui_auth_form_redirect_to_node';
  $form['#attributes']['data-nomads-hero-auth-form'] = (string) $node->id();
}

/**
 * Builds a direct background image render array for a media reference field.
 */
function nomads_hero_ui_build_background_media(NodeInterface $node, string $field_name): array {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return [];
  }

  foreach ($node->get($field_name)->referencedEntities() as $entity) {
    if ($entity instanceof MediaInterface) {
      $render = nomads_hero_ui_build_media_background_item($entity);
      if ($render !== []) {
        return $render;
      }
    }
  }

  return [];
}

/**
 * Builds a direct image render array for supported media background types.
 */
function nomads_hero_ui_build_media_background_item(MediaInterface $media): array {
  $image_item = nomads_hero_ui_get_media_image_item($media);
  if ($image_item === NULL || empty($image_item->entity)) {
    return [];
  }

  $file = $image_item->entity;
  $alt = trim((string) ($image_item->alt ?? ''));
  $width = isset($image_item->width) ? (int) $image_item->width : NULL;
  $height = isset($image_item->height) ? (int) $image_item->height : NULL;
  $uri = $file->getFileUri();

  $sources = [
    ['media' => '(min-width: 1600px)', 'style' => 'hero_xl'],
    ['media' => '(min-width: 1200px)', 'style' => 'hero_lg'],
    ['media' => '(min-width: 768px)', 'style' => 'hero_md'],
  ];

  $source_markup = [];
  foreach ($sources as $source) {
    $style = ImageStyle::load($source['style']);
    if (!$style instanceof ImageStyle) {
      continue;
    }

    $source_markup[] = '<source media="' . Html::escape($source['media']) . '" srcset="' . Html::escape($style->buildUrl($uri)) . '">';
  }

  $fallback_style = ImageStyle::load('hero_sm');
  $fallback_src = $fallback_style instanceof ImageStyle ? $fallback_style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri);

  $img_attributes = [
    'src="' . Html::escape($fallback_src) . '"',
    'alt="' . Html::escape($alt) . '"',
    'loading="eager"',
    'fetchpriority="high"',
    'decoding="async"',
    'draggable="false"',
  ];

  if ($width) {
    $img_attributes[] = 'width="' . $width . '"';
  }

  if ($height) {
    $img_attributes[] = 'height="' . $height . '"';
  }

  return [
    '#markup' => Markup::create(
      '<picture class="hero-ui__bg-image">'
      . implode('', $source_markup)
      . '<img ' . implode(' ', $img_attributes) . '>'
      . '</picture>'
    ),
  ];
}

/**
 * Returns the image field item from a media entity.
 */
function nomads_hero_ui_get_media_image_item(MediaInterface $media): ?\Drupal\image\Plugin\Field\FieldType\ImageItem {
  if ($media->hasField('field_stock_image') && !$media->get('field_stock_image')->isEmpty()) {
    return $media->get('field_stock_image')->first();
  }

  if ($media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
    return $media->get('field_media_image')->first();
  }

  return NULL;
}

/**
 * Returns a rendered field array from the node content build.
 */
function nomads_hero_ui_get_field_render(array $variables, string $field_name): array {
  $field = $variables['content'][$field_name] ?? [];
  return is_array($field) ? $field : [];
}

/**
 * Builds the anonymous auth panel for a gated hero node.
 */
function nomads_hero_ui_build_auth_panel(NodeInterface $node, string $form_type = 'login', ?array $active_form = NULL): array {
  return [
    '#type' => 'container',
    '#attached' => [
      'library' => ['core/drupal.ajax'],
    ],
    '#cache' => [
      'contexts' => ['user.roles:authenticated'],
    ],
    'form' => $active_form ?? nomads_hero_ui_build_auth_form($node, $form_type),
    'actions' => nomads_hero_ui_build_auth_switcher($node, $form_type),
  ];
}

/**
 * Builds the current auth form for the anonymous hero panel.
 */
function nomads_hero_ui_build_auth_form(NodeInterface $node, string $form_type): array {
  $destination = $node->toUrl()->toString();

  switch ($form_type) {
    case 'magic':
      return nomads_hero_ui_build_magic_link_form($node);

    case 'register':
      $form = \Drupal::service('entity.form_builder')->getForm(User::create(), 'register');
      break;

    case 'recover':
      $form = \Drupal::formBuilder()->getForm(UserPasswordForm::class);
      break;

    case 'login':
    default:
      $form = \Drupal::formBuilder()->getForm(UserLoginForm::class);
      break;
  }

  $form['destination'] = [
    '#type' => 'hidden',
    '#name' => 'destination',
    '#value' => $destination,
  ];
  $form['nomads_hero_ui_node_id'] = [
    '#type' => 'hidden',
    '#name' => 'nomads_hero_ui_node_id',
    '#value' => (int) $node->id(),
  ];
  $form['nomads_hero_ui_form_type'] = [
    '#type' => 'hidden',
    '#name' => 'nomads_hero_ui_form_type',
    '#value' => $form_type,
  ];

  return $form;
}

/**
 * Builds the AJAX form switcher links shown below the auth form.
 */
function nomads_hero_ui_build_auth_switcher(NodeInterface $node, string $form_type): array {
  $links = [];

  if ($form_type === 'login') {
    $links[] = nomads_hero_ui_build_auth_switch_link($node, 'magic', 'Send Magic Link');
    $links[] = nomads_hero_ui_build_auth_switch_link($node, 'register', 'Register');
  }
  else {
    $links[] = nomads_hero_ui_build_auth_switch_link($node, 'login', 'Back to Login');
  }

  return [
    '#type' => 'container',
    'items' => $links,
  ];
}

/**
 * Builds a single AJAX auth switch link.
 */
function nomads_hero_ui_build_auth_switch_link(NodeInterface $node, string $form_type, string $label): array {
  return [
    '#type' => 'link',
    '#title' => $label,
    '#url' => Url::fromRoute('nomads_hero_ui.auth_switch', [
      'node' => $node->id(),
      'form_type' => $form_type,
    ]),
    '#attributes' => [
      'class' => ['use-ajax', 'button', 'hero-ui__auth-switch-link'],
    ],
  ];
}

/**
 * Builds the Magic Link panel for the anonymous hero auth gate.
 */
function nomads_hero_ui_build_magic_link_form(NodeInterface $node): array {
  if (!\Drupal::moduleHandler()->moduleExists('magic_link')) {
    return [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['hero-ui__auth-unavailable'],
      ],
      'message' => [
        '#markup' => t('Magic link login is not available.'),
      ],
    ];
  }

  $request_url = Url::fromRoute('magic_link.request');
  $csrf_token = \Drupal::csrfToken()->get($request_url->getInternalPath());

  return [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['hero-ui__magic-link-form'],
    ],
    '#attached' => [
      'library' => ['core/drupal.htmx'],
    ],
    'content' => [
      '#theme' => 'nomads_hero_ui_magic_link_widget',
      '#csrf_token' => $csrf_token,
      '#request_url' => $request_url->toString(),
    ],
    'node_id' => [
      '#type' => 'hidden',
      '#name' => 'nomads_hero_ui_node_id',
      '#value' => (int) $node->id(),
    ],
    'form_type' => [
      '#type' => 'hidden',
      '#name' => 'nomads_hero_ui_form_type',
      '#value' => 'magic',
    ],
  ];
}

/**
 * Returns whether the hero node is gated by the login hero setting.
 */
function nomads_hero_ui_node_requires_login(NodeInterface $node): bool {
  if ($node->bundle() !== 'hero' || !$node->hasField('field_hero_settings') || $node->get('field_hero_settings')->isEmpty()) {
    return FALSE;
  }

  foreach ($node->get('field_hero_settings') as $item) {
    $value = mb_strtolower(trim((string) ($item->value ?? '')));
    if (in_array($value, ['login', 'login_portal'], TRUE)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Builds the replaceable hero content slot for body or auth content.
 */
function nomads_hero_ui_build_content_slot(NodeInterface $node, string $form_type = 'login', ?array $active_form = NULL): array {
  $content = nomads_hero_ui_node_requires_login($node) && !\Drupal::currentUser()->isAuthenticated()
    ? nomads_hero_ui_build_auth_panel($node, $form_type, $active_form)
    : nomads_hero_ui_build_body_content($node);

  return [
    '#type' => 'container',
    '#attributes' => [
      'id' => nomads_hero_ui_get_content_wrapper_id($node),
      'class' => ['hero-ui__body'],
    ],
    '#cache' => [
      'contexts' => ['user.roles:authenticated'],
    ],
    'content' => $content,
  ];
}

/**
 * Builds the hero body field in full-display context.
 */
function nomads_hero_ui_build_body_content(NodeInterface $node): array {
  $build = EntityViewDisplay::collectRenderDisplay($node, 'full')->build($node);
  $body = $build['body'] ?? [];

  return is_array($body) ? $body : [];
}

/**
 * Returns the DOM id used for the replaceable hero content wrapper.
 */
function nomads_hero_ui_get_content_wrapper_id(NodeInterface $node): string {
  return 'hero-ui-content-' . (int) $node->id();
}

/**
 * AJAX callback for login/register/recover forms inside the hero gate.
 */
function nomads_hero_ui_auth_form_ajax_submit(array &$form, FormStateInterface $form_state): array {
  $node = nomads_hero_ui_resolve_form_gate_node($form_state);
  if (!$node instanceof NodeInterface) {
    return $form;
  }

  $form_id = (string) ($form_state->getBuildInfo()['form_id'] ?? '');
  $form_type = (string) ($form_state->getValue('nomads_hero_ui_form_type') ?: nomads_hero_ui_get_form_type_from_form_id($form_id));

  if ($form_id === 'user_register_form' && !$form_state->getErrors()) {
    return nomads_hero_ui_build_content_slot($node);
  }

  return nomads_hero_ui_build_content_slot($node, $form_type, $form);
}

/**
 * Prevents Drupal AJAX auth submits from redirecting away from the hero page.
 */
function nomads_hero_ui_auth_form_disable_redirect(array &$form, FormStateInterface $form_state): void {
  $node = nomads_hero_ui_resolve_form_gate_node($form_state);
  $request = \Drupal::request();
  $is_ajax_request = $request->query->has(FormBuilderInterface::AJAX_FORM_REQUEST) || $request->isXmlHttpRequest();

  if ($is_ajax_request && $node instanceof NodeInterface && nomads_hero_ui_node_requires_login($node)) {
    $form_state->disableRedirect();
  }
}

/**
 * Sends successful gated auth submits back to the hero node.
 */
function nomads_hero_ui_auth_form_redirect_to_node(array &$form, FormStateInterface $form_state): void {
  $node = nomads_hero_ui_resolve_form_gate_node($form_state);
  if ($node instanceof NodeInterface && nomads_hero_ui_node_requires_login($node)) {
    $form_state->setRedirectUrl($node->toUrl());
  }
}

/**
 * Resolves the current gated hero node for an auth form interaction.
 */
function nomads_hero_ui_resolve_form_gate_node(FormStateInterface $form_state): ?NodeInterface {
  $node_id = (int) $form_state->getValue('nomads_hero_ui_node_id');
  if ($node_id > 0) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($node_id);
    return $node instanceof NodeInterface ? $node : NULL;
  }

  $route_node = \Drupal::routeMatch()->getParameter('node');
  return $route_node instanceof NodeInterface ? $route_node : NULL;
}

/**
 * Maps Drupal auth form IDs to the panel form types.
 */
function nomads_hero_ui_get_form_type_from_form_id(string $form_id): string {
  return match ($form_id) {
    'user_register_form' => 'register',
    'user_pass' => 'recover',
    default => 'login',
  };
}
