<?php

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\Entity\EntityViewDisplay;

/**
 * Ensure listing titles render via Manage Display components.
 */
function nomads_listing_update_11001(): string {
  $display_ids = [
    'node.listing.default',
    'node.listing.full',
    'node.details.default',
    'node.details.full',
  ];

  $module_handler = \Drupal::moduleHandler();
  $default_formatter = $module_handler->moduleExists('manage_display') ? 'title' : 'string';
  $updated = [];

  foreach ($display_ids as $display_id) {
    $display = EntityViewDisplay::load($display_id);
    if (!$display instanceof EntityViewDisplayInterface) {
      continue;
    }

    $component = $display->getComponent('title') ?? [];
    $component['region'] = 'content';
    $component['label'] = 'hidden';
    $component['weight'] = $component['weight'] ?? -49;
    $component['type'] = $component['type'] ?? $default_formatter;
    $component['settings'] = is_array($component['settings'] ?? NULL) ? $component['settings'] : [];
    $component['third_party_settings'] = is_array($component['third_party_settings'] ?? NULL) ? $component['third_party_settings'] : [];

    if ($component['type'] === 'title') {
      $component['settings'] += [
        'link_to_entity' => TRUE,
        'tag' => 'h1',
      ];
    }

    $display->setComponent('title', $component);

    $hidden = $display->get('hidden') ?? [];
    if (isset($hidden['title'])) {
      unset($hidden['title']);
      $display->set('hidden', $hidden);
    }

    $display->save();
    $updated[] = $display_id;
  }

  if (!$updated) {
    return 'No listing view displays were found for title rendering update.';
  }

  return 'Updated title display component in: ' . implode(', ', $updated) . '.';
}

