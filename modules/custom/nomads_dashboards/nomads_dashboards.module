<?php

declare(strict_types=1);

/**
 * @file
 * Theme hooks for Nomads Dashboards.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function nomads_dashboards_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.nomads_dashboards':
      $output = '';
      $output .= '<h2>' . t('Nomads Dashboards') . '</h2>';
      $output .= '<p>' . t('Nomads Dashboards provides virtual dashboard pages for users, team users, listings, and organizers. Dashboards are assembled from configurable tile titles, optional help content nodes, optional CTA links, and optional Views displays.') . '</p>';

      $output .= '<h3>' . t('Functionality') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Adds user dashboard pages at <code>/user/{user}/dashboard</code> and team dashboard pages at <code>/user/{user}/team-dashboard</code>.') . '</li>';
      $output .= '<li>' . t('Adds node dashboard pages at <code>/node/{node}/dashboard</code> for supported <code>listing</code> and <code>organizer</code> nodes.') . '</li>';
      $output .= '<li>' . t('Builds six tiles for each dashboard type: user, team, listing, and organizer.') . '</li>';
      $output .= '<li>' . t('Adds local task tabs on user and node pages and injects dashboard links into the account menu before logout.') . '</li>';
      $output .= '<li>' . t('Adds a <code>dashboard</code> class to dashboard HTML pages and attaches the <code>nomads_dashboards/dashboard</code> library.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Architecture') . '</h3>';
      $output .= '<p>' . t('Routes are handled by <code>NomadsDashboardsController</code>, which performs access checks and wraps tiles in the <code>nomads_dashboard_grid</code> theme hook. Tile arrays are produced by the <code>nomads_dashboards.builder</code> service. The builder reads <code>nomads_dashboards.settings</code>, loads configured help nodes, renders body summaries as processed text, extracts CTA links from dashboard CTA fields, and embeds configured Views displays. Twig templates render the dashboard grid and individual tiles.') . '</p>';

      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('Configure dashboards at <code>/admin/config/user-interface/dashboards</code>. For each of six tiles per dashboard type, site builders can set a title, select a help node, and select a View display. Stored configuration keys are <code>titles</code>, <code>help_nodes</code>, and <code>views</code> under <code>nomads_dashboards.settings</code>. Help node summaries are read from <code>field_body</code> or <code>body</code>; CTA links are read from <code>field_dashbaord_cta</code> or <code>field_dashboard_cta</code>.') . '</p>';

      $output .= '<h3>' . t('Access model') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('User dashboards are available to the same user or administrators.') . '</li>';
      $output .= '<li>' . t('Team dashboards are available only to the same logged-in user when that user has the <code>team</code> role.') . '</li>';
      $output .= '<li>' . t('Listing and organizer dashboards are available to the node owner, accounts with update access to the node, or administrators.') . '</li>';
      $output .= '<li>' . t('The settings form requires <code>administer site configuration</code>.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Stability concerns') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Dashboard structure is currently fixed to six tiles per dashboard type.') . '</li>';
      $output .= '<li>' . t('The builder expects specific help-node fields and includes a misspelled legacy field name, <code>field_dashbaord_cta</code>, for CTA compatibility.') . '</li>';
      $output .= '<li>' . t('Account menu links are built from an access-unchecked owner query for listing and organizer nodes, then linked to dashboard routes that perform their own access checks.') . '</li>';
      $output .= '<li>' . t('Tile cache metadata includes dashboard settings and configured help nodes, but embedded Views and user/node access contexts should be checked carefully when adding personalized tile content.') . '</li>';
      $output .= '<li>' . t('There is no automated test coverage for dashboard access, menu injection, settings persistence, cacheability, Views embedding, or tile rendering.') . '</li>';
      $output .= '</ul>';

      $output .= '<h3>' . t('Security concerns') . '</h3>';
      $output .= '<p>' . t('Dashboard routes are protected by explicit access checks, but embedded tile content can introduce its own access and cache requirements. Help node body summaries are rendered as processed text using the node field text format, so text format permissions and filters matter. CTA links are rendered from link field data, and Views displays are embedded by configured IDs. When adding new tile data sources, make sure entity access, view access, cache contexts, and cache tags are correct so one user cannot see another user’s dashboard content.') . '</p>';

      return $output;
  }

  return NULL;
}

/**
 * Implements hook_theme().
 */
function nomads_dashboards_theme(): array {
  return [
    'nomads_dashboard_grid' => [
      'variables' => [
        'dashboard_type' => NULL,
        'entity' => NULL,
        'tiles' => [],
        'attributes' => [],
      ],
    ],
    'nomads_dashboard_tile' => [
      'variables' => [
        'tile' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function nomads_dashboards_preprocess_html(array &$variables): void {
  if (!in_array(\Drupal::routeMatch()->getRouteName(), ['nomads_dashboards.user', 'nomads_dashboards.team', 'nomads_dashboards.node'], TRUE)) {
    return;
  }

  $variables['attributes']['class'][] = 'dashboard';
}

/**
 * Implements hook_preprocess_menu().
 */
function nomads_dashboards_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? NULL) !== 'account') {
    return;
  }

  $dashboard_items = nomads_dashboards_current_user_dashboard_menu_items();
  if ($dashboard_items === []) {
    return;
  }

  $items = $variables['items'] ?? [];
  $variables['items'] = nomads_dashboards_insert_menu_items_before_logout($items, $dashboard_items);

  $cacheability = (new CacheableMetadata())
    ->setCacheContexts(['user'])
    ->setCacheTags(nomads_dashboards_current_user_dashboard_menu_cache_tags());
  $cacheability->applyTo($variables);
}

/**
 * Builds dashboard menu items for the current user.
 *
 * @return array<string, array<string, mixed>>
 *   Menu items keyed by stable dashboard item IDs.
 */
function nomads_dashboards_current_user_dashboard_menu_items(): array {
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return [];
  }

  $uid = (int) $account->id();
  $cid = 'nomads_dashboards:current_user_menu_items:' . $uid;
  $cache = \Drupal::cache()->get($cid);
  if ($cache) {
    return $cache->data;
  }

  $items = nomads_dashboards_build_current_user_dashboard_menu_items();
  \Drupal::cache()->set($cid, $items, Cache::PERMANENT, nomads_dashboards_current_user_dashboard_menu_cache_tags($uid));

  return $items;
}

/**
 * Builds uncached dashboard menu items for the current user.
 *
 * @return array<string, array<string, mixed>>
 *   Menu items keyed by stable dashboard item IDs.
 */
function nomads_dashboards_build_current_user_dashboard_menu_items(): array {
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return [];
  }

  $items = [];

  $items['nomads_dashboards.user'] = [
    'title' => 'My Dashboard',
    'url' => Url::fromRoute('nomads_dashboards.user', ['user' => $account->id()]),
    'localized_options' => [],
    'attributes' => new Attribute([
      'class' => [
        'menu-item',
        'menu-item--nomads-dashboard',
        'menu-item--nomads-dashboard-user',
      ],
    ]),
    'below' => [],
    'is_expanded' => FALSE,
    'is_collapsed' => FALSE,
    'in_active_trail' => FALSE,
  ];

  if ($account->hasRole('team')) {
    $items['nomads_dashboards.team'] = [
      'title' => 'Team Dashboard',
      'url' => Url::fromRoute('nomads_dashboards.team', ['user' => $account->id()]),
      'localized_options' => [],
      'attributes' => new Attribute([
        'class' => [
          'menu-item',
          'menu-item--nomads-dashboard',
          'menu-item--nomads-dashboard-team',
        ],
      ]),
      'below' => [],
      'is_expanded' => FALSE,
      'is_collapsed' => FALSE,
      'in_active_trail' => FALSE,
    ];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', ['listing', 'organizer'], 'IN')
    ->condition('uid', $account->id())
    ->sort('type')
    ->sort('title')
    ->execute();

  if ($nids === []) {
    return $items;
  }

  $nodes = array_values($storage->loadMultiple($nids));
  $organizer_count = count(array_filter(
    $nodes,
    static fn ($node): bool => $node instanceof NodeInterface && $node->bundle() === 'organizer',
  ));
  $organizer_index = 0;

  foreach ($nodes as $node) {
    if (!$node instanceof NodeInterface) {
      continue;
    }

    $title = nomads_dashboards_node_dashboard_menu_title($node, $organizer_count, $organizer_index);
    $items['nomads_dashboards.' . $node->id()] = [
      'title' => $title,
      'url' => Url::fromRoute('nomads_dashboards.node', ['node' => $node->id()]),
      'localized_options' => [],
      'attributes' => new Attribute([
        'class' => [
          'menu-item',
          'menu-item--nomads-dashboard',
          'menu-item--nomads-dashboard-' . $node->bundle(),
        ],
      ]),
      'below' => [],
      'is_expanded' => FALSE,
      'is_collapsed' => FALSE,
      'in_active_trail' => FALSE,
    ];
  }

  return $items;
}

/**
 * Returns cache tags for current-user dashboard menu items.
 */
function nomads_dashboards_current_user_dashboard_menu_cache_tags(?int $uid = NULL): array {
  $uid ??= (int) \Drupal::currentUser()->id();

  return [
    'node_list:listing',
    'node_list:organizer',
    'user:' . $uid,
  ];
}

/**
 * Implements hook_entity_insert().
 */
function nomads_dashboards_entity_insert(EntityInterface $entity): void {
  nomads_dashboards_invalidate_owned_dashboard_menu_cache($entity);
}

/**
 * Implements hook_entity_update().
 */
function nomads_dashboards_entity_update(EntityInterface $entity): void {
  nomads_dashboards_invalidate_owned_dashboard_menu_cache($entity);
}

/**
 * Implements hook_entity_delete().
 */
function nomads_dashboards_entity_delete(EntityInterface $entity): void {
  nomads_dashboards_invalidate_owned_dashboard_menu_cache($entity);
}

/**
 * Invalidates cached dashboard account menu items for relevant owned nodes.
 */
function nomads_dashboards_invalidate_owned_dashboard_menu_cache(EntityInterface $entity): void {
  if (
    !$entity instanceof NodeInterface ||
    !in_array($entity->bundle(), ['listing', 'organizer'], TRUE)
  ) {
    return;
  }

  $owner_id = (int) $entity->getOwnerId();
  if ($owner_id <= 0) {
    return;
  }

  Cache::invalidateTags(nomads_dashboards_current_user_dashboard_menu_cache_tags($owner_id));
}

/**
 * Inserts dashboard menu items before the logout link when present.
 *
 * @param array<string, array<string, mixed>> $items
 *   Existing menu items.
 * @param array<string, array<string, mixed>> $dashboard_items
 *   Dashboard menu items.
 *
 * @return array<string, array<string, mixed>>
 *   Menu items with dashboard links placed above logout.
 */
function nomads_dashboards_insert_menu_items_before_logout(array $items, array $dashboard_items): array {
  $result = [];
  $inserted = FALSE;

  foreach ($items as $key => $item) {
    if (!$inserted && nomads_dashboards_menu_item_is_logout($item)) {
      foreach ($dashboard_items as $dashboard_key => $dashboard_item) {
        $result[$dashboard_key] = $dashboard_item;
      }
      $inserted = TRUE;
    }

    $result[$key] = $item;
  }

  if (!$inserted) {
    foreach ($dashboard_items as $dashboard_key => $dashboard_item) {
      $result[$dashboard_key] = $dashboard_item;
    }
  }

  return $result;
}

/**
 * Determines whether a menu item points to the user logout route.
 */
function nomads_dashboards_menu_item_is_logout(array $item): bool {
  $url = $item['url'] ?? NULL;
  return $url instanceof Url && $url->isRouted() && $url->getRouteName() === 'user.logout';
}

/**
 * Builds the account menu label for a node dashboard link.
 */
function nomads_dashboards_node_dashboard_menu_title(NodeInterface $node, int $organizer_count, int &$organizer_index): string {
  if ($node->bundle() === 'organizer') {
    if ($organizer_count <= 1) {
      return 'Organizer Dashboard';
    }

    ++$organizer_index;
    return 'Organizer ' . $organizer_index . ' Dashboard';
  }

  return nomads_dashboards_truncate_menu_title($node->label()) . ' Dashboard';
}

/**
 * Truncates node titles for account menu dashboard links.
 */
function nomads_dashboards_truncate_menu_title(string $title): string {
  $title = trim($title);
  if (mb_strlen($title) <= 16) {
    return $title;
  }

  return rtrim(mb_substr($title, 0, 12)) . '...';
}
