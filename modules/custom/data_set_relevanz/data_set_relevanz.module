<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function data_set_relevanz_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (!data_set_relevanz_is_details_node_form($form_state, $form_id)) {
    return;
  }

  data_set_relevanz_mark_relevanceslider_targets($form);
  $form['#attached']['library'][] = 'data_set_relevanz/relevanceslider';
}

/**
 * Checks if the form is for creating or editing the details content type.
 */
function data_set_relevanz_is_details_node_form(FormStateInterface $form_state, string $form_id): bool {
  if ($form_id !== 'node_details_form') {
    return FALSE;
  }

  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return FALSE;
  }

  $entity = $form_object->getEntity();
  if (!$entity || !method_exists($entity, 'bundle')) {
    return FALSE;
  }

  return $entity->bundle() === 'details';
}

/**
 * Adds data markers to relevanceslider targets for the JS behavior.
 */
function data_set_relevanz_mark_relevanceslider_targets(array &$element): void {
  if (isset($element['#attributes']['class']) && is_array($element['#attributes']['class'])) {
    if (in_array('relevanceslider-hidden', $element['#attributes']['class'], TRUE)) {
      $element['#attributes']['data-relevanceslider-target'] = '1';
    }
  }

  if (isset($element['#wrapper_attributes']['class']) && is_array($element['#wrapper_attributes']['class'])) {
    if (in_array('relevanceslider-hidden', $element['#wrapper_attributes']['class'], TRUE)) {
      $element['#wrapper_attributes']['data-relevanceslider-target'] = '1';
    }
  }

  foreach ($element as $key => &$child) {
    if (!is_string($key) || $key[0] === '#') {
      continue;
    }
    if (is_array($child)) {
      data_set_relevanz_mark_relevanceslider_targets($child);
    }
  }
}
