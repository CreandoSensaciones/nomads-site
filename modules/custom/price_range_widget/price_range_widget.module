<?php

/**
 * @file
 * Price range widget tweaks for listings.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;

/**
 * Implements hook_form_alter().
 */
function price_range_widget_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (!price_range_widget_has_price_range($form)) {
    return;
  }

  $form['#attached']['library'][] = 'price_range_widget/price_range_widget';
}

/**
 * Checks if the form contains the min/max price fields.
 */
function price_range_widget_has_price_range(array $form): bool {
  if (isset($form['field_min_price']) || isset($form['field_max_price'])) {
    return TRUE;
  }

  $has_min = isset($form['field_min_price']['widget'][0])
    || isset($form['field_min_price'][0])
    || isset($form['field_min_price']['0']);
  $has_max = isset($form['field_max_price']['widget'][0])
    || isset($form['field_max_price'][0])
    || isset($form['field_max_price']['0']);

  if ($has_min && $has_max) {
    return TRUE;
  }

  $found = [
    'min' => FALSE,
    'max' => FALSE,
  ];
  price_range_widget_find_price_fields($form, $found);

  return $found['min'] && $found['max'];
}

/**
 * Recursively scans for price range fields.
 */
function price_range_widget_find_price_fields(array $element, array &$found): void {
  if (!empty($found['min']) && !empty($found['max'])) {
    return;
  }

  if (isset($element['#field_name']) && is_string($element['#field_name'])) {
    if ($element['#field_name'] === 'field_min_price') {
      $found['min'] = TRUE;
    }
    if ($element['#field_name'] === 'field_max_price') {
      $found['max'] = TRUE;
    }
  }

  foreach (Element::children($element) as $child_key) {
    if (!isset($element[$child_key]) || !is_array($element[$child_key])) {
      continue;
    }
    price_range_widget_find_price_fields($element[$child_key], $found);
  }
}
