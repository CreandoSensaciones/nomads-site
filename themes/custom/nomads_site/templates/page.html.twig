{#
/**
 * @file
 * Default theme implementation for a page.
 */
#}
<div class="layout-page">
  {% if page.top_nav %}
    <nav class="region region-top-nav" role="navigation">
      {{ page.top_nav }}
    </nav>
  {% endif %}

  {% if page.header %}
    <header class="region region-header" role="banner">
      {{ page.header }}
    </header>
  {% endif %}

  {% if page.title %}
    <div class="region region-title">
      {{ page.title }}
    </div>
  {% endif %}

  <main class="region region-content" role="main">
    {{ page.content }}
  </main>

  {% if page.content_bottom %}
    <section class="region region-content-bottom">
      {{ page.content_bottom }}
    </section>
  {% endif %}

  {% if page.footer %}
    <footer class="region region-footer" role="contentinfo">
      {{ page.footer }}
    </footer>
  {% endif %}
</div>
