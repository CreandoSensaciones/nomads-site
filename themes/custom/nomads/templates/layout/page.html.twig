{% set current_path = nomads_current_path|default('') %}
{% set front_active = current_path == '/front' %}
{% set list_active = current_path == '/list' or current_path starts with '/list/' %}
{% set map_active = current_path == '/map' or current_path starts with '/map/' %}
{% set cal_active = current_path == '/cal' or current_path starts with '/cal/' %}
{% set domain_prefix = nomads_domain_prefix|default('coliving') %}
{% set navbar_logo = '/' ~ directory ~ '/assets/navbar/logo-' ~ domain_prefix ~ '.svg' %}

<div class="mobile-announcement-overlay">
  <div class="mobile-announcement-overlay__inner">
    <img src="{{ navbar_logo }}" alt="Logo" class="mobile-announcement-overlay__logo">
    <div class="mobile-announcement-overlay__text">
      <p>Nomads.site is currently under construction.</p>
      <p>Launching at Bansko Nomad Fest in June</p>
      <p>early access is offered only on desktop devices<br>with a screen width above 1200px.</p>
    </div>
  </div>
</div>
<header class="nomads-navbar nomads-breakout" role="banner">
  <div class="nomads-navbar__inner nomads-inner nomads-inner--constrained">
    <div class="nomads-navbar__brand-wrap nomads-navbar__dropdownwrap nomads-navbar__dropdownwrap--domains">
      <a class="nomads-navbar__brand nomads-navbar__domains" href="http://nomads.site:8080" aria-label="Domains" aria-expanded="false" aria-controls="nomads-domainsmenu" data-once="nomads-navbar-domains">
        <img class="nomads-navbar__brand-logo" src="{{ navbar_logo }}" alt="nomads.site" />
      </a>
      <div id="nomads-domainsmenu" class="nomads-navbar__dropdown nomads-navbar__dropdown--domains" hidden>
        <ul class="nomads-navbar__dropdown-list">
          {% for item in nomads_domainsmenu_items %}
            {% set _domain_words = item.title|split(' ') %}
            {% set _domain_first = _domain_words|first %}
            {% set _domain_rest = _domain_words|slice(1)|join(' ') %}
            <li>
              <a href="{{ item.url }}">
                <span class="domain-first">{{ _domain_first }}</span>
                {% if _domain_rest %}
                  <span class="domain-rest">{{ _domain_rest }}</span>
                {% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <form class="nomads-navbar__search" action="/search" method="get" role="search">
      <input class="nomads-navbar__search-input" type="search" name="q" placeholder="Where do I go? - No function still" aria-label="Where do I go? - No function still" />
    </form>

    <nav class="nomads-navbar__actions" aria-label="Primary actions">
      <div class="nomads-navbar__group nomads-navbar__group--views">
        <a class="nomads-navbar__icon search-icon{{ front_active ? ' active' : '' }}" href="/" aria-label="Front">
          <img src="{{ '/' ~ directory ~ '/assets/navbar/icon-front.svg' }}" alt="" />
        </a>
        <a class="nomads-navbar__icon search-icon{{ list_active ? ' active' : '' }}" href="/list" aria-label="List">
          <img src="{{ '/' ~ directory ~ '/assets/navbar/icon-list.svg' }}" alt="" />
        </a>
        <a class="nomads-navbar__icon search-icon{{ map_active ? ' active' : '' }}" href="/map" aria-label="Map">
          <img src="{{ '/' ~ directory ~ '/assets/navbar/icon-map.svg' }}" alt="" />
        </a>
        <a class="nomads-navbar__icon search-icon{{ cal_active ? ' active' : '' }}" href="/cal" aria-label="Calendar">
          <img src="{{ '/' ~ directory ~ '/assets/navbar/icon-cal.svg' }}" alt="" />
        </a>
      </div>

      <div class="nomads-navbar__group nomads-navbar__group--user">
        <div class="nomads-navbar__dropdownwrap nomads-navbar__dropdownwrap--account">
          <button class="nomads-navbar__icon nomads-navbar__account" type="button" aria-label="Account" aria-expanded="false" aria-controls="nomads-accountmenu" data-once="nomads-navbar-account">
            <img src="{{ '/' ~ directory ~ '/assets/navbar/icon-user.svg' }}" alt="" />
          </button>
          <div id="nomads-accountmenu" class="nomads-navbar__dropdown nomads-navbar__dropdown--account" hidden>{{ nomads_accountmenu }}</div>
        </div>

        <div class="nomads-navbar__dropdownwrap nomads-navbar__dropdownwrap--main">
          <button class="nomads-navbar__icon nomads-navbar__menu" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nomads-mainmenu">
            <img src="{{ '/' ~ directory ~ '/assets/navbar/icon-menu.svg' }}" alt="" />
          </button>
          <div id="nomads-mainmenu" class="nomads-navbar__dropdown" hidden>{{ nomads_mainmenu }}</div>
        </div>
      </div>
    </nav>
  </div>
</header>

{% if page.hero %}
  <section class="region-hero">
    {{ page.hero }}
  </section>
{% endif %}

{% if page.title %}
  <section class="region-title">
    <div class="nomads-inner nomads-inner--constrained">
      {{ page.title }}
    </div>
  </section>
{% endif %}

{% if page.content %}
  <section class="region-content">
    <div class="nomads-inner nomads-inner--constrained">
      <div class="nomads-content">
        {# Anything inside page.content can use .nomads-breakout to go full width #}
        <div class="nomads-breakout-scope">
          {{ page.content }}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% if page.bottom %}
  <section class="region-bottom">
    <div class="nomads-inner nomads-inner--constrained">
      {{ page.bottom }}
    </div>
  </section>
{% endif %}

{% if page.footer %}
  <section class="region-footer">
    <div class="nomads-inner nomads-inner--constrained">
      {{ page.footer }}
    </div>
  </section>
{% endif %}
