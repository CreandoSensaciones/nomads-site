<?php

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_image_widget().
 */
function nomads_preprocess_image_widget(array &$variables): void {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

/**
 * Implements hook_preprocess_page().
 */
function nomads_preprocess_page(array &$variables): void {
  $menu_tree = \Drupal::menuTree();
  $request = \Drupal::request();
  $current_path = $request->getPathInfo();

  // Normalize trailing slash (except root) so Twig checks are predictable.
  if ($current_path !== '/' && substr($current_path, -1) === '/') {
    $current_path = rtrim($current_path, '/');
  }

  $parameters = (new \Drupal\Core\Menu\MenuTreeParameters())
    ->setMaxDepth(1);
  $allowed_query_keys = ['q', 'view', 'tags', 'from', 'to'];
  $current_query = \Drupal::request()->query->all();
  $whitelisted_query = array_intersect_key($current_query, array_flip($allowed_query_keys));

  $main_tree = $menu_tree->load('main', $parameters);
  $main_tree = $menu_tree->transform(
    $main_tree,
    [
      ['callable' => 'menu.default_tree_manipulators:checkAccess'],
      ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
    ]
  );

  $account_tree = $menu_tree->load('account', $parameters);
  $account_tree = $menu_tree->transform(
    $account_tree,
    [
      ['callable' => 'menu.default_tree_manipulators:checkAccess'],
      ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
    ]
  );

  $domains_tree = $menu_tree->load('domains', $parameters);
  $domains_tree = $menu_tree->transform(
    $domains_tree,
    [
      ['callable' => 'menu.default_tree_manipulators:checkAccess'],
      ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
    ]
  );

  $domains = [];
  foreach ($domains_tree as $element) {
    $link = $element->link;
    $url = $link->getUrlObject();
    $url->setOption('query', $whitelisted_query);
    $domains[] = [
      'title' => $link->getTitle(),
      'url' => $url,
    ];
  }

  $variables['nomads_mainmenu'] = $menu_tree->build($main_tree);
  $variables['nomads_accountmenu'] = $menu_tree->build($account_tree);
  $variables['nomads_domainsmenu_items'] = $domains;
  $variables['nomads_current_path'] = $current_path;
}

/**
 * Determines whether the current field group is listing/full group_title.
 */
function _nomads_is_listing_full_group_title(array $variables): bool {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'entity.node.canonical') {
    return FALSE;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof \Drupal\node\NodeInterface || $node->bundle() !== 'listing') {
    return FALSE;
  }

  $group_name = $variables['group_name'] ?? ($variables['element']['#group_name'] ?? '');
  if ($group_name === 'group_title') {
    return TRUE;
  }

  if (!empty($variables['attributes']) && $variables['attributes'] instanceof \Drupal\Core\Template\Attribute) {
    $classes = $variables['attributes']->offsetGet('class');
    if (is_iterable($classes)) {
      foreach ($classes as $class) {
        if ($class === 'group-title' || $class === 'group_title') {
          return TRUE;
        }
      }
    }
  }

  return FALSE;
}

/**
 * Implements hook_theme_suggestions_field_group_html_element_alter().
 */
function nomads_theme_suggestions_field_group_html_element_alter(array &$suggestions, array $variables): void {
  if (_nomads_is_listing_full_group_title($variables)) {
    $suggestions[] = 'field_group_html_element__listing_full_group_title';
  }
}

/**
 * Implements hook_preprocess_field_group_html_element().
 */
function nomads_preprocess_field_group_html_element(array &$variables): void {
  if (!_nomads_is_listing_full_group_title($variables)) {
    return;
  }

  $variables['nomads_group_title_local_tasks'] = [];

  $block_manager = \Drupal::service('plugin.manager.block');
  /** @var \Drupal\Core\Block\BlockPluginInterface $local_tasks */
  $local_tasks = $block_manager->createInstance('local_tasks_block', []);
  $access = $local_tasks->access(\Drupal::currentUser(), TRUE);
  if (!$access->isAllowed()) {
    return;
  }

  $build = $local_tasks->build();
  if (is_array($build) && !empty($build)) {
    $variables['nomads_group_title_local_tasks'] = $build;
  }
}

/**
 * Implements hook_preprocess_paragraph().
 */
function nomads_preprocess_paragraph(array &$variables): void {
  $view_mode = $variables['view_mode'] ?? NULL;
  if ($view_mode !== '2' && $view_mode !== '3') {
    return;
  }

  $variables['nomads_paragraph_type_label'] = '';
  $variables['nomads_paragraph_type_icon_markup'] = '';

  if (empty($variables['paragraph'])) {
    return;
  }

  $paragraph = $variables['paragraph'];
  $bundle = $paragraph->bundle();
  /** @var \Drupal\paragraphs\ParagraphsTypeInterface|null $paragraph_type */
  $paragraph_type = \Drupal::entityTypeManager()
    ->getStorage('paragraphs_type')
    ->load($bundle);

  if (!$paragraph_type) {
    return;
  }

  $label = $paragraph_type->label();
  if (is_string($label) && $label !== '') {
    $variables['nomads_paragraph_type_label'] = $label;
  }

  $icon_value = '';
  if (method_exists($paragraph_type, 'getIconUrl')) {
    $icon_value = (string) $paragraph_type->getIconUrl();
  }

  $icon_value = trim($icon_value);
  if ($icon_value === '') {
    return;
  }

  $has_slash = strpos($icon_value, '/') !== FALSE;
  $has_ext = (bool) preg_match('/\.(svg|png|jpe?g)(\?.*)?$/i', $icon_value);
  $is_class = !$has_slash && !$has_ext;

  if ($is_class) {
    $class_tokens = preg_split('/\s+/', $icon_value, -1, PREG_SPLIT_NO_EMPTY);
    $class_tokens = array_map('\Drupal\Component\Utility\Html::cleanCssIdentifier', $class_tokens);
    $class_attr = trim(implode(' ', $class_tokens));
    if ($class_attr !== '') {
      $variables['nomads_paragraph_type_icon_markup'] = \Drupal\Core\Render\Markup::create(
        '<span class="nomads-paragraph-type-icon ' . $class_attr . '"></span>'
      );
    }
    return;
  }

  $safe_icon_url = \Drupal\Component\Utility\UrlHelper::stripDangerousProtocols($icon_value);
  if ($safe_icon_url === '') {
    return;
  }

  $alt = '';
  if (is_string($label) && $label !== '') {
    $alt = $label;
  }
  $variables['nomads_paragraph_type_icon_markup'] = \Drupal\Core\Render\Markup::create(
    '<img class="nomads-paragraph-type-icon" src="' . \Drupal\Component\Utility\Html::escape($safe_icon_url) . '" alt="' . \Drupal\Component\Utility\Html::escape($alt) . '">'
  );
}

/**
 * Implements hook_preprocess_field().
 */
function nomads_preprocess_field(array &$variables): void {
  if (($variables['entity_type'] ?? '') === 'node' && ($variables['field_name'] ?? '') === 'field_links') {
    if (($variables['attributes'] ?? NULL) instanceof \Drupal\Core\Template\Attribute) {
      $variables['attributes']->setAttribute('id', 'links');
    }
    elseif (is_array($variables['attributes'] ?? NULL)) {
      $variables['attributes']['id'] = 'links';
    }
  }

  $count = 0;

  // Prefer the original field item list so custom formatters that collapse
  // output into one rendered item still get the correct count.
  if (isset($variables['element']['#items']) && is_countable($variables['element']['#items'])) {
    $count = count($variables['element']['#items']);
  }
  elseif (isset($variables['items']) && is_countable($variables['items'])) {
    $count = count($variables['items']);
  }

  if ($count >= 2) {
    $classes = ['items-count-' . $count];

    $thresholds = [];
    foreach ([3, 4] as $step) {
      for ($n = $step; $n <= $count; $n += $step) {
        $thresholds[$n] = TRUE;
      }
    }

    ksort($thresholds);
    foreach (array_keys($thresholds) as $n) {
      $classes[] = 'items-' . $n;
    }

    if (($variables['attributes'] ?? NULL) instanceof \Drupal\Core\Template\Attribute) {
      $variables['attributes']->addClass(...$classes);
    }
    elseif (is_array($variables['attributes'] ?? NULL)) {
      $variables['attributes']['class'] = array_values(array_unique(array_merge(
        $variables['attributes']['class'] ?? [],
        $classes
      )));
    }
  }

  if (($variables['entity_type'] ?? '') === 'node' && ($variables['field_name'] ?? '') === 'field_subtitle') {
    $variables['host_entity'] = $variables['element']['#object'] ?? NULL;
    $variables['host_view_mode'] = $variables['element']['#view_mode'] ?? '';
  }
}
